  <data key="d3">The designation of Taylor Ellis as the beneficiary clarifies who qualifies under the broader legal definition of a beneficiary—the person(s) legally entitled to receive the death benefit when the insured passes away.</data>
  <data key="d4">defined by</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
