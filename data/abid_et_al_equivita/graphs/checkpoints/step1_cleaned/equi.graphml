  <data key="d2">fact_entity</data>
  <data key="d4">provision</data>
</edge>
<edge source="b6c70d4a-bb66-4ce6-8a7e-fcce14499c75" target="b28fb0ae-4457-4be7-94d7-cbce35c84dc7">
  <data key="d2">fact_entity</data>
  <data key="d4">role</data>
</edge>
