<edge source="ce0fb1c9-347b-430e-a607-ea32da5c639f" target="c39b37f1-33a3-4fd2-bedc-c257cc617eba">
  <data key="d3">Statutory or regulatory requirements may supersede the need for written approval from an executive officer, ensuring compliance even if standard amendment protocols aren't followed.</data>
  <data key="d4">overrules</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.92</data>
</edge>
<edge source="ce0fb1c9-347b-430e-a607-ea32da5c639f" target="34477494-c07a-4a94-8d5d-9ab2d18efa69">
  <data key="d3">Fact_sentence_2 notes that statutory changes are applied automatically without notice. This builds on fact_sentence_1’s assertion of mandatory incorporation, adding procedural detail about lack of communication.</data>
  <data key="d4">implied by</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
