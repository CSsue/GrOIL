  <data key="d2">fact_entity</data>
  <data key="d4">date</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="c8476fa1-a851-413f-b031-ca2032d9f6df">
  <data key="d2">fact_entity</data>
  <data key="d4">policy</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="23e6d16e-8c0c-4773-8a91-b2d5d4f69e92">
  <data key="d2">fact_entity</data>
  <data key="d4">organization</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="3ad6498a-6109-4c71-9a4b-a8ba7871c2ca">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="d59ba12a-0231-4a4c-aef3-19ccae4f2f21">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="1234a587-62ac-4856-ba95-aa77322034dc">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="6c40d24b-d6c2-4d9b-a546-adfea326c84f">
  <data key="d2">fact_entity</data>
  <data key="d4">date</data>
</edge>
<edge source="a02029bc-d32a-41e0-a806-f525ebfc428c" target="e3dfcb0e-004a-448a-b899-512986739b5b">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
