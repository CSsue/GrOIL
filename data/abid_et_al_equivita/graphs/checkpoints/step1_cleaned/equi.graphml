  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="a20ed2b4-2a6b-44d6-aa80-4f3de6e88160" target="93b1dc7c-9861-4584-ba6e-9172baf547f5">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
