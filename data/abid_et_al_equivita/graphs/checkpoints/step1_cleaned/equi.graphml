  <data key="d3">Fact_sentence_1 exemplifies the general principle stated in fact_sentence_2 by identifying a named beneficiary (Taylor Ellis) under a real policy, illustrating how the designation works in practice.</data>
  <data key="d4">corroborates</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
