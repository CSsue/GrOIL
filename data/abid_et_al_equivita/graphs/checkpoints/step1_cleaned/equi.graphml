  <data key="d3">The stated coverage period in fact_sentence_1 sets the time frame during which the conversion right described in fact_sentence_2 can be exercised, establishing when the option remains active.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
