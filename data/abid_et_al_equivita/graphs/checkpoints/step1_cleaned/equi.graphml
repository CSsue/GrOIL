  <data key="d5">0.85</data>
</edge>
<edge source="49ede6cd-0ba5-4ff3-af79-5ed128947216" target="abcb40ee-de9a-4039-a28a-20a1a7730e94">
  <data key="d3">Fact sentence 2 identifies the recipient of the death benefit, whose eligibility depends on first establishing who the insured is, as defined in fact sentence 1. Without knowing the insured, the designation of the beneficiary lacks contextual grounding.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
