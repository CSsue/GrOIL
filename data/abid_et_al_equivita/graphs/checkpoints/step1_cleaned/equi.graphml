er of conversion option","relational_anchors":["last known address"]},{"name":"Insured","type":"PERSON","role":"eligible candidate for conversion","relational_anchors":["maximum conversion age"]},{"name":"conversion period specified in the Policy Specifications","type":"CONDITION","role":"timing constraint for conversion request","relational_anchors":[]},{"name":"maximum conversion age","type":"AGE","role":"upper limit for Insured's eligibility","relational_anchors":[]},{"name":"State of New York","type":"LOCATION","role":"governing jurisdiction","relational_anchors":[]},{"name":"court of competent jurisdiction","type":"LEGAL_ENTITY","role":"venue for resolving disputes","relational_anchors":["State of New York"]},{"name":"last known address of the Policy Owner","type":"ADDRESS","role":"notification destination","relational_anchors":[]},{"name":"Policy Specifications","type":"DOCUMENT","role":"reference guide for conversion criteria","relational_anchors":[]},{"name":"periodic statements or confirmations","type":"STATEMENT","role":"informational updates issued by insurer","relational_anchors":[]},{"name":"properly authorized amendment or rider","type":"AMENDMENT","role":"formal modification mechanism","relational_anchors":[]},{"name":"personal information","type":"DATA","role":"confidential data collected by company","relational_anchors":[]},{"name":"applicable privacy laws and regulations","type":"LAW","role":"legal framework for data handling","relational_anchors":[]},{"name":"severability","type":"PROVISION","role":"clause preserving validity of rest","relational_anchors":[]}]},{"name":"No Automatic Renewal","sentence":"This Policy does not provide automatic renewal beyond the term period.","macro_topics":[],"chunk_topics":["automatic renewal","policy expiration","conversion option"],"entities":[{"name":"date of reinstatement","type":"DATE","role":"trigger point for new exclusions","relational_anchors":[]},{"name":"two-year contestability period","type":"CONCEPT",