  <data key="d2">fact_entity</data>
  <data key="d4">role</data>
</edge>
<edge source="ae130c33-876d-4d39-9ee6-6b6250047099" target="ec3803a2-2567-4d0b-87cc-a582515f0794">
  <data key="d2">fact_entity</data>
  <data key="d4">role</data>
</edge>
<edge source="ae130c33-876d-4d39-9ee6-6b6250047099" target="e0d9398a-6d5b-45d5-887d-44e98b1e073b">
