  <data key="d2">fact_entity</data>
  <data key="d4">amendment</data>
</edge>
<edge source="da6699b0-8745-467d-acc5-a910c61481be" target="c5df6ce0-3fdb-48b5-b036-012c302f98fb">
  <data key="d2">fact_entity</data>
  <data key="d4">data</data>
</edge>
