<edge source="e7c4ba5d-2f8a-4bd9-8e77-4018f8285f7a" target="0dd1735c-ba92-4588-9e4a-6408b636a844">
  <data key="d3">The need to provide evidence of insurability ensures that only eligible individuals can have their policies restored to active status, reinforcing the reinstatement procedure detailed in the initial fact.</data>
  <data key="d4">required for</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
