</edge>
<edge source="4c33d125-939d-4a32-9967-049926703be9" target="9aff7508-84dd-468d-83c6-658c086cf16c">
  <data key="d3">A Policy Anniversary marks the annual milestone from the policy’s start date, which may coincide with premium due dates; failure to pay by the deadline after the grace period results in lapse.</data>
  <data key="d4">precedes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="4c33d125-939d-4a32-9967-049926703be9" target="6b3e96fb-fdf8-41b4-8cb5-c43de3bff2e7">
  <data key="d3">The Policy Anniversary marks annual milestones from the policy’s start date, providing a reference point for timing events. This timeline aligns with the onset of the Incontestability Period, which begins on the same issue date and lasts for two years, limiting the company’s right to dispute coverage.</data>
  <data key="d4">temporal context</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="0fd71a13-da81-4fee-8109-6eff9a9bf473" target="4c33d125-939d-4a32-9967-049926703be9">
  <data key="d2">entity_fact</data>
  <data key="d4">defined by anniversary of issue date</data>
</edge>
