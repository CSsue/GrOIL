  <data key="d5">0.75</data>
</edge>
<edge source="81fd1296-c3bf-4581-b20f-126e5d595425" target="2a08c0b6-2e7e-4895-939b-cc9797b12f18">
  <data key="d3">The insurer commits to paying the death benefit quickly when the insured passes away while the policy remains active. This commitment depends on the deceased being covered at time of death and meeting policy terms.</data>
  <data key="d4">enables payment</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
