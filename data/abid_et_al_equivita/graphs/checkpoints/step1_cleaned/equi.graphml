  <data key="d3">Defining the insured as the person specified in the Policy Specifications establishes the referent for all personal details—including risk class—which applies only if consistent with the named individual.</data>
  <data key="d4">applies to</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
