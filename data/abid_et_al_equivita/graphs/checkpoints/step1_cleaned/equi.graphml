<edge source="7f26a565-4af4-450c-9a70-1dd435ed96e5" target="6c933248-145a-4629-9244-b471149ae619">
  <data key="d3">A written request for reinstatement is required when a policy has lapsed due to failure to pay a premium before the grace period ends, serving as the initial action needed to restore coverage.</data>
  <data key="d4">required after lapse</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="7f26a565-4af4-450c-9a70-1dd435ed96e5" target="dc295506-9994-4bc6-8410-24347075b1d6">
  <data key="d3">A written request for reinstatement is necessary only after the policy has already lapsed due to failure to pay premiums within the grace period.</data>
  <data key="d4">preceded by</data>
