  <data key="d2">entity_fact</data>
  <data key="d4">triggers payout rule</data>
</edge>
<edge source="68db5cd7-add2-4e12-9d7d-b12904ab5cf9" target="1fa01fa6-dfb3-4343-85a2-88951da5f49b">
  <data key="d2">entity_fact</data>
  <data key="d4">executes payout based on rule</data>
</edge>
<edge source="2bc78609-3070-4a86-b61d-5382aafc00bc" target="1fa01fa6-dfb3-4343-85a2-88951da5f49b">
  <data key="d2">entity_fact</data>
  <data key="d4">may not survive insured</data>
</edge>
<edge source="46a25042-d93b-44dd-a2ec-a3e7a34dcab2" target="1fa01fa6-dfb3-4343-85a2-88951da5f49b">
  <data key="d2">entity_fact</data>
  <data key="d4">receives proceeds if beneficiary does not survive</data>
</edge>
