  <data key="d3">Taylor Ellis, as the named beneficiary, will receive the death benefit after deductions for any outstanding indebtedness under the policy.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
