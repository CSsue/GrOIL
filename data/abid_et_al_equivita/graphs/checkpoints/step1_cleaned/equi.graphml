  <data key="d3">The two-year contestability period specified in fact_sentence_1 leads directly to the legal protection against policy invalidation outlined in fact_sentence_2.</data>
  <data key="d4">precedes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
