  <data key="d4">concept</data>
</edge>
<edge source="68b1219a-81cc-436d-b9fa-18329365fedb" target="95ca9b7d-5c30-405f-9a1d-941ab91793ce">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
