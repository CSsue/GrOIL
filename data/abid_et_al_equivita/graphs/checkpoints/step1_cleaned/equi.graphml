</edge>
<edge source="38974002-cdef-417b-abe4-05fe910d1ed4" target="92a0c3fd-b6dc-4a3b-852d-2dde74d5850f">
  <data key="d3">Fact_sentence_1 specifies estate payout conditions upon beneficiary absence, while fact_sentence_2 ensures such provisions remain enforceable even if parts of the policy are challenged, supporting the legal foundation for the described outcome.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
