  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="890edb7e-d6f7-49a2-af24-7d3844f90821" target="358228c7-a09c-4b36-a508-201289905164">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="890edb7e-d6f7-49a2-af24-7d3844f90821" target="f8407889-1bbb-4be1-b20d-237ddc3bd581">
  <data key="d2">fact_entity</data>
