  <data key="d4">policy</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="cca069c4-dcfd-4150-8ae2-cf70a0f1c43b">
  <data key="d2">fact_entity</data>
  <data key="d4">organization</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="88084b01-cf85-4a95-93da-d613760e2690">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="cf844468-46f5-4c5b-a372-636028b00fe2">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="4928e190-5a72-495e-bb8f-0805f42a90d9">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="628d7e42-7741-478d-ab76-11ba0a2d2e24">
  <data key="d2">fact_entity</data>
  <data key="d4">date</data>
</edge>
<edge source="c8a217fc-b379-48eb-80d2-edc84b27f3c5" target="0955c93c-1d54-4afd-8ec4-4d9cf4e245e5">
  <data key="d2">fact_entity</data>
