  <data key="d2">entity_fact</data>
  <data key="d4">is responsible for paying</data>
</edge>
<edge source="a14260b2-2a18-4766-b8c5-0c98de115f07" target="e92e0ea5-c65d-41a2-8ffb-fb2ed9910e6d">
  <data key="d2">entity_fact</data>
  <data key="d4">receives payment from</data>
</edge>
