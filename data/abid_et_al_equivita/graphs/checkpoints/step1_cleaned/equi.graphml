<edge source="fa298b78-ed8c-4e0c-bf92-26cf2ce452f8" target="66d34f7f-f03b-44b9-ae46-16416415bc2a">
  <data key="d3">The reinstatement clause depends on proper documentation and compliance, which aligns with the broader rule requiring written agreements for any changes, reinforcing procedural legitimacy.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="fa298b78-ed8c-4e0c-bf92-26cf2ce452f8" target="a2f514f9-483a-46e4-bd60-a528a1b42c8b">
  <data key="d3">The requirement for formal authorization to waive policy terms ensures that reinstatement-related adjustments, such as resetting contestability periods, cannot occur informally or retroactively without proper documentation.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="0863b94e-ba56-44ca-b03c-bff8f773e729" target="fa298b78-ed8c-4e0c-bf92-26cf2ce452f8">
