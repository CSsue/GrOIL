  <data key="d3">Reinstating the policy triggers a renewal of the two-year contestability window, effectively extending the scope of potential claims review beyond the original issue date based on the terms defined earlier.</data>
  <data key="d4">restarts</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
