  <data key="d3">Reinstatement eligibility after lapse depends on timely action within five years, but only applies when the policy has already passed through the grace period without resolution.</data>
  <data key="d4">precedes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
