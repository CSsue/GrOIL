  <data key="d3">The beneficiary designation establishes who receives the death benefit, which is quantified by the face amount specified in the policy.</data>
  <data key="d4">defines</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
