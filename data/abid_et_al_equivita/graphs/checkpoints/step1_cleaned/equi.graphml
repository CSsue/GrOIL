  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="f4dfbce0-ca9c-4a02-8aa7-27e266777ed0" target="5aac9030-cfc4-4ca0-a02f-55a5e55106d9">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
