  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="3f213a1e-e278-42fb-8c8b-f3adf267911d" target="f3de14c3-0bd3-44f4-9203-5e3e53cbb178">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="3f213a1e-e278-42fb-8c8b-f3adf267911d" target="eee61ae5-6be2-4425-b772-55ec2b564a21">
  <data key="d2">fact_entity</data>
  <data key="d4">organization</data>
</edge>
<edge source="3f213a1e-e278-42fb-8c8b-f3adf267911d" target="b821324e-ebec-49e5-8794-a16836849750">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="3f213a1e-e278-42fb-8c8b-f3adf267911d" target="8c8d6717-1114-4bed-a7bd-1b9ac720bf67">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
