  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="a20ed2b4-2a6b-44d6-aa80-4f3de6e88160" target="dc93db48-3a87-4beb-997c-f17f07c36e61">
  <data key="d2">fact_entity</data>
