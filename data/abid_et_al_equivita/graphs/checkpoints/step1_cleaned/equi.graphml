  <data key="d3">The face amount of $500,000 determines the sum payable to the beneficiary, Taylor Ellis, if the insured dies during the policy term, establishing the financial obligation tied to the beneficiary designation.</data>
  <data key="d4">entitles</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
