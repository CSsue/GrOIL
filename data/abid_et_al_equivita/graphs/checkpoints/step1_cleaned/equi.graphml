ional_anchors":["equal to the Face Amount shown in the Policy Specifications","less any unpaid premiums or indebtedness"]},{"name":"Insured","type":"PERSON","role":"individual covered by life insurance","relational_anchors":[]},{"name":"Company","type":"ORGANIZATION","role":"insurer issuing and administering policy","relational_anchors":["rate specified by the Company at the time of reinstatement"]},{"name":"Beneficiary","type":"PERSON","role":"recipient of death benefit payout","relational_anchors":[]},{"name":"Contingent Beneficiary","type":"PERSON","role":"secondary recipient if primary beneficiary predeceases","relational_anchors":[]},{"name":"certified death certificate","type":"DOCUMENT","role":"primary proof of death required","relational_anchors":[]},{"name":"Proof of Death","type":"PROCESS","role":"verification step before benefit disbursement","relational_anchors":["including a certified death certificate"]},{"name":"right to investigate","type":"RIGHT","role":"company authority over claim validity","relational_anchors":["contestation possible within contestability period"]},{"name":"lump sum","type":"PAYMENT","role":"default method of death benefit distribution","relational_anchors":["unless alternative election was made"]},{"name":"interest rate","type":"RATE","role":"accrual applied to delayed payments","relational_anchors":["not less than required by applicable state law"]}]},{"name":"Overdue Premiums with Interest","sentence":"All overdue premiums must be paid with interest at the rate specified by the Company at the time of reinstatement.","macro_topics":[],"chunk_topics":["Reinstatement Rights","Overdue Premiums","Policy Lapse"],"entities":[{"name":"Lapse for Nonpayment","type":"CONCEPT","role":"trigger condition for policy termination","relational_anchors":[]},{"name":"end of the grace period","type":"DATE","role":"deadline for premium payment","relational_anchors":[]},{"name":"due date of the unpaid premium","type":"DATE","role":"effective date of