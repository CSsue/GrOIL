<edge source="9849a0f2-a835-4ab0-9793-62acf42df5ec" target="a02029bc-d32a-41e0-a806-f525ebfc428c">
  <data key="d3">Because the insurer is not responsible for obligations before reinstatement, the restoration of the policy's status does not retroactively impose liability on the company for past events.</data>
  <data key="d4">limits</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
