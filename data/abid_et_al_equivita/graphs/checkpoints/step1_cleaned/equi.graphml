  <data key="d2">entity_fact</data>
  <data key="d4">may trigger adjustment or denial if fraudulent</data>
</edge>
<edge source="cfdd17cc-6eef-4a66-88f7-fd7a88295b0c" target="2ff2e286-b2f4-46d0-a585-be514606308f">
  <data key="d2">entity_fact</data>
  <data key="d4">applies only upon proof of fraud</data>
</edge>
