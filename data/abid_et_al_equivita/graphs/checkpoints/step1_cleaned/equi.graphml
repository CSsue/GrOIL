  <data key="d2">entity_fact</data>
  <data key="d4">remains payable during</data>
</edge>
<edge source="c68a40de-ebd3-43cf-88e6-0d2a03b5bb8f" target="e877399f-ddc1-47c4-afa4-1ee3ff20f43e">
  <data key="d2">entity_fact</data>
  <data key="d4">keeps policy in force</data>
</edge>
