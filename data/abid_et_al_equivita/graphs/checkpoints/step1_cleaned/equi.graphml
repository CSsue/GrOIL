<edge source="988c3be0-9555-43fe-a0e7-92bfd1b7079e" target="74da563a-668e-4838-9c04-3edc34513cfb">
  <data key="d3">Any limitation on the Policy Owner’s rights—such as from an irrevocable beneficiary—is justified because all actions must conform to the policy’s established terms.</data>
  <data key="d4">enforces conditions</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.92</data>
