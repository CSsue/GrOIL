  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="e877399f-ddc1-47c4-afa4-1ee3ff20f43e" target="c68a40de-ebd3-43cf-88e6-0d2a03b5bb8f">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="e877399f-ddc1-47c4-afa4-1ee3ff20f43e" target="9ba1deeb-b933-45e5-914d-9ef1bc253548">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
