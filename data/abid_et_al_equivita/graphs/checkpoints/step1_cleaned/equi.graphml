<node id="5cc7ad10-bf43-48ed-a5f1-29fffe5f29c5">
  <data key="d0">{"name":"Legal Resilience &amp; Agreement Integrity","text":"Severability  \nIf any provision of this Policy is held to be invalid or unenforceable under applicable law, \nthe remaining provisions shall remain in full force and effect to the extent permitted by law.  \nEntire Agreement and Waiver  \nThis Policy constitutes the complete agreement between the parties. No waiver of any term or \ncondition of this Policy shall be valid unless made in writing and signed by an authorized \nofficer of the Company. Failure to enforce any provision shall not constitute a waiver of future \nenforcement of that or any other provision.\n","summary":"This section addresses the legal resilience of the policy through severability—ensuring unaffected portions remain valid if one part is deemed unenforceable—and confirms that the policy serves as the complete agreement between parties. It also clarifies that no right can be waived without written consent from an authorized company officer, and silence or inaction does not imply relinquishment of those rights.","topics":["Legal Clauses","Contractual Terms","Enforceability"],"facts":[{"name":"Invalid Provision Handling","sentence":"A provision of this Policy may be held invalid or unenforceable under applicable law.","macro_topics":[],"chunk_topics":["severability","invalid provision","legal enforceability"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Severability Clause","sentence":"If a provision of this Policy is held invalid or unenforceable under applicable law, the remaining provisions remain in full force and effect.","macro_topics":[],"chunk_topics":["severability","invalid provision","remaining provisions"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Severability Clause","sentence":"The remaining provisions remain in full force and effect to the extent permitted by law.","macro_topics":[],"chunk_topics":["severability","legal validity","contract enforcement"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Complete Agreement Clause","sentence":"This Policy constitutes the complete agreement between the parties.","macro_topics":[],"chunk_topics":["entire agreement","legal completeness","contractual finality"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Written Waiver Requirement","sentence":"No waiver of any term or condition of this Policy is valid unless made in writing.","macro_topics":[],"chunk_topics":["waiver validity","written consent","contractual terms"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Waiver Validity Requirement","sentence":"No waiver of any term or condition of this Policy is valid unless signed by an authorized officer of the Company.","macro_topics":[],"chunk_topics":["waiver validity","written authorization","company officer signature"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Non-Waiver of Enforcement Rights","sentence":"Failure to enforce any provision of this Policy does not constitute a waiver of future enforcement of that provision.","macro_topics":[],"chunk_topics":["non-waiver clause","enforcement failure","contractual compliance"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]},{"name":"Non-Waiver of Future Enforcement","sentence":"Failure to enforce any provision of this Policy does not constitute a waiver of future enforcement of any other provision.","macro_topics":[],"chunk_topics":["non-waiver clause","failure to enforce","legal enforceability"],"entities":[{"name":"Severability","type":"CONCEPT","role":"clause ensuring partial enforceability","relational_anchors":[]},{"name":"Entire Agreement","type":"CONCEPT","role":"statement of comprehensive binding agreement","relational_anchors":[]},{"name":"Waiver","type":"CONCEPT","role":"formal relinquishment of rights requirement","relational_anchors":[]},{"name":"this Policy","type":"CONCEPT","role":"referential anchor for governing document","relational_anchors":[]}]}]}</data>
