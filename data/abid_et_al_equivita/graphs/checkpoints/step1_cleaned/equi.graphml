  <data key="d2">entity_fact</data>
  <data key="d4">maintains obligation toward</data>
</edge>
<edge source="657cd720-00af-4dca-b23c-b9797ef1f0ec" target="e877399f-ddc1-47c4-afa4-1ee3ff20f43e">
  <data key="d2">entity_fact</data>
  <data key="d4">retains rights over</data>
</edge>
