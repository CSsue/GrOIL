  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="a20ed2b4-2a6b-44d6-aa80-4f3de6e88160" target="f2d7522f-1b13-444a-a27a-216e04d45043">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="a20ed2b4-2a6b-44d6-aa80-4f3de6e88160" target="9449519c-c270-444b-98bc-73728477e9a7">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
