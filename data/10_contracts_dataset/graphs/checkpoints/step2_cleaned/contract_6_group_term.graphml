      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="06ec4160-b42d-4ff4-aade-db4dc4398172" target="7e40dc8d-27b1-4656-b6c2-eb7ffc22920a">
      <data key="d2">fact_entity</data>
      <data key="d4">condition</data>
