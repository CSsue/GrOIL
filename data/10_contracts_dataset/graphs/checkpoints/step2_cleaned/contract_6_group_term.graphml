      <data key="d5">0.95</data>
    </edge>
    <edge source="c640c250-030a-4238-b2c4-ee2b7b8201bf" target="ffc538ab-5ff6-4960-b2c1-1eef9713da66">
      <data key="d3">The employer's payment of basic coverage premiums ensures the availability of the life insurance benefit, which is determined by the employee's salary under company policy.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
    <edge source="c640c250-030a-4238-b2c4-ee2b7b8201bf" target="ebda2a4b-af98-4477-809f-34d2ba734e4c">
