    <edge source="a4f89de4-1afc-4c97-948f-48c37a6cfc59" target="a765b598-82bc-415b-9a84-dfacec6ee8f3">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="a4f89de4-1afc-4c97-948f-48c37a6cfc59" target="34c1a5f4-ad25-4ea8-ab74-f1c93b41c2d0">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
