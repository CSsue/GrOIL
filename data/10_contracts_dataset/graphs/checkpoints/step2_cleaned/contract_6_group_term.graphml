    <edge source="c640c250-030a-4238-b2c4-ee2b7b8201bf" target="693c8b53-e227-49d5-956d-bb6f61b86d8b">
      <data key="d3">Employer-paid premiums ensure financial support for basic coverage, enabling its availability when the employee becomes eligible. This funding allows the policy to become active without further steps from the employee.</data>
      <data key="d4">corroborates</data>
      <data key="d2">fact_fact</data>
