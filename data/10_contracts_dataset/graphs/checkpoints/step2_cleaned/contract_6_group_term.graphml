    </edge>
    <edge source="2a484835-c2d5-4916-aaf4-80a161c5cdca" target="ae3babc3-1161-43c1-86cb-df6f03bcc6f1">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
