      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="61937f46-373a-4006-9ace-d654c1af6a04" target="b3bb3673-dfdd-4af1-8071-ba302ce23085">
      <data key="d2">fact_entity</data>
