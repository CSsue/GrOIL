      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="2a484835-c2d5-4916-aaf4-80a161c5cdca" target="dcc4c428-43cb-4d02-a9e3-f5e2f47a808d">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="2a484835-c2d5-4916-aaf4-80a161c5cdca" target="2dd2df14-4129-4e5a-85a9-aa7e751bd7ce">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="2a484835-c2d5-4916-aaf4-80a161c5cdca" target="b2b8c022-7e5b-4332-b7bf-c831d13781ba">
      <data key="d2">fact_entity</data>
      <data key="d4">amount</data>
    </edge>
    <edge source="2a484835-c2d5-4916-aaf4-80a161c5cdca" target="1194f15e-f43b-48e6-87ea-4abfb7d5e7f2">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
