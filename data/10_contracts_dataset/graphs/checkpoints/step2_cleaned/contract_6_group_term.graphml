      <data key="d3">The basic benefit is rounded to the next highest $1,000 each time it is recalculated annually on the policy anniversary, ensuring consistent application of the rounding rule within the update cycle.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.9</data>
    </edge>
