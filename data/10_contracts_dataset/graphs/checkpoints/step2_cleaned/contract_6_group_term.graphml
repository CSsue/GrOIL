      <data key="d3">The requirement to pay premiums directly to the insurance company applies specifically after an employee ports their group coverage to an individual policy upon leaving employment.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
