      <data key="d2">fact_entity</data>
      <data key="d4">document</data>
    </edge>
    <edge source="d03f6263-7bbe-40c1-89fa-5e693533134a" target="9a440e9f-45ea-4ef2-bad2-2ff1165dd255">
      <data key="d2">fact_entity</data>
