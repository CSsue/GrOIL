      <data key="d3">The insurance company's provision of group coverage enables the timely payment of benefits upon receipt of a complete claim, forming the basis for the claims process outlined in the summary.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
