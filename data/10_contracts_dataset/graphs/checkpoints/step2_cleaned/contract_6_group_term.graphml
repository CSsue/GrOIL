      <data key="d3">Jordan Casey Taylor is named as the primary beneficiary who would receive benefits if they survive the insured. In the absence of the primary beneficiary, the contingent beneficiary inherits the full benefit amount.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
