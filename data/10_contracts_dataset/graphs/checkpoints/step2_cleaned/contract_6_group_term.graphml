      <data key="d4">role</data>
    </edge>
    <edge source="e84179b5-cb9a-4de7-95e8-6de7582de182" target="2f5f9518-f1c8-42ed-a6f6-40461450ab8d">
      <data key="d2">fact_entity</data>
      <data key="d4">legal jurisdiction</data>
    </edge>
    <edge source="e84179b5-cb9a-4de7-95e8-6de7582de182" target="58ae820f-579c-44dc-8f5b-8b8c8aabed51">
      <data key="d3">Fact sentence 1 states the policy's issuance under California law, which directly supports the idea conveyed in fact sentence 2 about governance by the same law.</data>
      <data key="d4">corroborates</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
