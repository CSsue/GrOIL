    <edge source="50012b48-7eab-42a1-9339-4f987a82053c" target="2cbd5814-f54a-4af1-92c0-18cfd941020d">
      <data key="d3">Since the insurance company offers group coverage without pre-existing condition exclusions, it ensures broader eligibility under the plan.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="50012b48-7eab-42a1-9339-4f987a82053c" target="80ef03d9-a0d8-4e34-b854-917b328e532c">
      <data key="d3">The absence of pre-existing condition exclusions ensures broad accessibility to coverage, while the provision for paying benefits to the estate ensures continuity of payouts even without living beneficiaries.</data>
      <data key="d4">contextual relation</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
    <edge source="50012b48-7eab-42a1-9339-4f987a82053c" target="22c4b994-6a5b-49d5-a129-731be848f272">
      <data key="d3">The absence of pre-existing condition exclusions ensures broad accessibility to coverage, enabling more members to qualify for benefits. This inclusivity supports timely claims processing by reducing potential delays due to medical screening disputes.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
