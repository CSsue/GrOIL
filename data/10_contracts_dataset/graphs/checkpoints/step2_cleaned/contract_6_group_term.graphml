      <data key="d2">entity_fact</data>
      <data key="d4">amounts up to 75% of death benefit</data>
    </edge>
    <edge source="344d076c-8112-4f79-81ea-744d0cffb2af" target="ad33389a-5e72-4baf-8990-51a347fe4a8a">
      <data key="d2">entity_fact</data>
      <data key="d4">total death benefit used to calculate accelerated amount</data>
    </edge>
