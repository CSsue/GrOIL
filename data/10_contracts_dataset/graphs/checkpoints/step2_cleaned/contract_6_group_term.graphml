    <edge source="72af3f2b-1c51-48ee-8da5-c36c14e9735e" target="2cbd5814-f54a-4af1-92c0-18cfd941020d">
      <data key="d3">A key restriction—no payout for suicide within the first year—is only relevant because the insurance company offers group coverage, meaning beneficiaries may face limitations even under standard policies.</data>
      <data key="d4">conditions</data>
      <data key="d2">fact_fact</data>
