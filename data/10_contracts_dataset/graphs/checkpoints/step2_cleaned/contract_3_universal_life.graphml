      <data key="d4">person</data>
    </edge>
    <edge source="df4d1d6e-8a2e-4aef-be1d-f03f2bb2dee0" target="d5cc9aa1-4eb2-463a-99a8-8dd4e458b0f7">
      <data key="d2">fact_entity</data>
      <data key="d4">person</data>
    </edge>
