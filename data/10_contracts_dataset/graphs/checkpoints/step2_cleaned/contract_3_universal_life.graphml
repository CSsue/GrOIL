      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="41c5d4e5-1a4c-49c6-93b9-86a0c912c977" target="61921e78-5512-4f4c-9776-64fb8acecda6">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
