      <data key="d2">entity_fact</data>
      <data key="d4">deducted on</data>
    </edge>
    <edge source="14077d06-dc5f-4659-8130-d211ac191ef1" target="40116a52-d516-4b17-8b5c-41312619c88e">
      <data key="d2">entity_fact</data>
      <data key="d4">influences</data>
