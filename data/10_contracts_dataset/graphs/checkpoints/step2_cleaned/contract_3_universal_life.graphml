      <data key="d2">fact_entity</data>
      <data key="d4">option</data>
    </edge>
    <edge source="de1c9695-ef86-44d3-817c-e20ff49543a7" target="961fe23e-d2f2-486b-a266-848131540ce1">
      <data key="d2">fact_entity</data>
      <data key="d4">option</data>
    </edge>
    <edge source="de1c9695-ef86-44d3-817c-e20ff49543a7" target="71856dc2-133d-4bb1-b0cf-c6ac445f3f37">
      <data key="d2">fact_entity</data>
      <data key="d4">condition</data>
