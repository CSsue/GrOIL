      <data key="d2">fact_entity</data>
      <data key="d4">rate</data>
    </edge>
    <edge source="c7dd6118-69b1-47ff-a5b4-fc2086782f63" target="4cbc7fb2-e9ab-4b8c-8152-f089c46179c8">
      <data key="d2">fact_entity</data>
      <data key="d4">minimum rate</data>
    </edge>
    <edge source="c7dd6118-69b1-47ff-a5b4-fc2086782f63" target="c6e4f2cc-af5f-4140-86a5-3d9e4f3b4a92">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
