      <data key="d3">Changing death benefit options involves considerations such as reducing the payout due to outstanding loans, which subtract from the final amount paid out upon death.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
