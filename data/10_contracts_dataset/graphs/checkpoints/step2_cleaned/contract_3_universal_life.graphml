      <data key="d2">fact_entity</data>
      <data key="d4">year range</data>
    </edge>
    <edge source="63a11648-dce1-4eab-baac-b85dc94452ef" target="4609fe9d-7d70-4aa3-b831-db185d68f4d6">
      <data key="d2">fact_entity</data>
