    <edge source="de1c9695-ef86-44d3-817c-e20ff49543a7" target="f2fc8153-47a2-4253-9c20-d377b23307b4">
      <data key="d2">fact_entity</data>
      <data key="d4">interest rate</data>
    </edge>
