      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="19e2df30-bca6-4c17-a14c-779571d3b27e" target="ce7d47ba-e8ea-4ce3-9827-d461a3931bbc">
      <data key="d2">fact_entity</data>
