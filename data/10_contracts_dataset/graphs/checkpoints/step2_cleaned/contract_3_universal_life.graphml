      <data key="d4">rate</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="003534ff-4936-4d36-a59c-9c1c0a5fe399">
      <data key="d2">fact_entity</data>
      <data key="d4">minimum rate</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="f88068b8-d6f9-4856-902d-1b5735e1e769">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="0cb1e7ea-fa6d-4c30-8313-b3c5edf1fb19">
      <data key="d2">fact_entity</data>
      <data key="d4">year range</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="d589340d-24aa-461d-b679-85bb13f2ebf1">
      <data key="d2">fact_entity</data>
      <data key="d4">year range</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="4b7de323-3ad1-43cc-8aaa-c6fda1e00654">
      <data key="d2">fact_entity</data>
      <data key="d4">percentage</data>
    </edge>
    <edge source="e467f66f-8ebe-41fd-8e9c-a879c062996c" target="02457f8f-9a0c-48b2-abdb-1e26aa00b3fa">
      <data key="d2">fact_entity</data>
