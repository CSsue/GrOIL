      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="c2e2155b-e87f-4d17-86da-eb5c1aff1318" target="a59c4d27-e30e-4211-9762-23dbfbc5c7fb">
      <data key="d2">fact_entity</data>
      <data key="d4">monetary value</data>
    </edge>
