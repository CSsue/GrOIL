      <data key="d2">entity_fact</data>
      <data key="d4">timing of monthly deduction</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="9312f716-2e73-4b87-9533-9d664b7eb5c5">
      <data key="d2">fact_entity</data>
      <data key="d4">person</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="0632f171-9ec7-43ef-97cc-0a8f4ee2e36e">
      <data key="d2">fact_entity</data>
      <data key="d4">person</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="11ab06d3-1e78-41f8-b60d-512d9409b382">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="76505e8e-8158-4d68-b258-774daecf649f">
