      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="df4d1d6e-8a2e-4aef-be1d-f03f2bb2dee0" target="6a01ce58-07d7-4f27-83ff-e2e012341da9">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="df4d1d6e-8a2e-4aef-be1d-f03f2bb2dee0" target="c6daea52-66b0-452a-9f95-d96008fa640a">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="df4d1d6e-8a2e-4aef-be1d-f03f2bb2dee0" target="edd8ca1e-7f50-45cf-8e9b-7f2ab5fbf7a0">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="df4d1d6e-8a2e-4aef-be1d-f03f2bb2dee0" target="68d693a7-c924-411e-9a39-2dfd500a6664">
