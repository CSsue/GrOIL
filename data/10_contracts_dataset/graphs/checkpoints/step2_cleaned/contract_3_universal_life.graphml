    </edge>
    <edge source="78ae0a1e-3056-4039-bbc1-344b5b6b24a5" target="f9e5301b-4eb7-4d92-a0e8-4e3c2bed0ac0">
      <data key="d2">fact_entity</data>
      <data key="d4">year range</data>
    </edge>
