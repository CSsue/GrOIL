    <edge source="cfdb2248-6b51-4750-aa82-60cc46963f85" target="b0f4f00a-0e54-49ad-bb1a-e78c2dfaa0d9">
      <data key="d3">Guaranteed maximum COI rates ensure that the monthly deductions remain within defined bounds, maintaining financial consistency.</data>
      <data key="d4">enforces</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="cfdb2248-6b51-4750-aa82-60cc46963f85" target="d2d7f644-175d-4fe0-ae25-131e657d096a">
      <data key="d3">The guarantee that COI rates won’t exceed those in the rate schedule ensures predictable deductions, directly influencing how much is taken from the account value during each monthly deduction.</data>
      <data key="d4">constrains</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="cfdb2248-6b51-4750-aa82-60cc46963f85" target="d8801d10-4c5d-4ab8-88e5-7f8a5417a886">
      <data key="d3">The COI rate used in the calculation formula must remain within the bounds set by the official rate schedule, ensuring predictable and controlled costs.</data>
      <data key="d4">constrains</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="e73a8154-3ae5-43f8-8442-942311eaee4f" target="cfdb2248-6b51-4750-aa82-60cc46963f85">
