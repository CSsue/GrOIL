      <data key="d2">fact_entity</data>
      <data key="d4">minimum rate</data>
    </edge>
    <edge source="63a11648-dce1-4eab-baac-b85dc94452ef" target="b2cf9189-7501-499c-b7aa-7ab3a0237569">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="63a11648-dce1-4eab-baac-b85dc94452ef" target="61e805b6-5a56-48d2-aa10-0e6efbdea811">
      <data key="d2">fact_entity</data>
      <data key="d4">year range</data>
    </edge>
