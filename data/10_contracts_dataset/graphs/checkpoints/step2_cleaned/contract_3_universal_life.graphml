      <data key="d3">Policy termination upon surrender depends on the accumulated Account Value derived from premium allocations after deducting fees like the 3% charge mentioned earlier.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
