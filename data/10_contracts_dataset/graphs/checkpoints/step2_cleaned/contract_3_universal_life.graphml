    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="b0f4f00a-0e54-49ad-bb1a-e78c2dfaa0d9">
      <data key="d3">The formula in sentence 2 quantifies the Cost of Insurance component, which is part of the broader set of monthly deductions occurring on the Monthly Deduction Date as stated in sentence 1.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="d2d7f644-175d-4fe0-ae25-131e657d096a">
      <data key="d3">The method used to calculate the Cost of Insurance determines the precise amount that gets deducted during the monthly deduction process.</data>
      <data key="d4">causes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="cfdb2248-6b51-4750-aa82-60cc46963f85">
      <data key="d3">The formula for calculating Cost of Insurance depends on the monthly COI rate, which is subject to maximums defined in the attached rate schedule.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="11b71933-ace2-4b35-93af-02c6950eff98">
      <data key="d3">The Cost of Insurance calculation relies on the Specified Amount, which is defined as the constant death benefit under the Level Death Benefit option described here.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="fcc5d4f1-98b6-4db9-90f4-acbeec66da4c">
      <data key="d3">The calculation of Cost of Insurance relies on the Account Value, which is explicitly included in the Increasing Death Benefit formula described here.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="d8801d10-4c5d-4ab8-88e5-7f8a5417a886" target="fed25863-324a-4e70-9aea-8082dbd86103">
      <data key="d3">The formula for calculating Cost of Insurance depends on the policy’s specified amount and account value but does not require evidence of insurability. Evidence of insurability is only needed if the policyholder seeks increased coverage levels.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
