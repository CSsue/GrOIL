      <data key="d4">concept</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="ffb4d299-93ff-435b-a8dd-ed6c9ea223e9">
      <data key="d2">fact_entity</data>
      <data key="d4">date</data>
    </edge>
    <edge source="5e1c407b-5a34-46a9-a8c2-c1e5dc597284" target="7ebb16c5-eb04-40e5-8546-909fda0fccb2">
      <data key="d2">fact_entity</data>
