      <data key="d2">fact_entity</data>
      <data key="d4">monetary value</data>
    </edge>
    <edge source="c7dd6118-69b1-47ff-a5b4-fc2086782f63" target="7ce68971-d9ac-41f6-b9aa-d1dd5afebc2a">
      <data key="d2">fact_entity</data>
      <data key="d4">monetary value</data>
    </edge>
