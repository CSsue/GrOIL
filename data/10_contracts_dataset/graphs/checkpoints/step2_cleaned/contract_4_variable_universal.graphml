    </edge>
    <edge source="f1fab3de-ee39-499b-b5bb-1d9134b0517d" target="6609aab0-8bef-493f-a6c7-30042cfc3b43">
      <data key="d3">Fact sentence 2 identifies the fixed 5.5% interest rate applied to policy loans, which operates under the constraint defined in fact sentence 1—that loans cannot exceed 90% of surrender value.</data>
      <data key="d4">complements</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="f1fab3de-ee39-499b-b5bb-1d9134b0517d" target="280ab5d3-6e4f-4198-81c8-a2ef27b919d6">
      <data key="d3">A fixed 5.5% annual interest applies to policy loans, which are taken against the surrender value. This interest accumulates over time but does not affect how much the death benefit decreases when a loan is issued.</data>
      <data key="d4">independently related</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
    <edge source="ac508097-b7de-4af1-b3c0-3db960314f53" target="f1fab3de-ee39-499b-b5bb-1d9134b0517d">
      <data key="d2">entity_fact</data>
      <data key="d4">fixed interest rate</data>
    </edge>
