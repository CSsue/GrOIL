      <data key="d4">concept</data>
    </edge>
    <edge source="67ae83fb-0cf5-44ec-b533-6271ab72c41e" target="4f8761f8-f60b-4cb1-b285-e70db0a36f6d">
      <data key="d2">fact_entity</data>
      <data key="d4">sub account</data>
    </edge>
    <edge source="67ae83fb-0cf5-44ec-b533-6271ab72c41e" target="adfbd477-dad9-4980-8236-7657ee7fee4b">
      <data key="d2">fact_entity</data>
      <data key="d4">rate</data>
    </edge>
    <edge source="67ae83fb-0cf5-44ec-b533-6271ab72c41e" target="bf18b471-0ff9-4e1b-a8c3-301b5836c922">
      <data key="d2">fact_entity</data>
      <data key="d4">limit</data>
    </edge>
    <edge source="67ae83fb-0cf5-44ec-b533-6271ab72c41e" target="f6f22f6d-c9c3-4f7a-9fb3-ba8221901fc8">
