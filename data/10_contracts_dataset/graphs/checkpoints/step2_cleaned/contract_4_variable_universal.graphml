    <edge source="3e851cbd-ccf3-4477-9f3d-4f20316c7521" target="89409c54-bed8-4ec7-9f17-d30aaecf68d3">
      <data key="d3">The ability to change allocations at any time may prompt investors to review expense ratios before making adjustments, highlighting how access to fee details supports informed decision-making.</data>
      <data key="d4">informs</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
    <edge source="3e851cbd-ccf3-4477-9f3d-4f20316c7521" target="db0522da-0d9d-479f-9d33-41c3c624b1ce">
      <data key="d3">The ability to change allocations at any time sets the context for when surrender charges might apply, depending on how soon after purchase or prior changes the modification occurs.</data>
      <data key="d4">conditional on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="3e851cbd-ccf3-4477-9f3d-4f20316c7521" target="20ce4777-7e1a-4273-b5c7-82e39fac1476">
