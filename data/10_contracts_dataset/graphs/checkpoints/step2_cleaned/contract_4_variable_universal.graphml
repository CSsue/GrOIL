    <edge source="a270d4dd-8dc4-4636-bdb4-68ecbe2ee923" target="e2d6b134-e378-4016-9aec-83160141d68a">
      <data key="d3">Repayment of outstanding loans is a condition for reinstating the policy, making timely awareness via the 30-day lapse notice essential for compliance.</data>
      <data key="d4">required for</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.92</data>
    </edge>
    <edge source="a270d4dd-8dc4-4636-bdb4-68ecbe2ee923" target="7f729579-af9d-4934-af44-77d11dd937c9">
      <data key="d3">Fact_sentence_2 specifies that outstanding loans must be repaid to reinstate the policy, representing a financial obligation unrelated to the medical eligibility requirement stated in fact_sentence_1.</data>
      <data key="d4">complements</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
    <edge source="a270d4dd-8dc4-4636-bdb4-68ecbe2ee923" target="e381b39e-f494-4cde-959e-aff5ec7c393c">
      <data key="d3">Fact_sentence_2 mandates repayment of outstanding loans, which is an additional requirement alongside the payment of overdue charges and interest described in fact_sentence_1.</data>
      <data key="d4">complements</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="a270d4dd-8dc4-4636-bdb4-68ecbe2ee923" target="82754332-e72e-42c2-8178-8d00ac6d8b55">
      <data key="d3">Fact_sentence_2 outlines a prerequisite for reinstating a lapsed policy: repaying outstanding loans. This condition logically follows from fact_sentence_1, where insufficient funds lead to lapse, making loan repayment necessary to restore coverage.</data>
      <data key="d4">required for reinstatement</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.87</data>
    </edge>
