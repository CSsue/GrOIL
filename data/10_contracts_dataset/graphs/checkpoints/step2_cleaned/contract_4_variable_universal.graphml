    <edge source="1d7528cf-578b-4c9e-805a-b6d7077a310f" target="0a3e0c50-8fc9-4679-94bb-856bff774ce7">
      <data key="d3">The risk of policy lapse stems from inadequate fund accumulation, which occurs when the Variable option experiences poor performance—an outcome tied specifically to the selection made in fact_sentence_1.</data>
      <data key="d4">caused by</data>
      <data key="d2">fact_fact</data>
