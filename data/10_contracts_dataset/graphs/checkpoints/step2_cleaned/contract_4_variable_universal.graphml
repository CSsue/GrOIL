    <edge source="67add080-3372-4301-bd74-0e6a0c67fa5b" target="d4b0a171-5ef3-4669-b3a4-2f4f8afafc3d">
      <data key="d3">When partial withdrawals occur, the face amount decreases proportionally, thereby reducing the total death benefit calculated as Face Amount plus Account Value under Option II.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
