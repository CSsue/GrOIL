    <edge source="c91cac6d-fc47-48ab-bd69-5b89c45738b7" target="b3c9f929-6648-448d-b819-7cdd2f47e72e">
      <data key="d3">Fact_sentence_2 specifies that aviation-related deaths are excluded without prior approval, much like how fact_sentence_1 excludes military deaths in war zones within 24 months—both reflect conditional exclusions based on activity type.</data>
      <data key="d4">exclusions parallel</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
    <edge source="c91cac6d-fc47-48ab-bd69-5b89c45738b7" target="bc4a44ad-5ecb-4ffc-b4fd-fdcc6934df7f">
      <data key="d3">The exclusion of aviation-related deaths requires special approval and extra premium, reflecting heightened risk management typical in complex financial products. This aligns with the policy’s status as a regulated securities product overseen by the SEC.</data>
      <data key="d4">contextualizes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
