      <data key="d3">The fixed annual premium provides the funding base for the policy, while the daily application of the M&amp;E charge reduces the available account value incrementally throughout the year.</data>
      <data key="d4">funding source</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
