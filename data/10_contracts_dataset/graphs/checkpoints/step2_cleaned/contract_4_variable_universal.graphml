      <data key="d2">fact_fact</data>
      <data key="d5">0.87</data>
    </edge>
    <edge source="1d7528cf-578b-4c9e-805a-b6d7077a310f" target="20ce4777-7e1a-4273-b5c7-82e39fac1476">
      <data key="d3">If poor investment results cause the policy to lapse, investors cannot access accumulated value via surrender, rendering the 3% surrender charge irrelevant by default.</data>
      <data key="d4">contributes to</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
