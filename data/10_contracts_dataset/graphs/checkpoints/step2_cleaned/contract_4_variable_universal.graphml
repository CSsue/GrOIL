    <edge source="1dbe7802-6ae3-4a4f-a1b6-0103ad7965b5" target="81e49cb2-9973-4f29-93f9-b747d6bd02ec">
      <data key="d3">Investor-directed allocations require prior processing of premium payments, including application of the 5% loading, ensuring funds are available for distribution.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
