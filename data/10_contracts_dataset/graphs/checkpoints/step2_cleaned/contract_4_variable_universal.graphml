      <data key="d3">The initial face amount of $1 million defines the payout obligation upon death, established at policy issuance. This figure is set on the policy date, April 5, 2024, confirming its validity from inception.</data>
      <data key="d4">set at</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
