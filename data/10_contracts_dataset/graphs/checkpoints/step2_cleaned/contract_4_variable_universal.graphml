      <data key="d3">Fact sentence 2 describes a lower surrender charge (5%) applicable from Years 3–4, which follows and reflects a continuation of the trend initiated by the higher charge described in fact sentence 1.</data>
      <data key="d4">follows</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
