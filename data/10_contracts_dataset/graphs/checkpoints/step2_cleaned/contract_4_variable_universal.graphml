    <edge source="6f5fd4c3-4d4e-467b-8e2b-426f62766921" target="ee48c30b-3bf6-4f6b-acb3-b55f04f44cd8">
      <data key="d3">The initial face amount of $1 million determines the payout size available to beneficiaries upon the insured’s death. This sum may be distributed to the secondary beneficiary, Foster Children's Trust, if conditions specified in the policy are met.</data>
      <data key="d4">contextual relation</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
