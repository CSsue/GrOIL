      <data key="d3">The growing death benefit under Option II depends on the accumulation of account value, which results from premium payments being invested in sub-accounts post-load.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
