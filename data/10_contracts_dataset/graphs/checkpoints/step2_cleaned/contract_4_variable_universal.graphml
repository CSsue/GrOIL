    <edge source="d4b0a171-5ef3-4669-b3a4-2f4f8afafc3d" target="5d223ba0-ac0f-4dce-85c5-d0617f2418c2">
      <data key="d3">Partial withdrawals reducing the face amount proportionally could lead to earlier surrender scenarios where the 7% surrender charge would apply, linking withdrawal behavior to exit penalties.</data>
      <data key="d4">related to</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
