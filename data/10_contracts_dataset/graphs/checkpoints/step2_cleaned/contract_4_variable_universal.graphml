      <data key="d3">Foster Children's Trust serves as the secondary beneficiary entitled to receive benefits from the policy, including the initial face amount of $1 million, should the primary beneficiary not qualify.</data>
      <data key="d4">contextual relation</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
