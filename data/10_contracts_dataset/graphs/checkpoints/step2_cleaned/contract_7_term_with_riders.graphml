  <data key="d3">Rider 1, requiring annual proof of disability, contributes to the total annual premium of $1,089 detailed in the first statement.</data>
  <data key="d4">contributes to</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
