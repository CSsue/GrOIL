  <data key="d3">RIDER 6's annual premium is $89, and it becomes available for purchase at specific times, including when the insured reaches age 43.</data>
  <data key="d4">exemplifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
