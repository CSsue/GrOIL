  <data key="d3">The Guaranteed Insurability Rider (RIDER 6) provides additional coverage options at specific times; age 46 is one such eligible time when the rider may be exercised.</data>
  <data key="d4">exemplifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.9</data>
</edge>
