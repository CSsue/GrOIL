  <data key="d3">RIDER 6 incurs an annual premium of $89, enabling the policyholder to increase coverage at specific future points, such as age 49.</data>
  <data key="d4">exemplifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="87951d9a-26b1-4d25-a8f2-239ec1d0ae52" target="9c4cc2e2-e0dd-43cc-9162-2c30fb8592d7">
  <data key="d3">RIDER 6's annual premium is $89, and it becomes available for purchase upon specific life events such as the birth or adoption of a child.</data>
  <data key="d4">triggered by</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
