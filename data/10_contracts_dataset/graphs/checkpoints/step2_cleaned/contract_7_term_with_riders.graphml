  <data key="d2">fact_entity</data>
  <data key="d4">deduction</data>
</edge>
<edge source="8ea7b659-7380-42ed-b6f1-e4cffbb45c59" target="4b9fc48b-1bcc-4899-99d8-2968a44ccd5a">
