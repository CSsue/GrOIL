  <data key="d5">0.85</data>
</edge>
<edge source="b8cb3948-8eb7-4978-b2b6-d2d8621a4b18" target="4b0941c4-2ba4-47c4-820c-1ebace0a9c2c">
  <data key="d3">Age 49 being an eligible option date for RIDER 6 implies that the insured may increase coverage prior to the policy’s 2054 expiration, reinforcing its extended protective purpose.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
