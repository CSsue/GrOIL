  <data key="d3">The definition of Activities of Daily Living provides context for evaluating whether an individual qualifies under the disability criteria specified in Rider 1’s eligibility requirements.</data>
  <data key="d4">used in</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
