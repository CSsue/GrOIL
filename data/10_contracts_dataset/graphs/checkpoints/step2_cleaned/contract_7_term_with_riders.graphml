  <data key="d3">Fact sentence 2 notes that renewal premiums increase over time according to a set schedule, which operates under the existing annual payment structure described in fact sentence 1.</data>
  <data key="d4">modifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
