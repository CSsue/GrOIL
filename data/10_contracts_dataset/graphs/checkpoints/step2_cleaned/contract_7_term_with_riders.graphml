<edge source="eb966bac-9408-45d8-8f12-961e2781e108" target="6f640b89-f337-49ac-8e73-3d7620e5a591">
  <data key="d3">The Bennett Family Irrevocable Trust serves as a backup recipient should all primary beneficiaries fail to qualify or predecease the insured, ensuring continuity of payout after primary claims are resolved.</data>
  <data key="d4">primary backup</data>
  <data key="d2">fact_fact</data>
