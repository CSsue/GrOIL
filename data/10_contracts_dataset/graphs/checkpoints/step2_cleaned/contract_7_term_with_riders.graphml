  <data key="d3">Age 40 is one of the designated option dates under RIDER 6, allowing the purchase of additional coverage, which comes with an associated annual premium of $89.</data>
  <data key="d4">complements</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
