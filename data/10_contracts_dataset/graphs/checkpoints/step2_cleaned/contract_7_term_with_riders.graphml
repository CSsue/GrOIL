<edge source="024f312c-2a82-4c4b-9492-447ba61bada0" target="b938585a-fc9e-4358-bb77-95bbcf1e1f31">
  <data key="d3">Although the accidental death benefit expires upon reaching age 70, it still requires that death result from an accident within 90 days to be eligible—even before age 70, failure to meet this condition disqualifies claims.</data>
  <data key="d4">temporal restriction</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
