  <data key="d3">The $89 annual premium for the Guaranteed Insurability Rider applies specifically to the opportunity to increase coverage, but that opportunity is only valid if exercised within 90 days of an eligible event.</data>
  <data key="d4">conditional on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
