  <data key="d3">The Bennett Family Irrevocable Trust receives 100% of the proceeds only if all primary beneficiaries—including Christopher Bennett Jr.—are deceased or unqualified at the time of death. It cannot simultaneously hold 100% when others have defined shares.</data>
  <data key="d4">preempted by</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="8987c8ce-9bde-454b-9318-75cda3133158" target="1e05c4c2-d6ce-4d80-b83c-1a94c95e7fab">
  <data key="d3">The Bennett Family Irrevocable Trust serves as a contingent beneficiary receiving 100% of the death benefit only if all primary beneficiaries fail to survive or claim, making it irrelevant when primary beneficiaries like Olivia Grace Bennett are alive.</data>
  <data key="d4">contingent replacement</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
