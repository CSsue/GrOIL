  <data key="d3">The Bennett Family Irrevocable Trust functions as a secondary beneficiary who inherits the death benefit only if all primary beneficiaries, including Olivia Grace Bennett, are ineligible or fail to claim.</data>
  <data key="d4">primary backup</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
