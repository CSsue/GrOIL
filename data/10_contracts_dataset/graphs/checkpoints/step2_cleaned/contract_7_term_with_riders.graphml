  <data key="d3">Age 46 serves as a designated opportunity to exercise the right granted by RIDER 6 to increase coverage by up to $100,000.</data>
  <data key="d4">part of</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="247febe6-9b75-43a5-b350-13e76dd99201" target="5f90df18-58e5-4575-9e58-d2c545796976">
  <data key="d3">Fact sentence 2 lists age 46 as an option date for RIDER 6, complementing fact sentence 1's mention of age 40, together defining a broader set of allowable times to activate the rider.</data>
  <data key="d4">complements</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
