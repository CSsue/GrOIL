</edge>
<edge source="247febe6-9b75-43a5-b350-13e76dd99201" target="d617fcfa-ca1a-42af-b96a-3031b196a810">
  <data key="d3">Age 46 serves as a specific eligibility date enabling the exercise of RIDER 6, which permits acquiring additional coverage without medical underwriting as outlined in fact_sentence_1.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
