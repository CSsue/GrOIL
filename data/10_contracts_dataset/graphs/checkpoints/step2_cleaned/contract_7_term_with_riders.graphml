  <data key="d5">0.65</data>
</edge>
<edge source="fd499eef-7e7e-4325-9622-d0c882722492" target="c37a8c56-c455-4223-bf63-099ad8e97416">
  <data key="d3">Fact_sentence_2 specifies conditions affecting the cost of expanding coverage via RIDER 6, which helps explain why the overall annual premium in fact_sentence_1 reflects variable components based on future insurability criteria.</data>
  <data key="d4">explains cost</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
