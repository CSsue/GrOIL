  <data key="d2">fact_entity</data>
  <data key="d4">year</data>
</edge>
<edge source="1ff5fee4-2e90-43f5-9b90-379cb6250678" target="b3c6799d-0a18-44af-a78a-77e5d850cb94">
  <data key="d2">fact_entity</data>
