  <data key="d3">If the index percentage change computed via the given formula results in a negative value, the policyholder receives no interest credit, reflecting the protective 0% floor feature.</data>
  <data key="d4">causes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
