</edge>
<edge source="eec22563-c8f9-4930-abc2-6252103b7b77" target="9dcea0cf-204b-429a-93cc-c257133b7890">
  <data key="d3">The Floor Rate ensures no loss on investment growth, providing downside protection, which complements the financial implications of early surrender charges such as the 9% fee in Year 2.</data>
  <data key="d4">complements</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
