  <data key="d3">The Participation Rate of 100% indicates full exposure to index gains, which interacts with the Cap Rate to determine actual credited interest when gains exceed zero.</data>
  <data key="d4">influences</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
