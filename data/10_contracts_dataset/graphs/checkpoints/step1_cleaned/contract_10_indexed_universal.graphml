  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="e5a57ea1-57cc-4798-ad39-f4958d3b0156">
  <data key="d2">fact_entity</data>
  <data key="d4">amount</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="b35bf046-d0c4-4809-8d8a-ea63bce693ac">
  <data key="d2">fact_entity</data>
  <data key="d4">amount</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="2b6c6d48-3e26-4f83-bb3b-82794efaa2aa">
  <data key="d2">fact_entity</data>
  <data key="d4">amount</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="621286da-2504-4f73-9a6f-3bf829245f83">
  <data key="d2">fact_entity</data>
  <data key="d4">percentage</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="a4d5e668-4c9a-470a-be26-7d692372ccd9">
  <data key="d2">fact_entity</data>
  <data key="d4">charge</data>
</edge>
<edge source="0d7fabe2-d74d-4b84-a620-42c9acb1c43d" target="0f8d859f-a7b7-4e92-971f-a7d5e30e44a4">
  <data key="d2">fact_entity</data>
  <data key="d4">charge</data>
</edge>
