<edge source="59735a62-be54-4b86-a006-cd569871d4ef" target="628900ad-3981-4384-be18-2669a41ba276">
  <data key="d3">For the No Lapse Guarantee Rider to remain effective, the policyholder must maintain minimum guaranteed premiums, even though it was not selected in this case.</data>
  <data key="d4">depends on premiums</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="59735a62-be54-4b86-a006-cd569871d4ef" target="c9695180-7458-48f9-8686-914a2e999aa0">
  <data key="d3">To keep the No Lapse Guarantee Rider effective, policyholders must pay minimum guaranteed premiums, ensuring coverage does not lapse even when the account value hits zero.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="59735a62-be54-4b86-a006-cd569871d4ef" target="fed316a6-229f-46af-91a9-72511967565a">
  <data key="d3">If the No Lapse Guarantee Rider is inactive due to missed premium payments, it may lead to policy lapse, causing the loss of any remaining surrender value.</data>
  <data key="d4">prevents lapse</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="bc16555a-e9c3-46b1-b17c-cfa79137259c" target="59735a62-be54-4b86-a006-cd569871d4ef">
