  <data key="d3">A 0% Floor prevents any loss from negative performance, complementing the 100% Participation Rate, which allows full benefit from positive movements in the NASDAQ-100 index.</data>
  <data key="d4">complements</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
