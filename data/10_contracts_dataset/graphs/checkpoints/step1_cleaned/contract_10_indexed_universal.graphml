  <data key="d2">entity_fact</data>
  <data key="d4">defines the timeframe within which policy remains active despite non payment, supporting continuity into year 12+</data>
</edge>
<edge source="f8e786e1-6fa7-4d03-8412-a87392bffd21" target="8581e6b9-7fac-4b65-a5c3-f8bf614bbe73">
  <data key="d2">entity_fact</data>
  <data key="d4">provides temporary coverage allowing policyholder to maintain benefits until renewal payment is made, contributing to sustained policy status past year 12</data>
</edge>
