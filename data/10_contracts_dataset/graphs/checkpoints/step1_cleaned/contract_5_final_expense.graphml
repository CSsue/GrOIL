"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anchors":["face amount"]},{"name":"May 1, 2025","type":"DATE","role":"start date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"April 30, 2026","type":"DATE","role":"end date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"May 1, 2026","type":"DATE","role":"effective date of full benefit eligibility","relational_anchors":["after Year 2 (on or after May 1, 2026)"]},{"name":"$87.50","type":"AMOUNT","role":"fixed monthly premium amount","relational_anchors":["monthly premium"]},{"name":"automatic deduction","type":"MECHANISM","role":"method of premium collection","relational_anchors":["bank account","1st of each month"]}]},{"name":"Year 1 Payout Terms","sentence":"If death occurs during Year 1 (before May 1, 2025), the payout includes all premiums paid.","macro_topics":[],"chunk_topics":["graded death benefit","year 1 payout","premimum reimbursement"],"entities":[{"name":"whole life insurance policy","type":"POLICY","role":"provides burial expense coverage","relational_anchors":[]},{"name":"graded death benefit","type":"CONCEPT","role":"determines payout percentage over time","relational_anchors":["Year 1 (before May 1, 2025)","Year 2 (May 1, 2025 - April 30, 2026)","after Year 2 (on or after May 1, 2026)"]},{"name":"$3,000","type":"AMOUNT","role":"partial death benefit during first year","relational_anchors":["30% of face amount"]},{"name":"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anchors":["face amount"]},{"name":"May 1, 2025","type":"DATE","role":"start date of second-year benefit tier","