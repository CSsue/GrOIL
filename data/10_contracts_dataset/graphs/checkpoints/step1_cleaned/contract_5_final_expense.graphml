    <edge source="95682703-5aa3-4502-9d77-774a9d121b12" target="07cbca12-0349-48ac-8e69-1106566c8841">
      <data key="d3">The policy’s primary function is to provide funds for funeral and final expenses, and its $10,000 face amount represents the total sum available to fulfill that purpose.</data>
      <data key="d4">corroborates</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
