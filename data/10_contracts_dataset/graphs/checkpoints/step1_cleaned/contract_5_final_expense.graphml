      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="63aa8cb9-583b-4b5a-8fe0-2626eeaf7628" target="23ea9eda-ab01-439d-8c9f-2e04c0f63d59">
      <data key="d3">The promise of timely claim settlement within five business days applies only when a claim is filed properly. However, if premium payments lapse beyond two years, the policy’s benefit amount decreases regardless of claim processing speed.</data>
      <data key="d4">modifies</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
    <edge source="63aa8cb9-583b-4b5a-8fe0-2626eeaf7628" target="bbe3a5e7-9762-4606-beaf-78b057d4a71f">
      <data key="d3">Claim payments occur within five business days, contingent on the validity of the claim. The amount paid may reflect a reduced benefit derived from the policy’s accumulated cash value.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
