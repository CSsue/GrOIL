    <node id="102eb501-05a0-4d84-bdbf-d69d3155652a">
      <data key="d0">{"name":"Simplified Whole Life Coverage","text":"━━━━━━━━━━━━━━━━\n1. WHAT THIS POLICY PROVIDES\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nThis is a simplified issue whole life insurance policy designed \nto help cover funeral and final expenses. There are no medical \nexams or health questions required.\n\nYour premium will never increase as long as you keep paying it.\nYour coverage will never decrease.\nThis policy builds a small cash value over time.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n2. GRADED DEATH BENEFIT\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nIMPORTANT: There is a waiting period for full benefits.\n\nIF DEATH OCCURS:\n\nDuring Year 1 (before May 1, 2025):\n  We pay 30% of face amount ($3,000) plus all premiums paid\n\nDuring Year 2 (May 1, 2025 - April 30, 2026):\n  We pay 70% of face amount ($7,000) plus all premiums paid\n\nAfter Year 2 (on or after May 1, 2026):\n  We pay the full benefit amount ($10,000)\n\nEXCEPTION - ACCIDENTAL DEATH: If death results from an accident \nat any time, we pay the full benefit amount immediately, plus all \npremiums paid.\n\nAn accident means a sudden, unexpected event causing injury that \nresults in death within 90 days of the event.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n3. PREMIUM PAYMENTS\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n3.1 Your monthly premium is $87.50 and will never increase.\n\n3.2 Premiums are automatically deducted from your bank account \n    on the 1st of each month.\n\n3.","summary":"This simplified whole life insurance policy provides coverage for funeral and final expenses without requiring medical exams or health questions. The death benefit increases over time—30% in year one, 70% in year two, and 100% thereafter—with full payout available after May 1, 2026. Accidental deaths trigger immediate full benefit regardless of timing. Monthly premiums of $87.50 are fixed and auto-deducted.","topics":["Life Insurance","Final Expenses","Graded Death Benefit","No Medical Exam"],"facts":[{"name":"Simplified Issue Whole Life Policy","sentence":"This is a simplified issue whole life insurance policy.","macro_topics":[],"chunk_topics":["simplified issue","whole life insurance","no medical exam"],"entities":[{"name":"whole life insurance policy","type":"POLICY","role":"provides burial expense coverage","relational_anchors":[]},{"name":"graded death benefit","type":"CONCEPT","role":"determines payout percentage over time","relational_anchors":["Year 1 (before May 1, 2025)","Year 2 (May 1, 2025 - April 30, 2026)","after Year 2 (on or after May 1, 2026)"]},{"name":"$3,000","type":"AMOUNT","role":"partial death benefit during first year","relational_anchors":["30% of face amount"]},{"name":"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anchors":["face amount"]},{"name":"May 1, 2025","type":"DATE","role":"start date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"April 30, 2026","type":"DATE","role":"end date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"May 1, 2026","type":"DATE","role":"effective date of full benefit eligibility","relational_anchors":["after Year 2 (on or after May 1, 2026)"]},{"name":"$87.50","type":"AMOUNT","role":"fixed monthly premium amount","relational_anchors":["monthly premium"]},{"name":"automatic deduction","type":"MECHANISM","role":"method of premium collection","relational_anchors":["bank account","1st of each month"]}]},{"name":"Funeral Expense Coverage","sentence":"The policy is designed to help cover funeral and final expenses.","macro_topics":[],"chunk_topics":["funeral expenses","final expenses","whole life insurance"],"entities":[{"name":"whole life insurance policy","type":"POLICY","role":"provides burial expense coverage","relational_anchors":[]},{"name":"graded death benefit","type":"CONCEPT","role":"determines payout percentage over time","relational_anchors":["Year 1 (before May 1, 2025)","Year 2 (May 1, 2025 - April 30, 2026)","after Year 2 (on or after May 1, 2026)"]},{"name":"$3,000","type":"AMOUNT","role":"partial death benefit during first year","relational_anchors":["30% of face amount"]},{"name":"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anchors":["face amount"]},{"name":"May 1, 2025","type":"DATE","role":"start date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"April 30, 2026","type":"DATE","role":"end date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"May 1, 2026","type":"DATE","role":"effective date of full benefit eligibility","relational_anchors":["after Year 2 (on or after May 1, 2026)"]},{"name":"$87.50","type":"AMOUNT","role":"fixed monthly premium amount","relational_anchors":["monthly premium"]},{"name":"automatic deduction","type":"MECHANISM","role":"method of premium collection","relational_anchors":["bank account","1st of each month"]}]},{"name":"No Medical Exam Required","sentence":"No medical exams are required for this policy.","macro_topics":[],"chunk_topics":["no medical exam","policy eligibility","simplified issue"],"entities":[{"name":"whole life insurance policy","type":"POLICY","role":"provides burial expense coverage","relational_anchors":[]},{"name":"graded death benefit","type":"CONCEPT","role":"determines payout percentage over time","relational_anchors":["Year 1 (before May 1, 2025)","Year 2 (May 1, 2025 - April 30, 2026)","after Year 2 (on or after May 1, 2026)"]},{"name":"$3,000","type":"AMOUNT","role":"partial death benefit during first year","relational_anchors":["30% of face amount"]},{"name":"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anchors":["face amount"]},{"name":"May 1, 2025","type":"DATE","role":"start date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"April 30, 2026","type":"DATE","role":"end date of second-year benefit tier","relational_anchors":["Year 2 (May 1, 2025 - April 30, 2026)"]},{"name":"May 1, 2026","type":"DATE","role":"effective date of full benefit eligibility","relational_anchors":["after Year 2 (on or after May 1, 2026)"]},{"name":"$87.50","type":"AMOUNT","role":"fixed monthly premium amount","relational_anchors":["monthly premium"]},{"name":"automatic deduction","type":"MECHANISM","role":"method of premium collection","relational_anchors":["bank account","1st of each month"]}]},{"name":"No Health Questions Required","sentence":"No health questions are required for this policy.","macro_topics":[],"chunk_topics":["no health questions","simplified application","no medical exam"],"entities":[{"name":"whole life insurance policy","type":"POLICY","role":"provides burial expense coverage","relational_anchors":[]},{"name":"graded death benefit","type":"CONCEPT","role":"determines payout percentage over time","relational_anchors":["Year 1 (before May 1, 2025)","Year 2 (May 1, 2025 - April 30, 2026)","after Year 2 (on or after May 1, 2026)"]},{"name":"$3,000","type":"AMOUNT","role":"partial death benefit during first year","relational_anchors":["30% of face amount"]},{"name":"$7,000","type":"AMOUNT","role":"partial death benefit during second year","relational_anchors":["70% of face amount"]},{"name":"$10,000","type":"AMOUNT","role":"full death benefit after two years","relational_anc