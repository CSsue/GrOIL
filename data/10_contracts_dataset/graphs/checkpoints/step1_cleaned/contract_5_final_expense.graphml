    <edge source="c41bf98f-4b11-406f-b3cd-0237a67bfc05" target="ebaa75d8-001d-4086-94ab-307f45c48164">
      <data key="d3">Fact_sentence_2 sets the timeline necessary to evaluate the validity of fact_sentence_1, which only applies after two full years have passed since issuance.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="c41bf98f-4b11-406f-b3cd-0237a67bfc05" target="7b86f64d-0983-4767-96ea-5e72e39b9a89">
      <data key="d3">Fact_sentence_2 specifies the policy’s effective date, which determines when the two-year waiting period referenced in fact_sentence_1 begins. Without this date, assessing compliance with the non-cancelable provision would be impossible.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
