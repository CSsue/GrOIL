      <data key="d5">0.75</data>
    </edge>
    <edge source="d3df2cb3-d5f3-464e-bb7d-8d51ca52e9aa" target="5d80f781-df38-47eb-959b-57820fc3dcfa">
      <data key="d3">Fact_sentence_2 directs beneficiaries to send a certified death certificate by mail, which supports fact_sentence_1’s recommendation to contact customer service at 1-800-COMFORT, since proper documentation is needed regardless of the chosen method.</data>
      <data key="d4">complements</data>
