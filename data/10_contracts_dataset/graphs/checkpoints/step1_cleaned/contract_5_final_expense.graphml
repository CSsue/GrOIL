    <edge source="d8c49e46-f3e7-4910-b951-a173ce225f4b" target="936f48e0-3971-4136-b206-0582810a5f12">
      <data key="d3">The suicide exclusion limits payout eligibility under certain conditions, meaning that even if premiums are consistently paid, benefits may still be denied if death results from suicide within two years of issuance.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
