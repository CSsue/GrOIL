    <edge source="95682703-5aa3-4502-9d77-774a9d121b12" target="fdbea615-6c8b-4e16-b3c0-1e0700ab9386">
      <data key="d3">The primary goal of covering funeral and final expenses justifies why the policy was created as a simplified issue whole life product, emphasizing accessibility and ease of acquisition without underwriting hurdles.</data>
      <data key="d4">purposes</data>
      <data key="d2">fact_fact</data>
