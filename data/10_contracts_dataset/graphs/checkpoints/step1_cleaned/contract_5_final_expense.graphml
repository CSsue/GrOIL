      <data key="d5">0.92</data>
    </edge>
    <edge source="07cbca12-0349-48ac-8e69-1106566c8841" target="b545d862-f828-4173-afa0-6475ca5c91fd">
      <data key="d3">The policy has a $10,000 face amount, but accidental death claims require the event to happen within 90 days to qualify for the full benefit.</data>
      <data key="d4">conditional on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
    <edge source="07cbca12-0349-48ac-8e69-1106566c8841" target="2c2ac373-cacf-48f8-8261-4cacaba45a95">
      <data key="d3">The $10,000 face amount is subject to a graded benefit schedule due to the absence of medical underwriting, meaning full access to the face value is delayed until specific conditions are met.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
