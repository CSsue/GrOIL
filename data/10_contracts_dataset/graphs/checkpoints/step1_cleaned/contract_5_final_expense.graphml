    <edge source="21b0fd78-d6a8-4010-a875-c24ec80a3ec5" target="71633f7c-5dc5-48fa-ac41-c71eba6fc01c">
      <data key="d3">The fixed monthly premium of $87.50 establishes the baseline cost of coverage, enabling the possibility of switching to less frequent quarterly payments based on the total accumulated amount due every three months.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
