    </edge>
    <edge source="edc56e79-b2d2-4461-95b1-2ad2964fb726" target="553b7cff-2218-40d7-b664-1ae094b8052a">
      <data key="d2">entity_fact</data>
      <data key="d4">cost association</data>
    </edge>
    <edge source="bab3456d-851c-4d71-bd29-aa9b24448b3d" target="553b7cff-2218-40d7-b664-1ae094b8052a">
      <data key="d2">entity_fact</data>
      <data key="d4">payment mechanism</data>
