    <edge source="21b0fd78-d6a8-4010-a875-c24ec80a3ec5" target="33bb0f3a-ce2b-40f6-b221-f738e97e68f6">
      <data key="d3">Regular monthly premiums contribute to the policy's growth, leading to an accumulated cash value over time. The $87.50 monthly payment supports the eventual accrual of approximately $3,200 in cash value after ten years.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.92</data>
    </edge>
