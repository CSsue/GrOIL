    <node id="2075f447-c4f0-4ea7-9362-f19c4230102f">
      <data key="d0">{"name":"Guaranteed Issue Senior Policy Terms","text":"━━━━━━━━━━━━━━━━━━━━\n9.1 GUARANTEED ISSUE: This policy was issued without medical \n    questions or exams. The graded benefit schedule applies \n    because of this.\n\n9.2 AGE LIMITS: Coverage is available for ages 50-85.\n\n9.3 INCONTESTABILITY: After this policy has been in force for \n    2 years, we cannot cancel it or deny claims except for \n    non-payment of premiums.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nThis policy is issued in Tampa, Florida.\n\nFor questions, call: 1-800-COMFORT (1-800-266-3678)\n\nSigned: _____________________________\n        Chief Operating Officer\n        ComfortCare Senior Insurance\n\nDate: May 1, 2024\n\n★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★\n","summary":"This senior insurance policy is issued without medical questions or exams, resulting in a graded benefit schedule. Coverage is available for individuals aged 50–85, and after two years of continuous coverage, the insurer cannot cancel the policy or deny claims except for unpaid premiums. The policy is issued in Tampa, Florida, with customer service available via toll-free number.","topics":["Guaranteed Issue","Age Limits","Contestability Clause","Senior Insurance"],"facts":[{"name":"Guaranteed Issue Policy","sentence":"This policy was issued without medical questions.","macro_topics":[],"chunk_topics":["guaranteed issue","no medical exam","underwriting"],"entities":[{"name":"this policy","type":"POLICY","role":"issued without medical requirements","relational_anchors":[]},{"name":"without medical questions or exams","type":"CONDITION","role":"condition triggering graded benefits","relational_anchors":[]},{"name":"ages 50-85","type":"AGE_RANGE","role":"eligibility threshold for coverage","relational_anchors":[]},{"name":"2 years","type":"TIME_PERIOD","role":"incontestability period duration","relational_anchors":[]},{"name":"non-payment of premiums","type":"EXCEPTION","role":"only grounds for cancellation after 2 years","relational_anchors":[]},{"name":"Tampa, Florida","type":"LOCATION","role":"issuance jurisdiction of policy","relational_anchors":[]},{"name":"1-800-COMFORT (1-800-266-3678)","type":"CONTACT_INFORMATION","role":"customer service hotline","relational_anchors":["1-800-266-3678"]},{"name":"Chief Operating Officer","type":"PERSON","role":"authorized signer of policy","relational_anchors":[]},{"name":"ComfortCare Senior Insurance","type":"ORGANIZATION","role":"issuer of the policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"date of signature","relational_anchors":[]}]},{"name":"No Medical Exam Required","sentence":"This policy was issued without medical exams.","macro_topics":[],"chunk_topics":["no medical exam","guaranteed issue","underwriting exemption"],"entities":[{"name":"this policy","type":"POLICY","role":"issued without medical requirements","relational_anchors":[]},{"name":"without medical questions or exams","type":"CONDITION","role":"condition triggering graded benefits","relational_anchors":[]},{"name":"ages 50-85","type":"AGE_RANGE","role":"eligibility threshold for coverage","relational_anchors":[]},{"name":"2 years","type":"TIME_PERIOD","role":"incontestability period duration","relational_anchors":[]},{"name":"non-payment of premiums","type":"EXCEPTION","role":"only grounds for cancellation after 2 years","relational_anchors":[]},{"name":"Tampa, Florida","type":"LOCATION","role":"issuance jurisdiction of policy","relational_anchors":[]},{"name":"1-800-COMFORT (1-800-266-3678)","type":"CONTACT_INFORMATION","role":"customer service hotline","relational_anchors":["1-800-266-3678"]},{"name":"Chief Operating Officer","type":"PERSON","role":"authorized signer of policy","relational_anchors":[]},{"name":"ComfortCare Senior Insurance","type":"ORGANIZATION","role":"issuer of the policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"date 