    </edge>
    <edge source="6f5e1101-0f4f-4e81-8e61-d356e62a3dc6" target="52aa3801-6bd5-4429-9b25-701f021b5d8a">
      <data key="d3">Fact sentence 1 affirms the absence of medical questions in issuance, consistent with chunk summary 2’s emphasis on no-exam underwriting and graded benefits. This supports alignment between the factual statement and broader policy design described in the second chunk.</data>
      <data key="d4">corroborates</data>
      <data key="d2">fact_fact</data>
      <data key="d5">1.0</data>
    </edge>
