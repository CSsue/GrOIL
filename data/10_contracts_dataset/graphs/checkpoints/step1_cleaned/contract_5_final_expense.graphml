    <node id="d2d00509-6e88-47a6-b685-24626e5d043f">
      <data key="d0">{"name":"Final Expense Policy Details","text":"★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★\n                    FINAL EXPENSE LIFE INSURANCE\n                    ComfortCare Senior Insurance\n★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★★\n\nPolicy #: CC-FE-2024-9903\nEffective: May 1, 2024\nType: Guaranteed Issue Whole Life\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nINSURED PERSON\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nName: Dorothy Mae Johnson\nBirth Date: June 12, 1951\nAge: 72 years\nGender: Female\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nCOVERAGE INFORMATION\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nBenefit Amount: $10,000\nMonthly Premium: $87.50 (guaranteed level for life)\nPayment Method: Bank draft on 1st of each month\nPremium Payer: Dorothy Mae Johnson\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nBENEFICIARY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPrimary: Linda Sue Johnson (Daughter) - 100%\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n1. WHAT THIS POLICY PROVIDES\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━","summary":"This is a guaranteed issue whole life insurance policy for Dorothy Mae Johnson, age 72, offering a $10,000 death benefit with a fixed monthly premium of $87.50. No medical exam is required, and premiums remain level for life. Her daughter, Linda Sue Johnson, is designated as the sole primary beneficiary. The policy became effective on May 1, 2024.","topics":["Final Expense Insurance","Guaranteed Issue Life","Senior Financial Planning","Life Insurance Beneficiary"],"facts":[{"name":"Policy Identification Number","sentence":"Policy number is CC-FE-2024-9903.","macro_topics":[],"chunk_topics":["policy number","insurance identification","coverage details"],"entities":[{"name":"Dorothy Mae Johnson","type":"PERSON","role":"insured person under policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"effective start date of policy","relational_anchors":["Policy #: CC-FE-2024-9903"]},{"name":"CC-FE-2024-9903","type":"POLICY","role":"unique identifier for guaranteed issue whole life policy","relational_anchors":["Guaranteed Issue Whole Life","Effective: May 1, 2024"]},{"name":"$10,000","type":"AMOUNT","role":"death benefit payout amount","relational_anchors":["Benefit Amount: $10,000"]},{"name":"$87.50","type":"AMOUNT","role":"monthly premium cost","relational_anchors":["Monthly Premium: $87.50","Bank draft on 1st of each month"]},{"name":"Linda Sue Johnson","type":"PERSON","role":"primary beneficiary receiving full death benefit","relational_anchors":["Daughter"]},{"name":"ComfortCare Senior Insurance","type":"ORGANIZATION","role":"issuing insurer of final expense life policy","relational_anchors":["Final Expense Life Insurance","Policy #: CC-FE-2024-9903"]}]},{"name":"Effective Policy Start Date","sentence":"The effective date of the policy is May 1, 2024.","macro_topics":[],"chunk_topics":["policy effective date","coverage initiation","May 1, 2024"],"entities":[{"name":"Dorothy Mae Johnson","type":"PERSON","role":"insured person under policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"effective start date of policy","relational_anchors":["Policy #: CC-FE-2024-9903"]},{"name":"CC-FE-2024-9903","type":"POLICY","role":"unique identifier for guaranteed issue whole life policy","relational_anchors":["Guaranteed Issue Whole Life","Effective: May 1, 2024"]},{"name":"$10,000","type":"AMOUNT","role":"death benefit payout amount","relational_anchors":["Benefit Amount: $10,000"]},{"name":"$87.50","type":"AMOUNT","role":"monthly premium cost","relational_anchors":["Monthly Premium: $87.50","Bank draft on 1st of each month"]},{"name":"Linda Sue Johnson","type":"PERSON","role":"primary beneficiary receiving full death benefit","relational_anchors":["Daughter"]},{"name":"ComfortCare Senior Insurance","type":"ORGANIZATION","role":"issuing insurer of final expense life policy","relational_anchors":["Final Expense Life Insurance","Policy #: CC-FE-2024-9903"]}]},{"name":"Guaranteed Issue Whole Life","sentence":"The type of policy is guaranteed issue whole life.","macro_topics":[],"chunk_topics":["guaranteed issue","whole life insurance","permanent coverage"],"entities":[{"name":"Dorothy Mae Johnson","type":"PERSON","role":"insured person under policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"effective start date of policy","relational_anchors":["Policy #: CC-FE-2024-9903"]},{"name":"CC-FE-2024-9903","type":"POLICY","role":"unique identifier for guaranteed issue whole life policy","relational_anchors":["Guaranteed Issue Whole Life","Effective: May 1, 2024"]},{"name":"$10,000","type":"AMOUNT","role":"death benefit payout amount","relational_anchors":["Benefit Amount: $10,000"]},{"name":"$87.50","type":"AMOUNT","role":"monthly premium cost","relational_anchors":["Monthly Premium: $87.50","Bank draft on 1st of each month"]},{"name":"Linda Sue Johnson","type":"PERSON","role":"primary beneficiary receiving full death benefit","relational_anchors":["Daughter"]},{"name":"ComfortCare Senior Insurance","type":"ORGANIZATION","role":"issuing insurer of final expense life policy","relational_anchors":["Final Expense Life Insurance","Policy #: CC-FE-2024-9903"]}]},{"name":"Insured Person Name","sentence":"The insured person's name is Dorothy Mae Johnson.","macro_topics":[],"chunk_topics":["Insured Person","Policyholder Identity","Personal Information"],"entities":[{"name":"Dorothy Mae Johnson","type":"PERSON","role":"insured person under policy","relational_anchors":[]},{"name":"May 1, 2024","type":"DATE","role":"effective start date of policy","relational_anchors":["Policy #: CC-FE-2024-9903"]},{"name":"CC-FE-2024-9903","type":"POLICY","role":"unique identifier for 