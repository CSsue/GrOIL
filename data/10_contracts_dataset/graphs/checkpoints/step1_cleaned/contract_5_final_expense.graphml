      <data key="d2">fact_entity</data>
      <data key="d4">document</data>
    </edge>
    <edge source="12f1e363-6499-41cd-a6c7-5fcd25bfbdae" target="4d91d54d-fa36-4056-822c-cd4e0d00c4e6">
      <data key="d2">fact_entity</data>
