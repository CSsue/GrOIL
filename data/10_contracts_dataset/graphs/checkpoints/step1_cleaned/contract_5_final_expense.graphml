    <node id="a5404e65-0150-42c2-8317-1f8409dd6338">
      <data key="d0">{"name":"Life Insurance Policy Guidelines","text":"━━━━━━━━━━━━━━\nThe beneficiary should call us at 1-800-COMFORT or send:\n  • Death certificate (certified copy)\n  • Completed claim form\n  • This policy (if available)\n\nMail to: ComfortCare Claims, P.O. Box 777, Tampa, FL 33601\n\nWe will pay valid claims within 5 business days.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n7. YOUR RIGHTS\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n7.1 30-DAY FREE LOOK: You can cancel within 30 days of receiving \n    this policy for a full refund.\n\n7.2 CHANGE BENEFICIARY: You can change your beneficiary at any \n    time by calling us or sending a written request.\n\n7.3 PORTABILITY: You own this policy. It stays with you even if \n    you move to another state.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n8. IF YOU STOP PAYING\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n8.1 After 2 years, if you stop paying premiums, your policy will \n    automatically continue with a reduced benefit amount based on \n    the cash value. No further premiums needed.\n\n8.2 Or you can take the cash value and cancel the policy.\n\n8.3 You may restart your policy within 2 years by paying missed \n    premiums with interest.\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n9. IMPORTANT INFORMATION\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n9.1 GUARANTEED ISSUE: This policy was issued without medical \n    questions or exams. The graded benefit schedule applies \n    because of this.\n\n9.2 AGE LIMITS:","summary":"This document provides instructions for filing a claim, detailing required documents and mailing address, along with processing timelines. It outlines three key policyholder rights: a 30-day free look period, ability to change beneficiaries anytime, and policy portability across states. If premiums cease after two years, the policy continues with reduced benefits using accumulated cash value, or the cash value can be taken; reinstatement is possible within two years. The policy is guaranteed issue—no medical exam—but includes a graded benefit due to lack of underwriting.","topics":["Claims Process","Policy Rights","Premium Payments","Guaranteed Issue"],"facts":[{"name":"Beneficiary Contact Information","sentence":"The beneficiary should call ComfortCare at 1-800-COMFORT.","macro_topics":[],"chunk_topics":["claim process","contact information","beneficiary instructions"],"entities":[{"name":"ComfortCare Claims","type":"ORGANIZATION","role":"recipient of claim submissions","relational_anchors":["P.O. Box 777"]},{"name":"1-800-COMFORT","type":"CONTACT_INFO","role":"primary customer service hotline","relational_anchors":[]},{"name":"Death certificate (certified copy)","type":"DOCUMENT","role":"required proof of death","relational_anchors":[]},{"name":"Completed claim form","type":"DOCUMENT","role":"formal submission for benefits processing","relational_anchors":[]},{"name":"This policy","type":"POLICY","role":"document required for claim validation","relational_anchors":[]},{"name":"Tampa, FL 33601","type":"LOCATION","role":"mailing address destination","relational_anchors":["P.O. Box 777"]},{"name":"5 business days","type":"TIME_PERIOD","role":"processing timeframe for valid claims","relational_anchors":[]},{"name":"30-Day Free Look","type":"RIGHT","role":"cancellation right with full refund","relational_anchors":["30 days"]},{"name":"Change beneficiary","type":"ACTION","role":"beneficiary modification procedure","relational_anchors":[]},{"name":"Portability","type":"CONCEPT","role":"policy transfer across states","relational_anchors":[]},{"name":"After 2 years","type":"CONDITION","role":"time threshold for automatic continuation","relational_anchors":["2 years"]},{"name":"Missed premiums with interest","type":"PAYMENT_TERM","role":"condition for reinstating lapsed policy","relational_anchors":["within 2 years"]},{"name":"Graded benefit schedule","type":"BENEFIT_STRUCTURE","role":"reduced payout due to guaranteed issue","relational_anchors":["Guaranteed Issue"]}]},{"name":"Beneficiary Claim Documentation","sentence":"The beneficiary should mail a death certificate (certified copy) to ComfortCare Claims.","macro_topics":[],"chunk_topics":["death certificate","claim submission","mailing requirements"],"entities":[{"name":"ComfortCare Claims","type":"ORGANIZATION","role":"recipient of claim submissions","relational_anchors":["P.O. Box 777"]},{"name":"1-800-COMFORT","type":"CONTACT_INFO","role":"primary customer service hotline","relational_anchors":[]},{"name":"Death certificate (certified copy)","type":"DOCUMENT","role":"required proof of death","relational_anchors":[]},{"name":"Completed claim form","type":"DOCUMENT","role":"formal submission for benefits processing","relational_anchors":[]},{"name":"This policy","type":"POLICY","role":"document required for claim validation","relational_anchors":[]},{"name":"Tampa, FL 33601","type":"LOCATION","role":"mailing address destination","relational_anchors":["P.O. Box 777"]},{"name":"5 business days","type":"TIME_PERIOD","role":"processing timeframe for valid claims","relational_anchors":[]},{"name":"30-Day Free Look","type":"RIGHT","role":"cancellation right with full refund","relational_anchors":["30 days"]},{"name":"Change beneficiary","type":"ACTION","role":"beneficiary modification procedure","relational_anchors":[]},{"name":"Portability","type":"CONCEPT","role":"policy transfer across states","relational_anchors":[]},{"name":"After 2 years","type":"CONDITION","role":"time threshold for automatic continuation","relational_anchors":["2 years"]},{"name":"Missed premiums with interest","type":"PAYMENT_TERM","role":"condition for reinstating lapsed policy","relational_anchors":["within 2 years"]},{"name":"Graded benefit schedule","type":"BENEFIT_STRUCTURE","role":"reduced payout due to guaranteed issue","relatio