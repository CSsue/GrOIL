      <data key="d3">The guarantee of a constant premium supports consistent payment behavior, making the retry mechanism on the 15th more effective in maintaining coverage without unexpected costs.</data>
      <data key="d4">strengthens</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="c010d3b9-4e44-4905-87bb-9b9c8f2843d6" target="936f48e0-3971-4136-b206-0582810a5f12">
