    <edge source="91b85462-1151-4d24-8a71-6adf0d18e83a" target="178f1ff5-b810-4b49-ac2e-26311d446d64">
      <data key="d3">The existence of a defined death benefit enables the calculation of premiums under conversion options, making it foundational to determining costs in upgraded policies.</data>
      <data key="d4">influences</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
