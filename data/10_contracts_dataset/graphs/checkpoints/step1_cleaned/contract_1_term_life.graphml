      <data key="d3">Failure to pay within the grace period ends coverage, thereby eliminating any possibility of future actions like conversion that require active policy status.</data>
      <data key="d4">conditions conversion</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
    <edge source="74f91656-5a40-43ff-9624-5be0747c6603" target="65760e57-7d92-40e5-bf11-d6031579bc4b">
      <data key="d3">Failure to pay within the grace period ends coverage, making future conversions impossible unless reinstated. This condition affects whether the insured can access conversion rights tied to current policy status.</data>
      <data key="d4">conditions conversion</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
