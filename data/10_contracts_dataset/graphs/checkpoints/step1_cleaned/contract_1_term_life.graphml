      <data key="d3">The policy's anniversary dates are calculated using the issue date, meaning every Policy Anniversary occurs exactly one year after January 15, 2024, forming an ongoing yearly reference point tied to the initial issuance.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
