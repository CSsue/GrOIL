      <data key="d3">The requirement for monthly automatic deductions reflects the ongoing financial commitment expected from the policy owner, John Michael Anderson, whose role is central to sustaining the policy's validity.</data>
      <data key="d4">enables coverage</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
