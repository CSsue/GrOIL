      <data key="d3">The death benefit is payable when the insured dies while the policy is active, and it is generally distributed as a lump sum unless the beneficiary opts for another method.</data>
      <data key="d4">conditional on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
