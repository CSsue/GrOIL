      <data key="d3">The $500,000 death benefit is a core financial provision established at issuance, making its applicability contingent on the policy being active since the issue date.</data>
      <data key="d4">defined by</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
