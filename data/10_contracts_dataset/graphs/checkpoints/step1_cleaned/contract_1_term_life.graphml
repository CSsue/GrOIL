      <data key="d3">The $45 monthly premium is scheduled to be paid on the 15th of each month, meaning the due date determines when the payment becomes required.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
