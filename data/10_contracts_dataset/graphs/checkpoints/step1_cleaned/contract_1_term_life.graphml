    <edge source="6a2ec98a-aa86-4cd5-8e76-1036cf6ac3da" target="74f91656-5a40-43ff-9624-5be0747c6603">
      <data key="d3">The death benefit being paid as a lump sum assumes the policy was active at the time of death; however, if coverage terminated due to non-payment beyond the grace period, this payout condition does not apply.</data>
      <data key="d4">prevents payout</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
