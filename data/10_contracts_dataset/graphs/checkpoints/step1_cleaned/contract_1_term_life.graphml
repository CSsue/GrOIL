mited to a refund of premiums paid.","macro_topics":[],"chunk_topics":["suicide clause","two-year exclusion","premium refund"],"entities":[{"name":"grace period","type":"CONCEPT","role":"period allowing late premium payment","relational_anchors":["31 days"]},{"name":"the 15th of each month","type":"DATE","role":"monthly premium due date","relational_anchors":[]},{"name":"Policy Anniversary","type":"POLICY_TERM","role":"annual renewal reference point","relational_anchors":["same day and month as the issue date"]},{"name":"death benefit","type":"CONCEPT","role":"lump-sum payout upon qualifying death","relational_anchors":["paid in one lump sum"]},{"name":"suicide clause","type":"CONCEPT","role":"limitation on insurer liability after suicide","relational_anchors":["within two years from the issue date"]},{"name":"conversion privilege","type":"CONCEPT","role":"right to switch to permanent policy","relational_anchors":["without evidence of insurability"]},{"name":"policy expiry date","type":"DATE","role":"deadline for policy continuation","relational_anchors":[]},{"name":"insured's 65th birthday","type":"DATE","role":"age limit for conversion eligibility","relational_anchors":[]}]},{"name":"No Additional Exclusions","sentence":"No other exclusions apply to this policy.","macro_topics":[],"chunk_topics":["exclusions","policy terms","suicide clause"],"entities":[{"name":"grace period","type":"CONCEPT","role":"period allowing late premium payment","relational_anchors":["31 days"]},{"name":"the 15th of each month","type":"DATE","role":"monthly premium due date","relational_anchors":[]},{"name":"Policy Anniversary","type":"POLICY_TERM","role":"annual renewal reference point","relational_anchors":["same day and month as the issue date"]},{"name":"death benefit","type":"CONCEPT","role":"lump-sum payout upon qualifying death","relational_anchors":["paid in one lump sum"]},{"name":"suicide clause","type":"CONCEPT","role":"limitation on insurer liability after suicide","relational