    <edge source="6946e734-a717-40f6-a7c6-8217055992b2" target="ef3425a0-1e50-49ab-b5a8-ef77f6ab44bc">
      <data key="d3">The insured’s sex at the time of misstatement directly governs the adjusted death benefit, ensuring accuracy in compensation relative to premium payments made.</data>
      <data key="d4">informs</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="6946e734-a717-40f6-a7c6-8217055992b2" target="7d8ac6d1-e47e-4ba7-b0a0-e181d124cf19">
      <data key="d3">The corrected death benefit is influenced by the insured's sex at the time of misstatement, just as it is affected by their age during the same period. These two factors operate concurrently in determining the final payout.</data>
      <data key="d4">equally relevant</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="a20203d6-ca83-4403-b5c2-92eb33db3555" target="6946e734-a717-40f6-a7c6-8217055992b2">
      <data key="d2">entity_fact</data>
      <data key="d4">applies misstatement provision based on insured's sex</data>
    </edge>
