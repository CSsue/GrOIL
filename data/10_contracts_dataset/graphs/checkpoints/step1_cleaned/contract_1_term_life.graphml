    <edge source="48cefe40-498d-4ea8-8c59-1a68bc65d395" target="ef3425a0-1e50-49ab-b5a8-ef77f6ab44bc">
      <data key="d3">The two-year incontestability clause ensures that once the policy has been active for two years, the insurer cannot dispute its terms, including those related to misstatements like gender. This allows for fair application of benefit adjustments when such errors are discovered later.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
