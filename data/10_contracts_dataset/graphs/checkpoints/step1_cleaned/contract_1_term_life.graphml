      <data key="d3">The $45 monthly premium triggers the start of the 31-day grace period when unpaid beyond the due date, ensuring continuous coverage despite late payments.</data>
      <data key="d4">enables</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
