      <data key="d3">Fact_sentence_1 defines the grace period's duration and effect; fact_sentence_2 explains its practical implication—continued coverage post-due date—which directly supports and clarifies the definition provided earlier.</data>
      <data key="d4">corroborates</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.98</data>
    </edge>
