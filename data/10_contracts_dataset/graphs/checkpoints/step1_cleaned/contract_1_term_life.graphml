    <edge source="f99df0d3-695f-4ae7-a1f8-eaf509b3c369" target="3a44a24c-6929-4eb5-a725-c52e8fe754a5">
      <data key="d2">fact_entity</data>
      <data key="d4">person</data>
    </edge>
    <edge source="f99df0d3-695f-4ae7-a1f8-eaf509b3c369" target="c6057ef8-9677-4f9d-ab7f-a823fda13239">
      <data key="d2">fact_entity</data>
