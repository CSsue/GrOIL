    </edge>
    <edge source="cd33eeaf-204c-4c25-b6c4-d8f541f0238a" target="cb928733-e199-4fdb-837b-0be5aae920be">
      <data key="d3">The death benefit described in fact_sentence_1 depends on the policy remaining in force, which is influenced by the successful conversion to a permanent policy; thus, the class of permanent policy selected determines whether continued coverage—and hence future death benefit eligibility—is maintained.</data>
      <data key="d4">depends on</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
