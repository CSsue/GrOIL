    <edge source="74f91656-5a40-43ff-9624-5be0747c6603" target="929683b0-a1d7-47e6-974e-1af143ca05b4">
      <data key="d3">The continuation of coverage during the grace period ensures policyholders have time to make late payments without losing protection. This temporary extension supports the condition stated in fact_sentence_1 about termination occurring only after the grace period ends.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
