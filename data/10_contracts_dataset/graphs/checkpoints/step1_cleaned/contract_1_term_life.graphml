    </edge>
    <edge source="58227a0c-85bd-4ca0-9fe2-c849ab8cd359" target="9bd83bcc-7ea7-4a63-aaa4-02253aecdc97">
      <data key="d3">Since the insurer disclaims responsibility for assignment validity, it limits the enforceability or protection associated with the policyholder’s action of assignment.</data>
      <data key="d4">limits</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="58227a0c-85bd-4ca0-9fe2-c849ab8cd359" target="173ed3d5-0eb1-4ff3-a7bb-5ccb01ff26f9">
      <data key="d3">Fact_sentence_1 establishes that SecureLife does not guarantee the validity of assignments, setting the stage for why explicit confirmation via written notice is required. Fact_sentence_2 clarifies that actual legal effect occurs only upon official receipt of such notice.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="2644f84f-ac9e-4239-8852-0b03978f8563" target="58227a0c-85bd-4ca0-9fe2-c849ab8cd359">
      <data key="d2">entity_fact</data>
      <data key="d4">has liability limitation on assignment</data>
    </edge>
