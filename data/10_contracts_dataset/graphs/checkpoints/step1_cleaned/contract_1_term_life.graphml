    <edge source="91b85462-1151-4d24-8a71-6adf0d18e83a" target="101a86f6-cba5-43af-ae57-a5d5f17d8c1d">
      <data key="d3">Conversion to permanent insurance depends on maintaining active status through timely payments or use of the grace period, so the existence of the 31-day grace period enables eligibility for conversion under favorable conditions.</data>
      <data key="d4">required for conversion</data>
      <data key="d2">fact_fact</data>
