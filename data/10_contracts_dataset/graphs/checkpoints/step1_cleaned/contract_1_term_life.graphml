      <data key="d3">Monthly automatic deductions ensure continued validity of the policy covering John Michael Anderson, linking payment behavior directly to his status as the insured.</data>
      <data key="d4">applies to</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="c213cb6d-bc43-42c0-9cc8-b53860ab254b" target="b9bffd3e-9339-46c9-88e5-c86723b048a8">
      <data key="d3">Monthly automatic deductions are scheduled to continue for the full 20-year term, aligning the payment frequency with the policy’s duration.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
