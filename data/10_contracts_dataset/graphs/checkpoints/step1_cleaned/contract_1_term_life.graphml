]},{"name":"insured's 65th birthday","type":"DATE","role":"age limit for conversion eligibility","relational_anchors":[]}]},{"name":"Proof of Death Requirement","sentence":"Proof of death acceptable to us must be received in order for the death benefit to be paid.","macro_topics":[],"chunk_topics":["death benefit","proof of death","claim processing"],"entities":[{"name":"grace period","type":"CONCEPT","role":"period allowing late premium payment","relational_anchors":["31 days"]},{"name":"the 15th of each month","type":"DATE","role":"monthly premium due date","relational_anchors":[]},{"name":"Policy Anniversary","type":"POLICY_TERM","role":"annual renewal reference point","relational_anchors":["same day and month as the issue date"]},{"name":"death benefit","type":"CONCEPT","role":"lump-sum payout upon qualifying death","relational_anchors":["paid in one lump sum"]},{"name":"suicide clause","type":"CONCEPT","role":"limitation on insurer liability after suicide","relational_anchors":["within two years from the issue date"]},{"name":"conversion privilege","type":"CONCEPT","role":"right to switch to permanent policy","relational_anchors":["without evidence of insurability"]},{"name":"policy expiry date","type":"DATE","role":"deadline for policy continuation","relational_anchors":[]},{"name":"insured's 65th birthday","type":"DATE","role":"age limit for conversion eligibility","relational_anchors":[]}]},{"name":"Death Benefit Timing Condition","sentence":"The death benefit will only be paid if the death occurs before the policy expiry date.","macro_topics":[],"chunk_topics":["death benefit","policy expiry date","claim eligibility"],"entities":[{"name":"grace period","type":"CONCEPT","role":"period allowing late premium payment","relational_anchors":["31 days"]},{"name":"the 15th of each month","type":"DATE","role":"monthly premium due date","relational_anchors":[]},{"name":"Policy Anniversary","type":"POLICY_TERM","role":"annual renewal reference point","relational_ancho