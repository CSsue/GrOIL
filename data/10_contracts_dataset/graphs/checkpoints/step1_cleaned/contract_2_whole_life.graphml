      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="23c1dfbe-c779-47ed-b0fc-14e97169d328" target="f37a3a24-478b-4b88-9d7c-dc9e58cdd764">
      <data key="d2">fact_entity</data>
