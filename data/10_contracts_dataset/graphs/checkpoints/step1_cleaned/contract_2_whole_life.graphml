    <edge source="2798b517-d05d-4a9e-a451-d86e9388a002" target="82aeed9b-92d1-465a-b1fa-fc66540d9d53">
      <data key="d3">A face amount of $250,000 indicates the payout upon death, consistent with a participating whole life policy designed to provide long-term protection and accumulate cash value over time.</data>
      <data key="d4">has value</data>
      <data key="d2">fact_fact</data>
