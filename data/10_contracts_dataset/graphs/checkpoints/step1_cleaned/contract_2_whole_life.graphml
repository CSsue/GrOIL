    <edge source="8b98c6ac-7eb3-4170-b9c4-eba31a5b67b4" target="3d25ba87-2580-4e37-9150-1cbfd6d8ba08">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="8b98c6ac-7eb3-4170-b9c4-eba31a5b67b4" target="1b5ae39d-9d3e-4e1e-8406-920583f2de15">
      <data key="d2">fact_entity</data>
