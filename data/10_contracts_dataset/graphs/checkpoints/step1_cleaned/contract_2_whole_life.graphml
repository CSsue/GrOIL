    <edge source="4efbedc6-1cfd-4358-ac83-80bd56506e46" target="5ea73efa-2572-4665-a567-0bc08cfeff08">
      <data key="d3">The death benefit is determined based on the face amount and other factors, and once confirmed, it is payable within seven days upon submission of complete documents.</data>
      <data key="d4">precedes</data>
      <data key="d2">fact_fact</data>
