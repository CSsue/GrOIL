    <edge source="8b98c6ac-7eb3-4170-b9c4-eba31a5b67b4" target="fe4e1e06-1d99-45d8-83a1-f2eb93469b4a">
      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
