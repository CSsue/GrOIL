      <data key="d2">fact_entity</data>
      <data key="d4">concept</data>
    </edge>
    <edge source="f0d953de-57de-4009-9c3c-a624848400bc" target="478b32ea-8cad-4b48-af65-0a4909d93fb0">
      <data key="d2">fact_entity</data>
      <data key="d4">rate</data>
    </edge>
    <edge source="f0d953de-57de-4009-9c3c-a624848400bc" target="78b74ff1-ef09-4031-8655-70967e665272">
      <data key="d2">fact_entity</data>
      <data key="d4">period</data>
