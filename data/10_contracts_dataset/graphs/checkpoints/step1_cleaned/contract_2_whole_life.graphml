    <edge source="982dcffc-8963-4a09-a00a-3a7afc345757" target="44d166e8-5546-4afd-be9d-b8fb4e61a5df">
      <data key="d3">Fact_sentence_2 establishes the 90% lending limit tied to cash surrender value, which directly applies to the type of loan mentioned in fact_sentence_1, thereby defining its practical scope within the policy’s terms.</data>
