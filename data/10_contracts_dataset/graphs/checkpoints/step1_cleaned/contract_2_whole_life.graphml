    <edge source="676d3ef5-d991-4b39-a33e-ea3ec7cfb545" target="528ac7df-43ef-4675-962b-37d25d763e12">
      <data key="d3">Failure to repay a loan within 31 days results in policy termination, especially when compounded interest has grown the debt significantly, making recovery more difficult.</data>
      <data key="d4">triggers consequence</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
    </edge>
    <edge source="676d3ef5-d991-4b39-a33e-ea3ec7cfb545" target="9385aac2-9570-4e2e-8922-87d7cad0451d">
      <data key="d3">The policy ends if insufficient funds are repaid within 31 days after being notified about exceeding the cash value limit due to debt.</data>
      <data key="d4">prevents termination</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
    <edge source="676d3ef5-d991-4b39-a33e-ea3ec7cfb545" target="d5989a8e-5059-4901-af97-50fb73edccc0">
      <data key="d3">Failure to pay off the loan within 31 days results in policy termination, meaning any accumulated interest would remain unpaid and contribute to the loss of coverage and benefits.</data>
      <data key="d4">prevents</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.65</data>
    </edge>
    <edge source="62d8e88c-094b-49e2-a40a-d85302d3bdde" target="676d3ef5-d991-4b39-a33e-ea3ec7cfb545">
      <data key="d2">entity_fact</data>
      <data key="d4">is subject to termination if insufficient payment is made</data>
    </edge>
