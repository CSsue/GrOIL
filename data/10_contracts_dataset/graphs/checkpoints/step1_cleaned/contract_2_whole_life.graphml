    <node id="930459e7-ba57-4326-a720-8ecfefd0d16e">
      <data key="d0">{"name":"Free Look &amp; Contestability Terms","text":"─────────────────────\n12. FREE LOOK PERIOD\n─────────────────────────────────────────────────────────────────────\nYou may cancel this policy within 30 days of receipt for a full \nrefund of premiums paid.\n\n─────────────────────────────────────────────────────────────────────\n13. CONTESTABILITY\n─────────────────────────────────────────────────────────────────────\nWe may contest this policy only within the first two years while \nthe insured is living, and only for material misrepresentation in \nthe application.\n\n╔═══════════════════════════════════════════════════════════════════╗\n║  GUARDIAN FAMILY PROTECTION CORP.                                 ║\n║  Issued at: Boston, Massachusetts                                 ║\n║                                                                   ║\n║  _____________________________          February 1, 2024          ║\n║  President                                                        ║\n╚═══════════════════════════════════════════════════════════════════╝\n","summary":"This document specifies that the policyholder has a 30-day free look period to cancel the policy and receive a full premium refund upon receipt. Additionally, the insurer may contest coverage only during the initial two-year period while the insured is alive, solely due to material misrepresentations made in the original application. These terms ensure transparency and fairness in early-stage policy management.","topics":["Free Look Period","Contestability Clause","Insurance Policy Terms","Policy Cancellation"],"facts":[{"name":"Free Look Cancellation","sentence":"The policyholder may cancel this policy within 30 days of receiving it.","macro_topics":[],"chunk_topics":["free look period","policy cancellation","30-day refund"],"entities":[{"name":"FREE LOOK PERIOD","type":"CONCEPT","role":"cancellation window for refund","relational_anchors":[]},{"name":"30 days","type":"DATE","role":"duration of free look period","relational_anchors":[]},{"name":"CONTESTABILITY","type":"CONCEPT","role":"limitation on policy challenge","relational_anchors":[]},{"name":"two years","type":"DATE","role":"maximum contestability duration","relational_anchors":[]},{"name":"GUARDIAN FAMILY PROTECTION CORP.","type":"ORGANIZATION","role":"insurer issuing policy","relational_anchors":[]},{"name":"Boston, Massachusetts","type":"LOCATION","role":"issuance location of policy","relational_anchors":[]},{"name":"President","type":"TITLE","role":"executive officer signing policy","relational_anchors":[]},{"name":"February 1, 2024","type":"DATE","role":"issue date of policy","relational_anchors":[]}]},{"name":"Free Look Refund Policy","sentence":"A full refund of premiums paid is available upon cancellation within 30 days of receipt.","macro_topics":[],"chunk_topics":["free look period","premium refund","cancellation window"],"entities":[{"name":"FREE LOOK PERIOD","type":"CONCEPT","role":"cancellation window for refund","relational_anchors":[]},{"name":"30 days","type":"DATE","role":"duration of free look period","relational_anchors":[]},{"name":"CONTESTABILITY","type":"CONCEPT","role":"limitation on policy challenge","relational_anchors":[]},{"name":"two years","type":"DATE","role":"maximum contestability duration","relational_anchors":[]},{"name":"GUARDIAN FAMILY PROTECTION CORP.","type":"ORGANIZATION","role":"insurer issuing policy","relational_anchors":[]},{"name":"Boston, Massachusetts","type":"LOCATION","role":"issuance location of policy","relational_anchors":[]},{"name":"President","type":"TITLE","role":"executive officer signing policy","relational_anchors":[]},{"name":"February 1, 2024","type":"DATE","role":"issue date of policy","relational_anchors":[]}]},{"name":"Policy Issuer","sentence":"Guardian Family Protection Corp. issues this policy.","macro_topics":[],"chunk_topics":["policy issuance","insurance provider","company identity"],"entities":[{"name":"FREE LOOK PERIOD","type":"CONCEPT","role":"cancellation window for refund","relational_anchors":[]},{"name":"30 days","type":"DATE","role":"duration of free look period","relational_anchors":[]},{"name":"CONTESTABILITY","type":"CONCEPT","role":"limitation on policy challenge","relational_anchors":[]},{"name":"two years","type":"DATE","role":"maximum contestability duration","relational_anchors":[]},{"name":"GUARDIAN FAMILY PROTECTION CORP.","type":"ORGANIZATION","role":"insurer issuing policy","relational_anchors":[]},{"name":"Boston, Massachusetts","type":"LOCATION","role":"issuance location of policy","relational_anchors":[]},{"name":"President","type":"TITLE","role":"executive officer signing policy","relational_anchors":[]},{"name":"February 1, 2024","type":"DATE","role":"issue date of policy","relational_anchors":[]}]},{"name":"Policy Issuance Location","sentence":"This policy was issued in Boston, Massachusetts.","macro_topics":[],"chunk_topics":["policy issuance","Boston Massachusetts","issuer location"],"entities":[{"name":"FREE LOOK PERIOD","type":"CONCEPT","role":"cancellation window for refund","relational_anchors":[]},{"name":"30 days","type":"DATE","role":"duration of free look period","relational_anchors":[]},{"name":"CONTESTABILITY","type":"CONCEPT","role":"limitation on policy challenge","relational_anchors":[]},{"name":"two years","type":"DATE","role":"maximum contestability duration","relational_anchors":[]},{"name":"GUARDIAN FAMILY PROTECTION CORP.","type":"ORGANIZATION","role":"insurer issuing policy","relational_anchors":[]},{"name":"Boston, Massachusetts","type":"LOCATION","role":"issuance location of policy","relational_anchors":[]},{"name":"President","type":"TITLE","role":"executive officer signing policy","relational_anchors":[]},{"name":"February 1, 2024","type":"DATE","role":"issue date of policy","relational_anchors":[]}]},{"name":"Policy Signing Authority","sentence":"The president of Guardian Family Protection Corp. signed the policy.","ma