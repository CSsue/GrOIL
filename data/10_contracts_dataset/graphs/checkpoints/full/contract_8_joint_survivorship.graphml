  <data key="d2">fact_entity</data>
  <data key="d4">DOCUMENT</data>
</edge>
<edge source="a9ec20a6-7d7d-487c-a092-216f40615962" target="e8ac86ee-52d5-4e83-836e-ce6b9ca63526">
  <data key="d2">fact_entity</data>
  <data key="d4">DOCUMENT</data>
</edge>
