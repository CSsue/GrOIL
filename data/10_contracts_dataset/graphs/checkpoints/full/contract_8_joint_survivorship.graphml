<edge source="a9e7f4af-ec56-47d8-ac60-93deb168dbf1" target="a0b10575-bd5a-4f55-8723-9eef12dd06d8">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
