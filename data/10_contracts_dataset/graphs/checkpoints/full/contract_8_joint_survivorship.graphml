  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="0df8a60d-2dd5-49e0-a026-86763abbc127" target="92227348-7ca3-4dc4-96b6-2c8ba4eeb07d">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="0df8a60d-2dd5-49e0-a026-86763abbc127" target="b6023933-69cb-499f-b332-0712e62a5f93">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="0df8a60d-2dd5-49e0-a026-86763abbc127" target="0d022b3d-74b1-46bd-b451-d161a6ee9c0b">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="0df8a60d-2dd5-49e0-a026-86763abbc127" target="2e0f0fc9-7b63-4fae-bb19-2d75f4901c4b">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
