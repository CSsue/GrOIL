  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="2461f012-1c2a-4b80-84ff-a70ea9af51ba" target="41345f1b-876b-4428-8de8-ca8f9fb6be9c">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="2461f012-1c2a-4b80-84ff-a70ea9af51ba" target="a30f82f7-4e12-4ff1-8c63-b4a97d06da6f">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="2461f012-1c2a-4b80-84ff-a70ea9af51ba" target="3ad8f663-7aaf-4e0a-abcc-508a5a53c5c2">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
