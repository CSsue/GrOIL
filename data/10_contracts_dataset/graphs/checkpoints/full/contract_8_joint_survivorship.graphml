  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="0ac06249-c2b3-4788-84f9-796a3b669e1f" target="c909b790-e9c5-4e72-b89b-8c826777def9">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
