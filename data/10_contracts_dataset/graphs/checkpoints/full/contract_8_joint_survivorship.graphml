  <data key="d3">Continued payment of premiums after the first death ensures that the policy remains intact and functional, enabling it to fulfill its primary purpose of providing estate tax liquidity upon the second death.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
