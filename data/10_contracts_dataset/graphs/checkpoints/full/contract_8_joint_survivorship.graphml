  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="1ec93897-4582-467c-9df8-bc0d20aec783" target="7301ffad-6210-4272-bfa7-d437bf731aa0">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="1ec93897-4582-467c-9df8-bc0d20aec783" target="7af172e6-e7ab-4ca7-a2cb-979a1bdda51e">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="1ec93897-4582-467c-9df8-bc0d20aec783" target="a0ad4fae-a0a5-4007-b1e2-17e4e8130761">
  <data key="d2">fact_entity</data>
  <data key="d4">MONETARY_VALUE</data>
</edge>
<edge source="1ec93897-4582-467c-9df8-bc0d20aec783" target="dbc9071d-93ab-4417-91f2-b6f954438d4d">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
