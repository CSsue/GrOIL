  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="2461f012-1c2a-4b80-84ff-a70ea9af51ba" target="58feda71-18e1-447b-a479-a458360f5726">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="2461f012-1c2a-4b80-84ff-a70ea9af51ba" target="4000b347-da55-49e9-89ab-4a85f63bebe7">
  <data key="d2">fact_entity</data>
