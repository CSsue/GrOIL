  <data key="d2">fact_entity</data>
  <data key="d4">ORGANIZATION</data>
</edge>
<edge source="46633fa0-bf8c-4c98-a98e-6ecc6e3c013b" target="26403da7-7002-4027-98be-610601385ddb">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="46633fa0-bf8c-4c98-a98e-6ecc6e3c013b" target="8e54f0f0-2b07-432e-a440-afc392f2fa1e">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="46633fa0-bf8c-4c98-a98e-6ecc6e3c013b" target="83822f2c-3301-45dd-ad0b-5d67a38b5429">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
