  <data key="d3">The projected cash value of $285,000 after 10 years reflects the cumulative effect of regular premium payments made annually on August 20th under the policy's guaranteed growth terms.</data>
  <data key="d4">RESULT_OF</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
