  <data key="d3">The annual premium ceiling after Year 10 does not affect how the death benefit is triggered under the survivorship basis. This reflects a separate operational constraint unrelated to payout conditions.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
