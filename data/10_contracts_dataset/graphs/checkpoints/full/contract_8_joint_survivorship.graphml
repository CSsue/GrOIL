  <data key="d3">Despite having a mechanism allowing splitting into two policies post-first death, this provision sees minimal use. This lack of adoption contrasts with loan terms that directly impact the death benefit when utilized.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
