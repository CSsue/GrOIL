  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="a9e7f4af-ec56-47d8-ac60-93deb168dbf1" target="2c40dc8d-d652-4476-9f5d-427991161d96">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
