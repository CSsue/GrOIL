  <data key="d3">The policy continuing after the first death enables the Trust to maintain control and exercise its right to surrender the policy under any circumstances permitted by contract.</data>
  <data key="d4">DEPENDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
