  <data key="d4">is required to trigger</data>
</edge>
<edge source="fd4fd3c8-ad27-46c6-ac92-dea20ee544e8" target="e3ba5ff9-a204-4af4-850d-38d792f8f557">
  <data key="d2">entity_fact</data>
  <data key="d4">are needed to process</data>
</edge>
