  <data key="d3">The maintenance of an unchanged coverage amount post-first-death reflects the initial condition that two lives are insured under a joint survivorship policy, preserving the intended payout terms.</data>
  <data key="d4">EXPLAINS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
