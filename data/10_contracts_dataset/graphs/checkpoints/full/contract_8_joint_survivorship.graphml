  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="46633fa0-bf8c-4c98-a98e-6ecc6e3c013b" target="4b16f1e8-f1cb-478d-a7c0-12813446f3d9">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
