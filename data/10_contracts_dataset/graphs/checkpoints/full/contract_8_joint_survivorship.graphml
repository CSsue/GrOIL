  <data key="d4">CONCEPT</data>
</edge>
<edge source="bfe9a0f3-fce1-4c16-a4f6-2a78f6d39acf" target="a863083e-0942-4645-9d6a-ed5f0717c927">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
