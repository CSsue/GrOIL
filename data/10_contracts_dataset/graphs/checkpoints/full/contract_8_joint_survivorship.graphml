  <data key="d2">fact_entity</data>
  <data key="d4">DATE</data>
</edge>
<edge source="3b80d1cc-14b1-44a5-b6e4-b4d970384d8d" target="8e3e7bf9-e0e0-4321-b75f-aabc225d09ef">
