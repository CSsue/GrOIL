  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="115deb5a-9af7-4024-bf11-8dba457cef0b" target="e3e49333-4660-4170-be0e-750c514619c6">
  <data key="d3">The Trust's ability to assign the policy is subject to obtaining formal authorization from the trustee, ensuring oversight and compliance with fiduciary duties.</data>
