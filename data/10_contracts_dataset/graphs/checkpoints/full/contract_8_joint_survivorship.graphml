  <data key="d4">CONCEPT</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="eb5297f9-248c-4226-a107-5aaf2ae03886">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="54c48f0b-f39d-45b0-914b-a5cc38b6d5a4">
  <data key="d2">fact_entity</data>
  <data key="d4">ORGANIZATION</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="aa9f0e6b-f3a2-4c72-97e6-c62ba71bf05d">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="0f66f9c7-bec3-40f4-89e7-79092be48f21">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="bb48fbb0-73bb-4678-a651-8f869ead90c4">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="4f7c58e0-735d-473c-8e8d-8a11b55b58af" target="d415825a-abde-4c90-bf2f-94a042ba1d8e">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
