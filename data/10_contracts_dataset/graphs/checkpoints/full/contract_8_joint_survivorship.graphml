<edge source="5ddd660e-ea55-4c09-9860-50f4685212cf" target="e27a52b8-188d-412d-9f06-85f8d10702af">
  <data key="d3">Fact sentence 1 states that war exclusions do not apply, contributing to the broad coverage terms. Fact sentence 2 extends this by confirming that aviation exclusions also do not apply, reinforcing the inclusive nature of the policy’s coverage.</data>
  <data key="d4">COMPLEMENTS</data>
  <data key="d2">fact_fact</data>
