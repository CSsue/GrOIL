  <data key="d3">Index percentage changes are determined via a standard formula based on beginning and end values, unaffected by the Fixed Account’s guaranteed yield.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="665dbf69-ad45-49be-8a49-a811282557e1" target="b24459ef-4087-463c-8274-73d1eef85c9a">
  <data key="d3">The computation of index percentage changes on policy anniversaries does not affect or relate to whether the Fixed Account has a cap.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
