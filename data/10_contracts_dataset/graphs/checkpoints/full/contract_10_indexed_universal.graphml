  <data key="d3">Monthly charges are deducted on the third day of every month regardless of the specific premium amount paid, meaning that the $100 minimum payment is unaffected by the timing of these deductions.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
