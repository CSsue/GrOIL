  <data key="d3">Monthly charges being deducted on the third day of each month means that timely premium payments should ideally precede this date to ensure sufficient funds remain in the account.</data>
  <data key="d4">FOLLOWS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
