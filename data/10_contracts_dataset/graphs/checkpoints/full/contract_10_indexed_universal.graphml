  <data key="d3">The 7% surrender charge in Year 4 depends on cumulative premiums paid, making the $100 minimum payment requirement relevant to determining potential exit costs.</data>
  <data key="d4">INFLUENCED_BY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
