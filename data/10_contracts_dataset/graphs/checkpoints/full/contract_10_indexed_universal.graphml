  <data key="d5">0.0</data>
</edge>
<edge source="f75970d5-49e2-416e-98bf-26056a65e3f9" target="9ac0c7c4-1321-469b-afaa-abe6d54dbd8e">
  <data key="d3">Fact_sentence_1 specifies a financial condition tied to policyholder actions, supported by the broader documentation provided in chunk_summary_1. Fact_sentence_2 names the insurer responsible for issuing that documentation, establishing institutional authority but not altering the operational detail about withdrawals.</data>
