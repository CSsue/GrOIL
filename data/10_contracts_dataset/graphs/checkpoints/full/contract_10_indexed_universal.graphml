  <data key="d3">Loan availability after one year is unrelated to whether interest is credited during index drops, as it hinges on time-in-force, not investment returns.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="6f98a9e1-688e-4680-b305-6c7ecf379647" target="70667dae-ff8c-4bac-bf04-03807ddb6bd7">
