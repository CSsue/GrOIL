  <data key="d3">A 7% surrender charge in Year 4 may reduce the effective payout, indirectly affecting whether the $12 monthly administrative fee remains sustainable relative to remaining account balance.</data>
  <data key="d4">FINANCIAL_IMPACT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.35</data>
</edge>
