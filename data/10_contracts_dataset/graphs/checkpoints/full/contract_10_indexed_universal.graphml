e":"1% annually","type":"RATE","role":"net annual cost of borrowing","relational_anchors":["Net cost: 1% annually"]},{"name":"PARTIAL WITHDRAWALS","type":"CONCEPT","role":"withdrawal mechanism reducing death benefit","relational_anchors":["Minimum: $500","Maximum: Account value minus surrender charge","First 10 withdrawals free; $50 fee thereafter","Reduces death benefit dollar-for-dollar under Option 1"]},{"name":"$500","type":"AMOUNT","role":"minimum withdrawal threshold","relational_anchors":["Minimum: $500"]},{"name":"$50 fee","type":"FEES","role":"charge per withdrawal beyond first ten","relational_anchors":["$50 fee thereafter"]},{"name":"Outstanding loans","type":"CONCEPT","role":"liabilities reducing final death benefit","relational_anchors":["reduce death benefit at time of claim"]},{"name":"Surrender Charges","type":"CHARGE","role":"penalties for early termination","relational_anchors":["Year 1: 10%","Year 4: 7%","Year 7:"]},{"name":"Year 1","type":"YEAR","role":"first year subject to highest surrender charge","relational_anchors":["Year 1: 10%"]},{"name":"Year 4","type":"YEAR","role":"fourth year with reduced surrender charge","relational_anchors":["Year 4: 7%"]}]},{"name":"Increasing Death Benefit Formula","sentence":"The death benefit under Option 2 equals the specified amount plus the account value.","macro_topics":[],"chunk_topics":["Death Benefit Calculation","Option 2","Account Value Integration"],"entities":[{"name":"Level Death Benefit","type":"CONCEPT","role":"current default option","relational_anchors":["Option 1"]},{"name":"$500,000","type":"AMOUNT","role":"fixed death benefit amount","relational_anchors":["Death Benefit = $500,000"]},{"name":"Increasing Death Benefit","type":"CONCEPT","role":"growing benefit tied to account value","relational_anchors":["Option 2"]},{"name":"Specified Amount","type":"CONCEPT","role":"base component of increasing death benefit","relational_anchors":[]},{"name":"Account Value","type":"CONCEPT","role":"variable c