  <data key="d3">Year 6 has a 5% surrender charge based on accumulated premiums, reflecting the declining schedule. This detail does not influence or relate directly to the 61-day grace period offered upon missed payments.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
