  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="d39b66e7-d38a-450c-a287-bd1bf0a73d22" target="dc9f1c71-4218-47d3-a2d6-f9dd0a3d8783">
  <data key="d3">The loan interest mechanism described in fact_sentence_1 pertains to internal policy finance terms, whereas fact_sentence_2 identifies the insurer’s online platform. There is no interaction between these two pieces of information beyond shared origin in the same documentation.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="d39b66e7-d38a-450c-a287-bd1bf0a73d22" target="47c97675-2a23-4fd8-af2f-5cf44ebaf17b">
  <data key="d3">The loan interest and return mechanism described in fact_sentence_1 relates solely to policyholder financials and does not depend on or reflect the identity or role of the signing officer mentioned in fact_sentence_2.</data>
  <data key="d4">INDEPENDENT</data>
