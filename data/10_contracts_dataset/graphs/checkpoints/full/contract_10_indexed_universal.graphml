  <data key="d3">The calculation of the index percentage change on each policy anniversary determines whether the policyholder earns positive returns or faces zero crediting during downturns, aligning with the 0% floor guarantee.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
