  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="e9e8f00a-1414-40a5-99b4-1975b3ddee75" target="ba1c52cb-9fba-4846-9a66-8e0c71e2a754">
  <data key="d3">The mention of a surrender charge in Year 8 pertains to policy financial terms, while the presence of a seal indicates formal authentication of the document. These elements serve different purposes—one operational, one procedural—and do not directly inform or depend on each other.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="3576e78b-92aa-419b-864c-75768d1f6c51" target="e9e8f00a-1414-40a5-99b4-1975b3ddee75">
  <data key="d2">entity_fact</data>
  <data key="d4">has_surrender_charge_rate</data>
</edge>
