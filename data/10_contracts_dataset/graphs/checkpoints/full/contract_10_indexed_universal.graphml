  <data key="d3">A 7% surrender charge in Year 4 reflects one of several penalties associated with early withdrawal, potentially affecting returns when high premiums—up to $50,000—are paid.</data>
  <data key="d4">RELATED_TO</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
