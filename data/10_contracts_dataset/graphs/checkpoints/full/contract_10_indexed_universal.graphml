  <data key="d4">AMOUNT</data>
</edge>
<edge source="a53ff70e-2b10-4259-9e14-fe7adb0931b1" target="5aaeba25-8c50-478b-bb6e-346e3f89ff10">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
<edge source="a53ff70e-2b10-4259-9e14-fe7adb0931b1" target="d256111f-3216-4334-90b0-47a26fa2abfb">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
