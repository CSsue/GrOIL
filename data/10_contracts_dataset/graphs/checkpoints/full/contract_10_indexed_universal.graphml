</edge>
<edge source="70667dae-ff8c-4bac-bf04-03807ddb6bd7" target="7aff69d9-e95c-4762-9fc3-9b84d35f05e5">
  <data key="d3">The guarantee against principal loss due to market declines complements the overall stability of the policy’s account value, which may influence decisions around partial withdrawals where fees apply. While the safety feature protects capital, frequent withdrawals—even if protected from market losses—may still incur costs.</data>
  <data key="d4">COMPLIMENTS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.45</data>
</edge>
<edge source="1b805f04-e39b-45c0-b693-e75c644e53be" target="70667dae-ff8c-4bac-bf04-03807ddb6bd7">
  <data key="d2">entity_fact</data>
  <data key="d4">provides protection against market decline</data>
</edge>
<edge source="fee01dea-b9d8-455c-a0cf-57c6ea8d929f" target="70667dae-ff8c-4bac-bf04-03807ddb6bd7">
  <data key="d2">entity_fact</data>
  <data key="d4">remains unchanged during market decline</data>
</edge>
<edge source="0f70c924-6713-45b4-9d84-3f5f05c6c5cb" target="70667dae-ff8c-4bac-bf04-03807ddb6bd7">
  <data key="d2">entity_fact</data>
  <data key="d4">does not result in loss of principal</data>
</edge>
<edge source="cb92f95d-f371-4f39-9a2a-d9fd842a3dfc" target="70667dae-ff8c-4bac-bf04-03807ddb6bd7">
  <data key="d2">entity_fact</data>
  <data key="d4">is protected from loss due to market decline</data>
</edge>
