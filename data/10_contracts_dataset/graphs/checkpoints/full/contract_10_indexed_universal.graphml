  <data key="d3">Fact_sentence_1 explains how unpaid policy loans decrease the death benefit, while fact_sentence_2 gives a general customer service phone number. No interaction exists between these elements.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
