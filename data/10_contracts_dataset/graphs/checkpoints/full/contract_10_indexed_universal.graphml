  <data key="d3">To modify the $500,000 death benefit under Option 1, policyholders must submit a request at least 60 days in advance, ensuring administrative processing time before the change takes effect.</data>
  <data key="d4">REQUIRED FOR OPTION SWITCH</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
