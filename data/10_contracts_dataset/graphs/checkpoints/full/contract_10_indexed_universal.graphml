  <data key="d3">The existence of a no-lapse guarantee rider indicates an additional policy enhancement option, independent of the fixed surrender charge applied in Year 3.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
