<edge source="b29caae3-f13a-4b43-af52-606c74d4bb86" target="a5cf74c6-3010-4b87-83b5-452662af8369">
  <data key="d3">A 0.5% surrender charge applies in Year 11, reflecting ongoing fees for exiting the policy later than initial years. This contrasts with the 0% floor on the Global Diversified Index Account, which guarantees minimum returns regardless of market conditions.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.15</data>
</edge>
