  <data key="d3">Monthly charges being deducted from the account value require regular contributions like the recommended $6,000 to prevent depletion of funds.</data>
  <data key="d4">NEEDS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
