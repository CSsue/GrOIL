  <data key="d3">Monthly charges, including cost-of-insurance and administrative fees, are subtracted from the account balance on the third day of each month. The $50,000 annual premium ceiling, tied to tax qualification, has no bearing on this deduction schedule.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
