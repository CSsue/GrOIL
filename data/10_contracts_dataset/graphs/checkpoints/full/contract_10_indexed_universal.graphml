  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
<edge source="0b7e0a06-5166-489d-a873-3b798f915e2c" target="6a007c8b-08f2-4704-b952-a2a8254c2a22">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
