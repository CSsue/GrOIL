  <data key="d3">Annual adjustment of fixed account rates has no impact on the duration or terms of the 61-day grace period for reinstatement.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
