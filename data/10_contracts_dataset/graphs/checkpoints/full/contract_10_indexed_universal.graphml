  <data key="d3">A no-lapse guarantee rider exists as an optional feature, though it was not selected by the policyholder. Its availability does not affect the calculation or existence of surrender charges in Year 1.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
