  <data key="d3">The $50 fee for additional partial withdrawals pertains to policyholder actions affecting financial outcomes, while the presence of a seal indicates document authenticity but has no bearing on withdrawal rules.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
