  <data key="d3">Monthly charges being deducted on the third day of each month depends on prior receipt of premiums, making the minimum payment condition relevant to sustaining the account's ability to cover such deductions.</data>
  <data key="d4">DEPENDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
