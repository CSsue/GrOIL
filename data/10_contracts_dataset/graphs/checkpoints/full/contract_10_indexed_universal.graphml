  <data key="d2">fact_entity</data>
  <data key="d4">ARTICLE</data>
</edge>
<edge source="fe831b43-8690-4c01-9873-79e0ef24ae00" target="9a488d62-e979-4596-b1a5-9f1f27f69c8a">
