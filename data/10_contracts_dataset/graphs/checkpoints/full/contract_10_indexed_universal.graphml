  <data key="d3">The fixed 4% interest rate on policy loans remains unchanged regardless of whether a policyholder switches death benefit options annually.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
