  <data key="d3">Minimum participation rates of 25% apply uniformly across index-based accounts regardless of how assets are allocated, including the portion held in the Fixed Account.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
