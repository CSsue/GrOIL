  <data key="d3">Monthly deductions from the account value include the 3.5% premium load, meaning the initial loading fee is incorporated into recurring financial adjustments.</data>
  <data key="d4">INCLUDES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
