  <data key="d3">Free reallocation allows investors to shift assets among accounts without cost, regardless of the individual account’s participation rate or indexing method.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
