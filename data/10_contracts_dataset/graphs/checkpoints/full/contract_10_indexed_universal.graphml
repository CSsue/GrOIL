  <data key="d3">A 0.5% surrender charge in Year 11 reflects a potential future cost impact, though it does not directly influence the current $12 monthly administrative fee.</data>
  <data key="d4">INDEPENDENT_COST</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.35</data>
</edge>
