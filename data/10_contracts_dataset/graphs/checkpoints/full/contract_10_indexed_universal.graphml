  <data key="d2">entity_fact</data>
  <data key="d4">contributes_to</data>
</edge>
<edge source="393fa66b-9220-4066-b5e0-cb4f01be903f" target="b8046f06-ce88-4546-bb7c-16ba4c69bcf2">
  <data key="d2">entity_fact</data>
  <data key="d4">contributes_to</data>
</edge>
<edge source="04878177-211b-4333-b2b4-07556222b204" target="b8046f06-ce88-4546-bb7c-16ba4c69bcf2">
  <data key="d2">entity_fact</data>
  <data key="d4">contributes_to</data>
</edge>
<edge source="8bc470ae-59fc-49fc-8e17-d0824413bdaa" target="b8046f06-ce88-4546-bb7c-16ba4c69bcf2">
  <data key="d2">entity_fact</data>
  <data key="d4">subject_to_maximum_annual_premium_limit</data>
</edge>
<edge source="0d35c1ce-d96d-4562-80f8-0654abe126d2" target="d6047aab-7f2e-4879-a3d0-06c9890f60f0">
  <data key="d2">fact_entity</data>
