<edge source="0f6b3b49-d7b3-4758-a638-6cbce563fda7" target="2b2e3f84-59bf-4a6e-b26c-8b5ae353f6de">
  <data key="d3">A guaranteed minimum participation rate of 25% ensures that even if markets perform poorly, investors still receive meaningful credits, supporting strategic rebalancing decisions made at policy anniversaries.</data>
  <data key="d4">SUPPORTS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
