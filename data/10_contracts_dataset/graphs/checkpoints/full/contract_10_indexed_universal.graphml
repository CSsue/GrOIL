  <data key="d2">fact_entity</data>
  <data key="d4">ARTICLE</data>
</edge>
<edge source="fed316a6-229f-46af-91a9-72511967565a" target="a99a6250-60cf-4c50-9d5d-b0bfcf5d2341">
