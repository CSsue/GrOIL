  <data key="d3">Monthly charges are subtracted from the account value regardless of investment returns. Even if the account earns 0%, these deductions continue to affect the overall value negatively.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.15</data>
</edge>
