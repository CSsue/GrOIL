  <data key="d3">Charges are deducted monthly on the third day, based on the current account value after contributions. This deduction schedule has no bearing on the maximum allowable premium of $50,000 per year.</data>
  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
