  <data key="d3">Free reallocation limits allow investors to modify their investment mix multiple times annually at no charge, independent of the specific crediting period used for calculating index returns.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
