  <data key="d3">Premiums may be paid at any time without restrictions, offering convenience to policyholders. This flexibility operates independently of the policy’s floor protection mechanism.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
