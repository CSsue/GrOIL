  <data key="d5">0.0</data>
</edge>
<edge source="665dbf69-ad45-49be-8a49-a811282557e1" target="5970ce74-f216-4469-89e2-77ce18166763">
  <data key="d3">Index returns are computed annually based on specific valuation points, unaffected by the behavior of the Fixed Account’s guaranteed yield.</data>
  <data key="d4">INDEPENDENT</data>
