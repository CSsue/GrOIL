  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="99ca8905-b57d-4689-9164-12678eda198b" target="024598e4-2394-4fad-b636-543f3ffb9225">
  <data key="d3">Option 1 has lower ongoing charges compared to Option 2, making it more cost-efficient over time. This cost advantage may indirectly support greater flexibility in managing policy funds, such as enabling partial withdrawals without exacerbating expense burdens.</data>
