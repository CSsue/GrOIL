  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="58e88db1-b482-464a-9787-0f3ed9dcc844">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="e2def782-c7b3-4ede-8ed1-30b9acf2c90f">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="ab43863c-cd28-4091-94bc-4a91b52de89f">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="060924ca-715f-4ccc-ac16-3a6ee48f8620">
  <data key="d2">fact_entity</data>
  <data key="d4">AMOUNT</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="a147a11f-c9e6-4357-9dfe-398bb532bc8b">
  <data key="d2">fact_entity</data>
  <data key="d4">PERCENTAGE</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="5b347841-5b58-4073-9971-7ade85a5d3ef">
  <data key="d2">fact_entity</data>
  <data key="d4">CHARGE</data>
</edge>
<edge source="9639c325-d6a7-4181-a801-0a4fdfaefa94" target="c450e6be-7a4f-4606-9e47-117471974138">
  <data key="d2">fact_entity</data>
  <data key="d4">CHARGE</data>
</edge>
