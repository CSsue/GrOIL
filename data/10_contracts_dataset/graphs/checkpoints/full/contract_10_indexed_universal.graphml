  <data key="d3">Fact sentence 1 discusses potential annual adjustments to fixed account interest rates, which pertains to financial terms of the policy. This has no direct relation to the contact information provided in fact sentence 2.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
