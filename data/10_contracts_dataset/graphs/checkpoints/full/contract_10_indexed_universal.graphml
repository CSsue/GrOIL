  <data key="d3">A higher likelihood of paying minimal premiums may increase risk of policy lapse before Year 4, potentially triggering surrender charges when exiting early despite low initial payments.</data>
  <data key="d4">CONTEXTUAL_DEPENDENCE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.45</data>
</edge>
