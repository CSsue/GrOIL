  <data key="d3">Monthly deductions occur on a set schedule regardless of when premiums were contributed. The timing of premium payments has no impact on when charges are withdrawn from the account balance.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
