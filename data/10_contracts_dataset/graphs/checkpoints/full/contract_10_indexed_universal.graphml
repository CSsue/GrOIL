  <data key="d3">Since the total monthly charges are deducted on the third day of the month, the $12 administrative fee is included in those deductions.</data>
  <data key="d4">INCLUDED_IN</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
