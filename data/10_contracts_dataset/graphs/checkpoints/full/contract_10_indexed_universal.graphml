</edge>
<edge source="7aff69d9-e95c-4762-9fc3-9b84d35f05e5" target="e1d7d59c-ecc5-48bc-b7c4-1fd4fcfbe199">
  <data key="d3">While partial withdrawals after the tenth year incur a $50 fee, this charge has no direct impact on whether the death benefit remains level. The level benefit is determined independently of withdrawal activity.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
