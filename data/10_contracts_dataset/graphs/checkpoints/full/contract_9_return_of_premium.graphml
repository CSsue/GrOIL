<edge source="34938dcf-3e35-4563-87da-55be923c02a2" target="884ef424-e8e1-4bf5-bf91-395b93140734">
  <data key="d3">Carlos Roberto Martinez is named as the primary beneficiary, meaning he is entitled to receive the death benefit if the insured dies during the policy term. This role is defined within the framework of a Return of Premium (ROP) Term Life Insurance Policy, which outlines how and when payouts occur.</data>
  <data key="d4">CONTEXTUALIZES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
