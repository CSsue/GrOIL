  <data key="d3">The 20-year term defines the policy’s lifespan, independent of the insured’s current age when the policy was issued.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
