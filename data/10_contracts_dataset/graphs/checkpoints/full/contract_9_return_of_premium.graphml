  <data key="d3">The ability to apply for reinstatement within five years after a policy lapse depends on fulfilling specific conditions, including providing acceptable proof of insurability.</data>
  <data key="d4">CONDITION_FOR</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
