</edge>
<edge source="52b46745-e979-474e-98c8-d03bf1b89c96" target="f27c11ea-c210-4031-a888-0370559eb63a">
  <data key="d2">fact_entity</data>
  <data key="d4">SECTION</data>
</edge>
<edge source="52b46745-e979-474e-98c8-d03bf1b89c96" target="b8181f32-9a08-4510-948e-602649f9459e">
  <data key="d2">fact_entity</data>
  <data key="d4">SUBSECTION</data>
</edge>
