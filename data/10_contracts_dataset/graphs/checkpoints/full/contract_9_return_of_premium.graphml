  <data key="d2">fact_entity</data>
  <data key="d4">CRITICAL_CONDITION</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="599c615b-008b-4cd3-8ded-2edb9544d8a7">
  <data key="d2">fact_entity</data>
  <data key="d4">TIME_PERIOD</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="7e772258-12f4-4840-beb1-ea992c103a46">
  <data key="d2">fact_entity</data>
  <data key="d4">CONSEQUENCE</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="faa07813-634c-4096-bd71-1545238bb51e">
  <data key="d2">fact_entity</data>
  <data key="d4">PENALTY</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="f247b725-8568-48b1-972f-e610a61b252c">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="a77ca9dc-9243-4af1-9803-84601d36a88c">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="1233ae69-913e-4cbe-8257-e9ce2d717e4f" target="bd9893e2-1af4-42cc-8567-951981b953d3">
