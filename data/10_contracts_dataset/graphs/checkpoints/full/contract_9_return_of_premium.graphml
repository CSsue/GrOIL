  <data key="d3">Reinstatement rights after a policy lapse are independent of whether the insured died by suicide within the first two years. The ability to reinstate depends on meeting financial and health requirements, not on prior claims or cause of death.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
