  <data key="d3">Changing beneficiaries is an administrative right available to the policyholder, independent of where the policy was signed. This action has no bearing on the geographical origin of the document.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
