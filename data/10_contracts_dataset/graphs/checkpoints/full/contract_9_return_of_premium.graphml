  <data key="d3">An incorrect age declaration impacts the death benefit but leaves the ROP amount unaffected, independent of any limitations related to borrowing against cash value.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
