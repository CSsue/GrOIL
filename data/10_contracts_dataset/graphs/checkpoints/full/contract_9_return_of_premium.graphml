  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="9d3d7a34-a79d-4b06-8284-d7e63952d8af" target="e16dc95e-60ca-4799-8cb5-4bd24f5a1030">
  <data key="d3">Age misstatements influencing only the death benefit, not the ROP, are independent of whether the policy accumulates cash value. One relates to claims adjustment, the other to asset growth potential.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
