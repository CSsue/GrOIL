  <data key="d3">Timely annual payments are necessary to maintain eligibility for the return-of-premium benefit described in the initial policy terms.</data>
  <data key="d4">REQUIRED_FOR</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
