  <data key="d3">Requiring payment of overdue premiums with 6% interest upon reinstatement applies regardless of whether travel exclusions exist, so it stands independently of any exclusion policies.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
