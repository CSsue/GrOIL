  <data key="d3">Fact_sentence_2 establishes the prerequisite of on-time payments needed to trigger the return specified in fact_sentence_1, making it foundational to its realization.</data>
  <data key="d4">REQUIRED_FOR</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
