  <data key="d3">Since Carlos Roberto Martinez owns 100% of the policy, he is the designated recipient of the $32,400 return when the policy matures successfully after 20 years of on-time payments.</data>
  <data key="d4">ENTITLED_TO</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
