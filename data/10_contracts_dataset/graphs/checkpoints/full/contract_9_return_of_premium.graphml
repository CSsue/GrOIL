  <data key="d4">SUBSECTION</data>
</edge>
<edge source="42e69377-0625-4ae5-a39b-739f702ac7a7" target="c2d663a4-7671-42f9-8075-2e4a9b8e3d29">
  <data key="d2">fact_entity</data>
