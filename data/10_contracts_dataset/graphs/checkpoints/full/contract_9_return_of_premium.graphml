  <data key="d3">Survival past the 20-year term is necessary for the return of premiums, making ongoing survival a prerequisite for fulfilling the benefit described in fact_sentence_1.</data>
  <data key="d4">REQUIRED_FOR</data>
  <data key="d2">fact_fact</data>
