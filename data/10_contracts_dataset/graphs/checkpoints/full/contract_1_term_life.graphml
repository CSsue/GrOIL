      <data key="d3">The presence of an authorized signature from the Chief Underwriting Officer confirms document validity without affecting the criteria for policy conversion based on class.</data>
      <data key="d4">INDEPENDENT</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.0</data>
    </edge>
