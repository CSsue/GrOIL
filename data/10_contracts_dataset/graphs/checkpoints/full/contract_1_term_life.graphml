      <data key="d3">Premiums for converting to a permanent policy depend on the selected policy class, regardless of claim requirements like proof of death.</data>
      <data key="d4">NONE</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.0</data>
    </edge>
