    <edge source="717aac5d-150f-48ca-8d8c-4a8f6ad91954" target="64416e2d-931f-4395-bb67-9cff9f4c86a4">
      <data key="d2">fact_entity</data>
      <data key="d4">CONCEPT</data>
    </edge>
    <edge source="717aac5d-150f-48ca-8d8c-4a8f6ad91954" target="6257cee7-cf80-47c1-ad60-b54fa71a0daa">
      <data key="d2">fact_entity</data>
      <data key="d4">CONCEPT</data>
    </edge>
    <edge source="717aac5d-150f-48ca-8d8c-4a8f6ad91954" target="b9a6592e-817c-4dbb-b368-4a0b5dcb97e6">
      <data key="d2">fact_entity</data>
      <data key="d4">DATE</data>
