      <data key="d3">Failure to pay within the grace period leads to policy lapse, terminating coverage. This outcome may prompt consideration of conversion options, where the new premium depends on the selected permanent policy class.</data>
      <data key="d4">CONDITIONAL_ON</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.3</data>
    </edge>
