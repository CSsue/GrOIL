    <edge source="b9bffd3e-9339-46c9-88e5-c86723b048a8" target="24f6a5ad-25db-42dc-939d-c4d5b2ed9a0f">
      <data key="d3">The 20-year term sets the timeframe during which the death benefit becomes payable; within this period, Sarah Elizabeth Anderson is entitled to receive the full $500,000 benefit if the insured passes away.</data>
      <data key="d4">CONTEXTUAL_RELEVANCE</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.75</data>
    </edge>
