      <data key="d2">entity_fact</data>
      <data key="d4">not excluded</data>
    </edge>
    <edge source="b2526d45-86bd-46aa-988c-9133248a5de0" target="883362bb-b7cf-40c8-9801-eb185d0f0958">
      <data key="d2">entity_fact</data>
      <data key="d4">not excluded</data>
    </edge>
    <edge source="9f31b182-76ce-4ed2-ae12-3a4c6c355c65" target="883362bb-b7cf-40c8-9801-eb185d0f0958">
      <data key="d2">entity_fact</data>
      <data key="d4">not excluded</data>
    </edge>
