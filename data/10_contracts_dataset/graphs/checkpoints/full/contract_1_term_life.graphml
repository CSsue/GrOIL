    <edge source="b9bffd3e-9339-46c9-88e5-c86723b048a8" target="65530dff-13a5-4bc9-975b-c4c8ec2db1db">
      <data key="d3">The 20-year term defines the timeframe during which regular premiums must be paid, including those due on the 15th of each month. This temporal framework ensures ongoing coverage throughout the entire policy duration.</data>
      <data key="d4">SUPPORTS</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.85</data>
