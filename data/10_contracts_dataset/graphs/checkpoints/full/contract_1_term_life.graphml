      <data key="d3">Fact sentence 2 defines the 20-year coverage window, which sets the timeframe during which benefits apply regardless of the insured’s birthdate detailed in fact sentence 1.</data>
      <data key="d4">INDEPENDENT</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.0</data>
    </edge>
