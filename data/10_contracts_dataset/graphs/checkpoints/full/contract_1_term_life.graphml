    </edge>
    <edge source="6bf61b64-8ea1-4157-b63e-7ea1c96a8aa9" target="ecc65c44-a48a-4f2a-aa01-37fdd58978fd">
      <data key="d3">The $500,000 death benefit depends on proper claim submission, including providing a certified death certificate as mandated by the insurer’s procedures.</data>
      <data key="d4">DEPENDS_ON</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
