      <data key="d3">The 20-year policy term defines the timeframe during which premiums are paid and coverage remains active, including the applicability of the 31-day grace period after each due date.</data>
      <data key="d4">DEPENDS_ON</data>
      <data key="d2">fact_fact</data>
      <data key="d5">0.95</data>
    </edge>
