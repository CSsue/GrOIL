  <data key="d3">The policy is only issued after the first premium has been paid, confirming the role of Sentinel Life Assurance Company as the responsible entity.</data>
  <data key="d4">CONDITIONAL_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
