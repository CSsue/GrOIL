  <data key="d2">fact_entity</data>
  <data key="d4">DOCUMENT</data>
</edge>
<edge source="f0a5245e-9eeb-422b-b2ca-4304e824a7be" target="df0895e1-5d21-456d-935d-43a468fd206e">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
