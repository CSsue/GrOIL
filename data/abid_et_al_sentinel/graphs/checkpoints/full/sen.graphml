  <data key="d3">Payment of past-due premiums with interest is a mandatory requirement enabling the reinstatement of a policy that has lapsed within the allowable five-year window.</data>
  <data key="d4">ENABLES_REINSTATEMENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
