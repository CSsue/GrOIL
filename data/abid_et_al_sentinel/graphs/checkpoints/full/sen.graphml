  <data key="d2">fact_entity</data>
  <data key="d4">ORGANIZATION</data>
</edge>
<edge source="ea7568f9-97e8-481c-ba9d-673126fb9ca4" target="94f00291-c089-4399-8c1f-17c6784a86c1">
