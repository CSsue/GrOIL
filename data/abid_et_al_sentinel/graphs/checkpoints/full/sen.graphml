  <data key="d3">Level premiums ensure consistent payments throughout the term, regardless of changes in risk or age, independent of reinstatement rules.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="af0642b0-b73b-4d5a-941d-8b8a65fef5d4" target="dc7d257a-6a88-40ef-9995-0d6cef3ac4dd">
  <data key="d3">Fact_sentence_1 describes premiums as stable across the term, which directly supports the guarantee stated in fact_sentence_2 that they won't rise. This reinforces the financial predictability of the policy.</data>
  <data key="d4">EQUIVALENT TO</data>
  <data key="d2">fact_fact</data>
  <data key="d5">1.0</data>
</edge>
