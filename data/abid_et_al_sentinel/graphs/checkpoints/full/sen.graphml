  <data key="d3">The policy owner possesses the legal right to designate or modify beneficiaries, which directly supports the implementation of changes that take effect independently of the insured’s life status.</data>
  <data key="d4">PRECEDES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
