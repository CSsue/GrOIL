  <data key="d5">0.0</data>
</edge>
<edge source="60830010-3081-43cc-889f-dacd9c3bee07" target="691ac7f0-573b-4d26-abde-28f5eabaea4f">
  <data key="d3">The inclusion of specific components in a Policy enables clear specification of renewal and conversion procedures, ensuring they align with documented contractual terms.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
