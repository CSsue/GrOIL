  <data key="d3">This sentence identifies the beneficiary as the person or entity named in the application. It has no bearing on the requirements for reinstating a policy after lapse.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="db12acf6-7ef1-442a-a0b0-0ebe2981d3c4" target="e6dc59e3-a8f4-4f56-940d-46199cdc1c83">
  <data key="d3">This statement identifies the recipient of the death benefit, but provides no information about reinstatement terms or premium payments.</data>
  <data key="d4"></data>
