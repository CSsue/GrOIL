  <data key="d3">Timely payment of premiums enables the policyholder to exercise the right to reinstate the policy within the 5-year post-lapse window.</data>
  <data key="d4">ENABLES_REINSTATEMENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
