  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="5a5e7682-7da5-4049-b77a-16dfdd50aec3" target="9be34e20-8ed0-40aa-9177-1ea8a3f2e3c6">
