  <data key="d3">An Automatic Premium Loan prevents policy lapse by covering missed premiums, thereby eliminating the need for reinstatement and its associated requirements like paying backlogged premiums with interest.</data>
  <data key="d4">PREVENTS LAPSING</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
