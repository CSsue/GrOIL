<edge source="69580977-8680-4303-b27e-16864466b8e8" target="5e10d7d2-9369-45f7-b96c-869e9315411d">
  <data key="d3">A 20-day examination period permits policyholders to cancel and get a full refund, preventing financial loss from premature decisions. Reinstatement offers a later opportunity to restore coverage after lapse, contingent on fulfilling requirements like paying overdue premiums and passing medical review.</data>
  <data key="d4">COMPLEMENTARY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
