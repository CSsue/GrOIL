  <data key="d3">Fact sentence 1 states that outstanding loans are deducted from the death benefit post-acceleration. This aligns directly with fact sentence 2, which specifies that liens are also deducted under the same conditions, reinforcing consistent treatment of financial obligations.</data>
  <data key="d4">COMPLIMENTS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
