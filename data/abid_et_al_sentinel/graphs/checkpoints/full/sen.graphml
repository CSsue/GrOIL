  <data key="d3">Payment of the death benefit depends on submitting proper documentation of death, regardless of whether the policy was previously reinstated or remains active throughout its term.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="827c6995-f0dd-4669-b3cd-e64364930b24" target="e6dc59e3-a8f4-4f56-940d-46199cdc1c83">
