<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="dbec4bb5-4640-4445-bda3-f1dc5f356e16">
  <data key="d2">fact_entity</data>
  <data key="d4">ACTION</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="c6306cf4-9c90-46b8-bbaa-b5eda7629ead">
  <data key="d2">fact_entity</data>
  <data key="d4">DOCUMENT</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="b3624321-259b-4e56-a62d-3a38ecf9128c">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="690d0e22-8406-41f1-b28f-d2a8b9a22067">
  <data key="d2">fact_entity</data>
  <data key="d4">EXCLUSION</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="c4d13a8d-3eee-48c1-9d72-1dbfb0285e1b">
  <data key="d2">fact_entity</data>
  <data key="d4">EXCLUSION</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="c3bfa2f0-13cb-4479-abba-208e5eb2c75b">
  <data key="d2">fact_entity</data>
  <data key="d4">EXCLUSION</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="8d2affe0-cbd3-4c8d-a431-65426463f3fb">
  <data key="d2">fact_entity</data>
  <data key="d4">RIGHT</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="196875a2-9e2d-412b-bee7-7d825e77df84">
  <data key="d2">fact_entity</data>
  <data key="d4">LEGAL_NOTICE</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="1f71e65a-9fb1-4dcf-bb24-91800bb3f3c7">
  <data key="d3">The prohibition against concealing material facts applies regardless of which company issues the policy, so it has no bearing on Sentinel Life's role as the issuer.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="20fbfea1-87f5-44e4-993f-62b3ff2e28ee">
  <data key="d3">Fraudulent acts involving concealment of material facts are legally prohibited regardless of when the policy became effective.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="05e6ea4e-3679-424b-a1ef-cd15cb0268c9">
  <data key="d3">Intentional concealment of material facts leading to fraud is unrelated to whether the initial premium has been paid to activate the policy.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="57f1482e-c194-4d7c-89bc-95a96701db5d">
  <data key="d3">Intentional concealment of material facts undermines the legitimacy of the entire application process, including conditions like surviving to the effective date, though it doesn't directly affect that specific timing criterion.</data>
  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="d3c440cf-41e3-4d0b-a3f0-ad9eb7117fb9">
  <data key="d3">Fact_sentence_2 outlines a prohibited conduct involving intentional deception in insurance claims. This general rule has no bearing on identifying or referencing a specific policy form number.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="4be625d8-db33-4685-8ec1-310ef9190d46">
  <data key="d3">Fraudulent concealment of material facts violates universal standards across jurisdictions; such acts remain illegal even when supplemented by state-specific disclosures.</data>
  <data key="d4">IRRELEVANT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="abd6a771-b2cc-4b47-8455-fa725fb92dac">
  <data key="d3">Fraudulent acts involving concealment of information violate insurance law regardless of whether optional riders exist on the policy.</data>
  <data key="d4">UNRELATED</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="868545fb-b90c-4d86-aa47-b3fa5811f814">
  <data key="d3">Fact_sentence_2 warns about fraudulent behavior in insurance, which may include misuse of riders such as the Accelerated Death Benefit. Fact_sentence_1 presents that rider as a legitimate benefit under defined conditions.</data>
  <data key="d4">APPLIES_TO</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.25</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="e7abe25a-548e-4854-99a9-005d2c7abd86">
  <data key="d3">Fraudulent acts like concealing key information undermine the integrity of insurance systems, including mechanisms like the accelerated death benefit rider designed to provide timely financial support.</data>
  <data key="d4">CONSTRAINS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.45</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="bb127988-dd0c-41ea-98d9-d68d41d35ba5">
  <data key="d3">Intentional concealment of material facts undermines the legitimacy of any claim, including those made under the terminal illness qualification described in fact_sentence_1.</data>
  <data key="d4">PREVENTS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="a82e95a0-cbf0-46a4-98e6-5b9250a0719c">
  <data key="d3">Fact_sentence_2 imposes legal accountability on applicants who withhold key details about health status, reinforcing the necessity of truthful disclosure when qualifying under criteria like those stated in fact_sentence_1.</data>
  <data key="d4">REINFORCES CONDITION</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.45</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="24953031-60ae-4e53-8878-b13b08a99bb6">
  <data key="d3">Intentional concealment of material facts undermines the validity of medical certifications required for benefit payouts, making such actions incompatible with legitimate use of the accelerated death benefit process described in fact_sentence_1.</data>
  <data key="d4">UNDERMINES_PROCESSING</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="9c8ab001-f2e6-4dce-9c28-676af9b34008">
  <data key="d3">Fact_sentence_2 highlights the legal risk associated with dishonesty when applying for accelerated benefits. This caution indirectly supports the enforcement of rules like those stated in fact_sentence_1, ensuring accurate disclosure so payouts remain legitimate.</data>
  <data key="d4">REINFORCES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.3</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="8c21a23d-34f1-400e-8692-3b5af49dbb3d">
  <data key="d3">Committing fraud by hiding material facts has no direct impact on the maximum allowable payment under the rider; it affects eligibility and legality rather than the predefined monetary threshold.</data>
  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="07aa45e3-df8b-4fdc-a2d7-4ebdc9b4974f">
  <data key="d3">Intentionally hiding material information invalidates the legitimacy of any claim submission, including the required written request for benefits.</data>
  <data key="d4">INVALIDATES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="221c721d-0cca-43e4-9fde-c98c985d9e46">
  <data key="d3">Intentional deception about health status invalidates the credibility of required medical documentation, jeopardizing eligibility for benefits.</data>
  <data key="d4">CAUSES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="c49d35db-1e22-49cf-aff0-80eed3363f59">
  <data key="d3">Intentional deception undermines the legitimacy of a claim, so insurers use mechanisms like second opinions to detect such behavior during the evaluation process.</data>
  <data key="d4">ENFORCES VERIFICATION</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="c24c3db2-61fe-4fe8-b84c-a66c833de08e">
  <data key="d3">Intentional concealment of material facts is considered fraud and could result in disqualification from receiving an accelerated benefit, thereby avoiding any reduction in the death benefit.</data>
  <data key="d4">CAUSES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.3</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="5959382c-3da3-4378-9d27-70eeead2dc9c">
  <data key="d3">Intentionally hiding material information undermines the legitimacy of any claim, including those involving accelerated benefits. Such actions risk invalidating payouts, even if administrative charges were otherwise applicable.</data>
  <data key="d4">MAY_LEAD_TO_DENIAL</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.25</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="8690a7f5-82be-413d-a92b-8be70122f5aa">
  <data key="d3">The second sentence establishes a legal standard regarding fraud through concealment of material facts. This principle may indirectly inform why certain conditions like falsified medical reports could invalidate benefits, though it doesn't affect the stated interest-reduction rule.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="fa4bdb40-ec63-4909-8c9d-03d63650997f">
  <data key="d3">Fact_sentence_2 identifies concealment of key details as fraudulent behavior, whereas fact_sentence_1 outlines how unpaid loans impact final payouts. Though both pertain to rider conditions, one governs conduct and the other calculates benefits without mutual influence.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="74ab917d-fe31-437b-954d-cb3c8c3a0cc2">
  <data key="d3">Fact_sentence_2 defines fraudulent conduct involving deliberate concealment of key details, which could impact eligibility for benefits but is unrelated to the mechanical deduction of liens from the death benefit.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="3d180056-1ee5-45c0-95de-957558f0d6c0">
  <data key="d3">Intentional concealment of material facts, including those about self-inflicted injuries, may lead to denial of benefits due to fraud, reinforcing that self-harm-related illnesses are not eligible for payouts.</data>
  <data key="d4">REINFORCES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="147ebded-c5e9-4ee9-a600-a0613a4ac44b">
  <data key="d3">Intentionally concealing important facts qualifies as insurance fraud, which may disqualify a claim even if the illness meets clinical criteria, including cases where the illness resulted from criminal activity.</data>
  <data key="d4">PRESERVES_CONDITIONS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="097f621e-9ee5-4ea1-bb84-d692f67b9f5b">
  <data key="d3">Intentional concealment of material facts is considered fraud, which could result in denial of benefits—even if the illness were otherwise qualifying, such as one caused by war.</data>
  <data key="d4">CONTRIBUTES_TO_DENIAL</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="cf34ad84-8215-4856-9bd3-153061d00093">
  <data key="d3">Intentional concealment of material facts violates insurance law, even though policyholders retain the right to cancel benefit requests before payout.</data>
  <data key="d4">NO_DIRECT_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="42959f78-4be8-4477-9f82-ca39bf16f6b5">
  <data key="d3">Intentional concealment of material facts leading to fraud is unrelated to the administrative procedure of submitting written revocation notices.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="d40a8a1d-b256-47c5-bcc2-7c565e18e4a6">
  <data key="d3"></data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="70e7fe46-b6c6-4910-8fcf-5836a44a1382">
  <data key="d3">The concept of concealing material facts to deceive does not connect to the identity or position of any specific corporate officer mentioned.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="4dda5c60-5f9a-445b-896e-afcf680b072f">
  <data key="d3">The legal principle that concealment amounts to fraud does not depend on where the policy was signed or processed.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="7baa8b25-9b01-472b-86a7-c55acdb29369">
  <data key="d3">Fact_sentence_2 generalizes the concept of fraud beyond outright falsehoods to include deliberate omissions, thereby encompassing the scenario described in fact_sentence_1.</data>
  <data key="d4">EXPANDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="4842aa86-8d77-49f2-8517-35dcccfe1dcd">
  <data key="d3">Fact_sentence_1 describes concealing key information to deceive; fact_sentence_2 expands on this by specifying that actively providing false statements also qualifies as fraud, reinforcing the principle established in sentence one.</data>
  <data key="d4">EXEMPLIFIES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="cfcb3d69-6bc4-465d-b7ca-f58645d5d6ee">
  <data key="d3">Fact_sentence_1 identifies concealment of material facts with intent as fraudulent behavior. Fact_sentence_2 explains that committing such an act requires awareness of falsity or concealment concerning those facts.</data>
  <data key="d4">EXPLAINS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="df9797d7-629e-4917-bc56-582d8cf4fe9d">
  <data key="d3">Fact_sentence_1 establishes the definition of a fraudulent insurance act, providing a standard by which the claim in fact_sentence_2 may be evaluated. The occurrence of a fraudulent act aligns with the criteria outlined in fact_sentence_1, suggesting potential applicability.</data>
  <data key="d4">CORROBORATES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="de0d67af-5b66-4374-8edd-cc82b199731b">
  <data key="d3">The general prohibition on concealing material facts to commit insurance fraud provides a legal framework that applies to high-level executives like Eleanor B. Raynor, who holds leadership responsibilities at Sentinel Life Assurance Company. Her position makes her accountable for ensuring compliance with anti-fraud policies.</data>
  <data key="d4">DEPENDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="9e3cd4f3-d236-4040-a6c4-c46f3a22a611">
  <data key="d3">The principle that hiding material facts amounts to insurance fraud provides a legal framework relevant to evaluating whether Eleanor B. Raynor's position as an authorized representative could involve such misconduct.</data>
  <data key="d4">CONTEXTUAL_RELEVANCE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="f2b2eda1-ace9-416b-a284-68313b16efe9" target="57fafae6-d83d-473d-a0a2-e4e4d1824c40">
  <data key="d3">The general principle that concealment of facts amounts to insurance fraud provides legal grounding relevant to evaluating whether actions by representatives like Eleanor B. Raynor could constitute misconduct within Sentinel Life's operations.</data>
  <data key="d4">CONTEXTUAL_RELEVANCE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="66adf0d1-245f-4bda-b328-4b22ac8d87e8" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">is subject to</data>
</edge>
<edge source="c8782578-7313-409f-befa-ea0d5529486f" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">may have engaged in</data>
</edge>
<edge source="d4f214d4-94d7-4b08-b2dc-a893eb888328" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">could be responsible for</data>
</edge>
<edge source="3bb7ec49-97a2-44d4-bd74-3a7731ef94bc" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">involves material facts concerning</data>
</edge>
<edge source="6f662595-2cb8-4cb8-ab1c-6e9fd5b937e0" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">is a material fact potentially concealed</data>
</edge>
<edge source="4e377290-b352-4d34-baa6-571ef428b584" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">subject_of_concealment</data>
</edge>
<edge source="98fc291e-a3ca-41d0-b41d-4a34a047a74f" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">jurisdiction_for_fraudulent_act</data>
</edge>
<edge source="5912db92-0eaf-4e9b-915e-834e6ceba942" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">material_fact_subject_to_concealment</data>
</edge>
<edge source="d61d6c47-c109-4681-b1ee-bda923c6d8a1" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">material_fact_subject_to_concealment</data>
</edge>
<edge source="dbec4bb5-4640-4445-bda3-f1dc5f356e16" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">document_in_which_misrepresentation_occurs</data>
</edge>
<edge source="c6306cf4-9c90-46b8-bbaa-b5eda7629ead" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">conceals</data>
</edge>
<edge source="b3624321-259b-4e56-a62d-3a38ecf9128c" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">conceals</data>
</edge>
<edge source="690d0e22-8406-41f1-b28f-d2a8b9a22067" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">conceals</data>
</edge>
<edge source="c4d13a8d-3eee-48c1-9d72-1dbfb0285e1b" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">conceals</data>
</edge>
<edge source="c3bfa2f0-13cb-4479-abba-208e5eb2c75b" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">conceals</data>
</edge>
<edge source="8d2affe0-cbd3-4c8d-a431-65426463f3fb" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
  <data key="d2">entity_fact</data>
  <data key="d4">can be exercised due to</data>
</edge>
<edge source="196875a2-9e2d-412b-bee7-7d825e77df84" target="f2b2eda1-ace9-416b-a284-68313b16efe9">
