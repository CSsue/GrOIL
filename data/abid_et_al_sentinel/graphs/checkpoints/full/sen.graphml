  <data key="d3">Accurate statements in the application form the basis for issuing the policy, allowing the insurer to later use that information to validate or dispute coverage during the incontestability period.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
