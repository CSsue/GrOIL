</edge>
<edge source="ea7568f9-97e8-481c-ba9d-673126fb9ca4" target="f36a1664-7f6f-4d19-a228-86f3f28f271d">
  <data key="d3">Changing a beneficiary becomes effective immediately upon submission, independent of the insured’s life status. This action does not affect the policy owner’s separate right to cancel the policy at any time through formal notification.</data>
  <data key="d4">INDEPENDENT_RIGHTS</data>
  <data key="d2">fact_fact</data>
