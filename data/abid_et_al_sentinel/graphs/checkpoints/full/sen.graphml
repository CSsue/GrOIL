  <data key="d2">entity_fact</data>
  <data key="d4">maintains</data>
</edge>
<edge source="f365e6ea-e31d-4ce0-886c-00af8f2b3451" target="2355dc3f-af2e-4eda-b96d-fd3204fa6b8e">
  <data key="d2">entity_fact</data>
  <data key="d4">prevents</data>
</edge>
<edge source="5b78b315-e08c-4645-bef5-667102878ab9" target="2355dc3f-af2e-4eda-b96d-fd3204fa6b8e">
  <data key="d2">entity_fact</data>
  <data key="d4">governs</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="6f708783-8736-4a37-9a85-ac14241b1f98">
  <data key="d2">fact_entity</data>
  <data key="d4">ORGANIZATION</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="8fa923a7-9301-4d68-88ea-bed00e6a4dfb">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="76a355d2-92fc-42e7-830a-ec07a8216a0c">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="009136d3-5020-4835-a263-f163054f9d6f">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="33d7e865-f33f-41b5-b376-b3e64f1b7b72">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="8fa75a4d-9f8a-4100-a572-0629351b2337">
  <data key="d2">fact_entity</data>
  <data key="d4">DATE</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="c93f994a-ad7d-45da-9790-104f6cdc5539">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="c7bedae7-8905-4ef7-a4f4-d1cdd4a16c39">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
