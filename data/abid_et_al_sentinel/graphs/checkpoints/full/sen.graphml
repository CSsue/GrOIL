<edge source="827c6995-f0dd-4669-b3cd-e64364930b24" target="cf255e83-6bf3-43a7-a0f5-ffa85d8f1f6d">
  <data key="d3">Fact_sentence_2 outlines the prompt payout of the death benefit upon verified death. Fact_sentence_1 clarifies that additional features like automatic premium loans require separate endorsements. Neither statement influences nor depends on the other in terms of operational sequence or conditionality.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
