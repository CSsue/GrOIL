  <data key="d3">Fact_sentence_2 enables reliable validation of terminal illness status, which directly informs whether the conditions for accessing the 50% benefit cap in fact_sentence_1 are met.</data>
  <data key="d4">VALIDATES ELIGIBILITY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
