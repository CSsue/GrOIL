  <data key="d3">Any alteration to the policy’s terms must be documented and signed by an authorized company officer. This requirement applies regardless of whether the policy was returned or remains active.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
