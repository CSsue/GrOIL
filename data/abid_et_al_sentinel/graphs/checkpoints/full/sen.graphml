  <data key="d2">fact_entity</data>
  <data key="d4">RIGHT</data>
</edge>
<edge source="097f621e-9ee5-4ea1-bb84-d692f67b9f5b" target="f16f0d56-0161-4069-86f4-28f4fef02f59">
