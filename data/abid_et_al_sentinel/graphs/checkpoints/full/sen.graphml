  <data key="d3">Requesting premium payment history provides insight into past contributions toward the policy. This informational right operates independently of decisions regarding beneficiary changes.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
