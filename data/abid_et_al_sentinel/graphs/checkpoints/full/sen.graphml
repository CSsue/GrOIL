  <data key="d3">The identification of the beneficiary through formal filing has no bearing on the types of documents required by the company for processing benefits.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
