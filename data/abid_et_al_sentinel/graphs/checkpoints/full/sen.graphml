  <data key="d3">Changing the premium payment mode involves submitting written notification to the insurer; however, this action does not affect how the beneficiary is designated under the policy.</data>
  <data key="d4">UNRELATED</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
