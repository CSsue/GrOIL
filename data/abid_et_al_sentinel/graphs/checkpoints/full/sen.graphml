  <data key="d3">The attachment of an accelerated death benefit rider enhances the policy's utility during critical health events, complementing the long-term stability offered by the 20-year guaranteed premium period.</data>
  <data key="d4">COMPLEMENTARY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
