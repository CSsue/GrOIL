  <data key="d2">fact_entity</data>
  <data key="d4">DATE</data>
</edge>
<edge source="0e6c34e9-34ee-4684-a4db-b8f932cd319e" target="85f9c4db-f78e-47e5-9501-c9297f0f4c28">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="0e6c34e9-34ee-4684-a4db-b8f932cd319e" target="8eb24745-a950-4a6e-a9a2-447a0e6a0467">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="0e6c34e9-34ee-4684-a4db-b8f932cd319e" target="cef91aa1-a198-4101-b9d6-e449268e8f22">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
