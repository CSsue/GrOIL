  <data key="d4">CONCEPT</data>
</edge>
<edge source="b8a0acec-5bad-4385-aa38-b690f03f26b5" target="46b37e96-8f60-4371-82fc-83e368f5d188">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="b8a0acec-5bad-4385-aa38-b690f03f26b5" target="042c2bd9-daa1-40e7-ac4d-35e99984da2d">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
