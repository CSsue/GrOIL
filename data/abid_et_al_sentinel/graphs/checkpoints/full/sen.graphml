  <data key="d3">The company commits to providing information according to legal standards, which operates independently of how quickly or under what conditions beneficiary changes are processed.</data>
  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
