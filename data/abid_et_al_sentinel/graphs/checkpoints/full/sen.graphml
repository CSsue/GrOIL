  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="7dd274eb-79fa-4549-9a30-e662efe45594" target="671dbf69-e342-4817-831a-ee5801f7be5f">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
