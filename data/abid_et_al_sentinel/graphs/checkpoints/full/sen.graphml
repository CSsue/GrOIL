  <data key="d3">A request for benefits requires verified medical evidence, and submitting false or concealed information undermines this requirement, constituting fraud.</data>
  <data key="d4">MODIFIES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
