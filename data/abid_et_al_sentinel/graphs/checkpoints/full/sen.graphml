  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="b8a0acec-5bad-4385-aa38-b690f03f26b5" target="14ae15f5-f079-4d5e-bb01-e76604fd7ec0">
