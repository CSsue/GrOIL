</edge>
<edge source="dc7d257a-6a88-40ef-9995-0d6cef3ac4dd" target="172b9278-1d92-4151-bb1c-57052cd17f3d">
  <data key="d3">The guaranteed stability of premiums over the term implies financial predictability tied directly to the policy’s lifespan, which concludes at the end of the term if not extended.</data>
  <data key="d4">DEPENDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
