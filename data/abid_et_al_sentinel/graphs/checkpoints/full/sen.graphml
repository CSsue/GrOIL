  <data key="d3">The policy owner has the right to obtain premium payment history, and the company is obligated to supply this data when requested, complying with relevant laws.</data>
  <data key="d4">FULFILLS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
