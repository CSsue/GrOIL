  <data key="d5">0.0</data>
</edge>
<edge source="c81dbb82-548f-41f6-8919-0493d10f9c59" target="e6149469-d151-4d22-aff3-fb7f2901e4bd">
  <data key="d3">This statement confirms the insurer’s duty to release information compliant with law. It has no connection to how or to whom the death benefit is distributed.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="c81dbb82-548f-41f6-8919-0493d10f9c59" target="0c2f9120-31fb-43ab-81cd-fae794c65930">
  <data key="d3">Sentence 2 states the insurer's duty to release information under law, independent of how or to whom the death benefit is distributed.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
