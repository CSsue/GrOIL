  <data key="d3">Submitting proof of death is necessary for claiming benefits after the insured’s passing, regardless of how often premiums were originally paid.</data>
  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
