  <data key="d3">Payment of the death benefit requires that the policy remain in force at the time of death. Reinstatement after lapse would only matter if the individual died after reinstatement but before the new effective date, making it irrelevant to benefits paid from active policies.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
