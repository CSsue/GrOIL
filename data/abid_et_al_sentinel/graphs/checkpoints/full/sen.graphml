  <data key="d3">Fact_sentence_1 sets a universal standard requiring written documentation for policy changes, which fact_sentence_2 enforces by explicitly prohibiting agents and brokers from making modifications, thereby ensuring compliance with the written requirement.</data>
  <data key="d4">SUPPORTS</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
