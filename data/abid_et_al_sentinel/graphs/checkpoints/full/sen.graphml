<edge source="401085bd-ec9b-4194-a332-d312acf2f556" target="e6dc59e3-a8f4-4f56-940d-46199cdc1c83">
  <data key="d3">The death benefit being paid to the beneficiary occurs independently of whether the policy was previously reinstated or required repayment of overdue premiums.</data>
  <data key="d4">INDEPENDENT</data>
