  <data key="d3">Approval from the company is required before altering the settlement method, independent of any prior assignment agreements affecting ownership rights.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
