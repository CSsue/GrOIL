  <data key="d3">The promise to pay the death benefit depends on the policy being in force, which may only occur if reinstated under terms like those requiring payment of past-due premiums with interest.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
