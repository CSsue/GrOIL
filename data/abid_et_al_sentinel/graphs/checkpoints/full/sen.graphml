  <data key="d3">The company agrees to supply policy copies within a reasonable period when requested by the policy owner.</data>
  <data key="d4">FOLLOWS_FROM</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
