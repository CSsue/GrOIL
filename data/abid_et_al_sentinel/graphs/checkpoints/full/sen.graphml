  <data key="d3">Sentence 1 defines the fallback payment destination when no beneficiary survives, while Sentence 2 establishes that any beneficiary update becomes effective at the time of signing, ensuring timely implementation of such decisions.</data>
  <data key="d4">CONDITIONAL_DEPENDENCY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
