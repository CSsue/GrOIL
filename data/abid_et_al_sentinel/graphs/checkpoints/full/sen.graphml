</edge>
<edge source="b1aa54d6-2e04-4f72-a8ff-fe05054ce5b3" target="9c8ab001-f2e6-4dce-9c28-676af9b34008">
  <data key="d3">The existence of the Accelerated Death Benefit Rider enables early access to benefits, but its payout is capped at half the policy's face value, limiting the total amount available upon qualifying conditions.</data>
  <data key="d4">DEPENDS_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
