</edge>
<edge source="69580977-8680-4303-b27e-16864466b8e8" target="b2835f9b-be1f-42a0-910e-c6e995ace28d">
  <data key="d3">Returning the policy within 20 days results in a full refund, which only applies because the policy grants the owner a 20-day examination period to evaluate its terms before commitment.</data>
  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="69580977-8680-4303-b27e-16864466b8e8" target="d31837ea-1599-48d9-acef-f6708a189681">
  <data key="d3">A full refund of premiums is issued when the policy is returned within 20 days, contingent upon the owner's dissatisfaction with the policy.</data>
  <data key="d4">RESULT_OF</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="69580977-8680-4303-b27e-16864466b8e8" target="65938361-ed69-4ef2-88b7-4494b82bd742">
  <data key="d3">Returning the policy within 20 days triggers a full refund and causes the policy to be voided effective from its start date.</data>
  <data key="d4">CAUSES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="69580977-8680-4303-b27e-16864466b8e8" target="12ebf888-5542-48cf-a3ae-6bbbc3b648b6">
  <data key="d3">Returning the policy within 20 days results in a full refund, and under such circumstances, the policy is legally considered not to have been issued at all.</data>
  <data key="d4">CAUSES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
