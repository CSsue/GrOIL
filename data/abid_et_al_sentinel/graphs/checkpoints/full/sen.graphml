  <data key="d3">The requirement to provide evidence of insurability allows for the possible reinstatement of a policy that was otherwise voided upon return.</data>
  <data key="d4">ENABLES_RECOVERY</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
