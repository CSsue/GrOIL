  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="401085bd-ec9b-4194-a332-d312acf2f556" target="5e097a82-f754-43e4-905d-5d147b217df4">
  <data key="d3">The death benefit payout to the beneficiary depends on providing documentation deemed necessary by the insurance company. Without meeting these documented requirements, the payment cannot proceed despite the policy being active.</data>
  <data key="d4">CONDITIONAL_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="401085bd-ec9b-4194-a332-d312acf2f556" target="9a0ec08d-cc0c-4623-90af-479513e70439">
  <data key="d3">The death benefit being payable to the beneficiary sets the stage for interest accumulation, which starts at the moment of death and continues until disbursement.</data>
  <data key="d4">PRECEDES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
