  <data key="d4">NO_RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="827c6995-f0dd-4669-b3cd-e64364930b24" target="defb9349-5ec2-419c-99cf-a721b93806df">
  <data key="d3">Fact_sentence_2 adds detail about timely processing and the standard of proof (“satisfactory”) when paying the death benefit. Fact_sentence_1 provides the foundational rule that payment follows receipt of due proof, forming the basis for the refinement in fact_sentence_2.</data>
