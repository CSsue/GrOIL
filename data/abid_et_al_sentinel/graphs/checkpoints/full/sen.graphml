  <data key="d4">PERSON</data>
</edge>
<edge source="0e6c34e9-34ee-4684-a4db-b8f932cd319e" target="ba8b41eb-b654-49ed-a1de-e0d215cea721">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
