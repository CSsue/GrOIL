  <data key="d3">Failure to pay a premium results in policy lapse at the end of the grace period, independent of any prior misrepresentations made when applying for the policy.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.15</data>
</edge>
