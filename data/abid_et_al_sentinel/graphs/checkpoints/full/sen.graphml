  <data key="d3">Change of beneficiary becomes effective immediately upon receipt by the company, independent of the insured’s life status. This does not influence how quickly the company provides information about such changes.</data>
  <data key="d4"></data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
