  <data key="d5">0.0</data>
</edge>
<edge source="4be625d8-db33-4685-8ec1-310ef9190d46" target="147ebded-c5e9-4ee9-a600-a0613a4ac44b">
  <data key="d3">State-specific notices might inform applicants about legal conditions affecting benefit eligibility, such as disqualification due to criminal activity. This contextual information could help explain why certain exclusions exist within the rider terms.</data>
  <data key="d4">CONTEXTUAL_RELATED</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.45</data>
</edge>
