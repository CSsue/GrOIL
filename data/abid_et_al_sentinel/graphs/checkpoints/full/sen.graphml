  <data key="d2">fact_entity</data>
  <data key="d4">DOCUMENT</data>
</edge>
<edge source="097f621e-9ee5-4ea1-bb84-d692f67b9f5b" target="741b364c-c944-4843-8ada-35139f2d828f">
