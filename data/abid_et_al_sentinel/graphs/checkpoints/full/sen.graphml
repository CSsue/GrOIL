<edge source="e6149469-d151-4d22-aff3-fb7f2901e4bd" target="8173134a-e29e-4aa3-9deb-7944def59471">
  <data key="d3">This statement specifies that the policy owner inherits the death benefit if no beneficiary outlives the insured. This determination occurs independently of any interest calculations outlined in the first sentence.</data>
  <data key="d4">NONE</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
