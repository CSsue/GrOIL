  <data key="d4">ORGANIZATION</data>
</edge>
<edge source="f0a5245e-9eeb-422b-b2ca-4304e824a7be" target="b6097e0a-7a21-4497-83cb-1b2e0a99975e">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
