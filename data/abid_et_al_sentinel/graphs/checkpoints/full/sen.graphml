  <data key="d5">0.0</data>
</edge>
<edge source="d31837ea-1599-48d9-acef-f6708a189681" target="432e1a1f-f7e9-4036-bcfa-49b2340827f2">
  <data key="d3">Fact_sentence_1 describes the right to cancel a newly received policy within 20 days for a full refund. Fact_sentence_2 explains that even after a policy lapses due to missed payments, it can still be reinstated within five years under certain conditions. These represent separate procedural safeguards without direct causal or sequential dependence.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
