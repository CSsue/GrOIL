  <data key="d3">The death benefit being paid to the beneficiary occurs after the insured’s death under active coverage conditions; however, this event is independent of any prior decisions about premium payment frequency.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
