</edge>
<edge source="65acf9bc-e764-4677-987e-baf89f2e6822" target="b2835f9b-be1f-42a0-910e-c6e995ace28d">
  <data key="d3">Reinstating a lapsed policy requires demonstrating insurability, regardless of whether the owner exercised the initial 20-day examination privilege.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="65acf9bc-e764-4677-987e-baf89f2e6822" target="d31837ea-1599-48d9-acef-f6708a189681">
  <data key="d3">Reinstating a lapsed policy requires medical evidence but does not affect the original 20-day right to return the policy; one event cannot trigger or negate the other.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
<edge source="65acf9bc-e764-4677-987e-baf89f2e6822" target="69580977-8680-4303-b27e-16864466b8e8">
  <data key="d3">Reinstatement requires medical evidence of insurability, unrelated to the initial 20-day refund window. The ability to get a refund does not affect or condition reinstatement eligibility.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
