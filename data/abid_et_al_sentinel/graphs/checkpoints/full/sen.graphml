  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="691ac7f0-573b-4d26-abde-28f5eabaea4f" target="5dffec7c-e19d-49e2-a477-de20cb3f6396">
