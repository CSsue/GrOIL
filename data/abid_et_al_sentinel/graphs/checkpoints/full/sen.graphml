  <data key="d3">While beneficiary designations take immediate effect without regard to the insured’s life status, any modification to how benefits are paid out requires formal authorization from the insurer.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
