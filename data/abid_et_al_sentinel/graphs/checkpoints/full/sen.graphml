  <data key="d4">ENABLES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="b2604be3-8c9d-411a-9752-e7c408e44f8a" target="691ac7f0-573b-4d26-abde-28f5eabaea4f">
  <data key="d3">The policy’s issuance and enforceability rely on the payment of the first premium, enabling subsequent actions such as renewal or conversion under agreed-upon contract terms.</data>
  <data key="d4">ENABLING_CONDITION</data>
