  <data key="d3">Interest accruing on the death benefit from the date of death onward is independent of the policyholder’s choice of premium payment frequency or method.</data>
  <data key="d4">NO RELATIONSHIP</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
