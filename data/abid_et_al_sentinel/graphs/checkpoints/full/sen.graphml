<edge source="3ac57c69-3ec6-47e1-9a1c-8e288edc1b2b" target="fb72e3f0-f7b4-42f1-8874-ebac56171d8b">
  <data key="d3">An Automatic Premium Loan ensures that unpaid premiums are covered during the grace period, preventing policy lapse and thus preserving the option to reinstate the policy within five years.</data>
  <data key="d4">PREVENTS_LAPSE</data>
  <data key="d2">fact_fact</data>
