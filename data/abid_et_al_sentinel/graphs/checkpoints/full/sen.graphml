  <data key="d3">Any change to the policy’s conditions, including those affecting premiums, must be formally approved in writing; however, this rule does not alter the predetermined nature of level premiums during the guarantee period.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
