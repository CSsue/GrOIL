  <data key="d5">0.0</data>
</edge>
<edge source="8690a7f5-82be-413d-a92b-8be70122f5aa" target="abd6a771-b2cc-4b47-8455-fa725fb92dac">
  <data key="d3">While fact_sentence_2 explains how interest reduces the death benefit after an acceleration payment, this detail assumes the existence of a rider enabling early payouts—such as the one referenced in fact_sentence_1—but does not rely directly on its mention.</data>
  <data key="d4">ASSUMES</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.3</data>
</edge>
