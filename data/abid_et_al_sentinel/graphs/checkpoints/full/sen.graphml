  <data key="d3">Providing proof of death is necessary only when filing a death claim, independent of whether premiums were paid regularly. It has no bearing on the scheduling or recurrence of future premium due dates.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
