  <data key="d3">Changing the premium payment mode necessitates notifying the company, and any extra documents needed for this process are determined by the company’s reasonable requirements.</data>
  <data key="d4">CONDITIONAL_ON</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
