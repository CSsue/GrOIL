<edge source="65acf9bc-e764-4677-987e-baf89f2e6822" target="b12e9b16-bbb5-4f46-b60c-3a7549f861c6">
  <data key="d3">Reinstating a lapsed policy requires proof of insurability, independent of who owns the policy; thus, it does not rely on or modify the default ownership provision.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
