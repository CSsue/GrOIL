  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="868f08e9-36d3-467e-b294-c7c444fbdbc0">
  <data key="d2">fact_entity</data>
  <data key="d4">PERSON</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="abd7d50b-ec2e-42ed-bb35-916b83a07be9">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="1600a265-26fa-443c-b324-cdc15537292c">
  <data key="d2">fact_entity</data>
  <data key="d4">DATE</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="e8a156dc-495d-4f55-9e95-a9df3556afed">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="f179b3a8-d715-4622-b45a-7e29066e1276">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
<edge source="b160aaee-2bb3-42d4-99f1-e1274612ebc3" target="e6c28f10-97c9-4be8-8305-863d2b28de80">
  <data key="d2">fact_entity</data>
  <data key="d4">CONCEPT</data>
</edge>
