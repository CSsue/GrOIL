<edge source="ea7568f9-97e8-481c-ba9d-673126fb9ca4" target="925dc2ea-b455-4473-b4ed-51ff493dd9eb">
  <data key="d3">Beneficiary changes become effective immediately upon receipt, independent of the insured's condition. This contrasts with settlement option changes, which require prior approval from the insurance company before taking effect.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
