  <data key="d3">Providing proof of death is a necessary step for claiming benefits after the insured passes away. This obligation exists independently of the previously selected premium payment mode.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
