  <data key="d3">An accelerated death benefit rider provides partial access to the policy’s $500,000 death benefit when certain medical criteria are met, supplementing the base coverage amount.</data>
  <data key="d4">INDEPENDENT</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.0</data>
</edge>
