  <data key="d2">entity_fact</data>
  <data key="d4">loses coverage due to policy lapse</data>
</edge>
<edge source="9e4e84fa-aba2-44c8-bfc7-55dbf46fadcf" target="18dba2f2-8e4f-4bcc-9c25-79f3830d6409">
  <data key="d2">entity_fact</data>
  <data key="d4">may lose benefit entitlement due to policy lapse</data>
</edge>
