  <data key="d3">The inclusion of the application within the Entire Contract reflects its essential role in justifying the policy’s issuance and validating its terms.</data>
  <data key="d4">REQUIRED_FOR</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
