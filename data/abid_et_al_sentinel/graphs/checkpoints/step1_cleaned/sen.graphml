  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="73bb717f-ccc3-4d83-a6ca-8ece25be0884" target="82c9a3a6-fc04-4d04-98d0-4b2ff8116a28">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="73bb717f-ccc3-4d83-a6ca-8ece25be0884" target="cc069652-70c3-494a-baf9-75481edf339a">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="73bb717f-ccc3-4d83-a6ca-8ece25be0884" target="022f5ef9-6d3c-4a98-96e6-d1e8d9856d43">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="73bb717f-ccc3-4d83-a6ca-8ece25be0884" target="9d96c362-bfe3-41ef-b4fe-1388a96cdfe0">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
