  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="67535076-c012-4f51-9fca-3da547334acf" target="76f1703f-4aa8-4c8a-90f2-5e7efb3fff5b">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
