  <data key="d2">entity_fact</data>
  <data key="d4">subject to exclusion</data>
</edge>
<edge source="70b0d428-6f91-4373-b5f5-272502e6b564" target="097f621e-9ee5-4ea1-bb84-d692f67b9f5b">
  <data key="d2">entity_fact</data>
  <data key="d4">triggers evaluation of exclusion</data>
</edge>
