  <data key="d3">Fact_sentence_2 provides the temporal framework allowing reinstatement within five years, which enables the application of fact_sentence_1’s rule about paying interest on overdue premiums.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
