  <data key="d2">fact_entity</data>
  <data key="d4">document</data>
</edge>
<edge source="3d180056-1ee5-45c0-95de-957558f0d6c0" target="129bd984-001c-45e5-84a7-fe4ffa451213">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
