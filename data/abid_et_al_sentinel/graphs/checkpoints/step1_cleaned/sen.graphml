  <data key="d3">Outstanding liens are deducted when adjusting the death benefit after acceleration, similar to how administrative charges are accounted for in reducing the total payout.</data>
  <data key="d4">modifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
