  <data key="d2">entity_fact</data>
  <data key="d4">limits liability for validity of assignment</data>
</edge>
<edge source="006726a1-78f9-40f9-b10b-7ebfddf28802" target="376c30b4-9340-49c7-86af-f148910aff82">
  <data key="d2">entity_fact</data>
  <data key="d4">may exercise assignment rights without company guarantee</data>
</edge>
<edge source="59bbe6ab-553e-4a8e-92ae-1f303d077f28" target="376c30b4-9340-49c7-86af-f148910aff82">
  <data key="d2">entity_fact</data>
  <data key="d4">subject to liability limitation</data>
</edge>
