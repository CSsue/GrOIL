  <data key="d3">As the issuing entity, Sentinel Life Assurance Company has authority over policy terms, including establishing the maximum amount payable under the Accelerated Death Benefit Rider.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
