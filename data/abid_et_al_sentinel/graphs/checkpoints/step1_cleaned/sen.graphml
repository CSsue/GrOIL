  <data key="d3">The policy’s issuance relies on accurate application content, which may impact future options like renewal or conversion if misrepresentations exist.</data>
  <data key="d4">enables</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
<edge source="2916fbaf-1ddb-4b5c-b5a0-43f4f0d1cbbc" target="25f4cee7-d9c0-44f5-9b59-9dd48a31e12d">
  <data key="d3">The policy’s issuance relies on accurate application statements, meaning any inaccuracies may result in excluded benefits per policy terms.</data>
  <data key="d4">conditions</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
