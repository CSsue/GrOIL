<edge source="1f71e65a-9fb1-4dcf-bb24-91800bb3f3c7" target="c49d35db-1e22-49cf-aff0-80eed3363f59">
  <data key="d3">The identity of the issuing company establishes the legal context under which benefits are administered, including provisions like obtaining a second medical opinion. This administrative authority enables the insurer to enforce such requirements without direct dependence on the company's name.</data>
  <data key="d4">governing entity</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
