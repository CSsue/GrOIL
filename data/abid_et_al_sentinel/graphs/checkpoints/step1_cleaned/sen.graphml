  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="6a9afb13-0376-4ed6-a2cc-d6e5d5c6b68b">
  <data key="d2">fact_entity</data>
