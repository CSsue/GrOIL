  <data key="d2">fact_entity</data>
  <data key="d4">date</data>
</edge>
<edge source="65a43e84-d268-46ce-900c-06f4538f2516" target="9a9ea91f-ead8-4ce5-b13a-58578fc8a1c0">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
