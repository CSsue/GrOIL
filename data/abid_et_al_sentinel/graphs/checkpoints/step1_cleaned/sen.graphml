  <data key="d2">fact_entity</data>
  <data key="d4">organization</data>
</edge>
<edge source="f501fcfb-9924-4880-8895-de800216cc6b" target="92b034df-df0e-4fb1-84c8-69688d25fe6b">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="f501fcfb-9924-4880-8895-de800216cc6b" target="b2f932c1-e3f8-416a-8900-bd410248a4e6">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="f501fcfb-9924-4880-8895-de800216cc6b" target="a1415b9a-294f-4951-af48-bf575a68b745">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="f501fcfb-9924-4880-8895-de800216cc6b" target="564eec8c-b4e4-43d0-bbac-dc5fe23295f2">
