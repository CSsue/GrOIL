  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="ffa8734c-36ec-49dc-aca1-efd25349e88a" target="de198595-9a5a-41a3-96dd-67e05a611650">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
