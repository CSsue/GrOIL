  <data key="d2">fact_entity</data>
  <data key="d4">financial concept</data>
</edge>
<edge source="c24c3db2-61fe-4fe8-b84c-a66c833de08e" target="6358c391-95b7-45f9-b9ed-6c3440f1b1ff">
  <data key="d2">fact_entity</data>
  <data key="d4">action</data>
</edge>
<edge source="c24c3db2-61fe-4fe8-b84c-a66c833de08e" target="cc302116-54aa-4eab-98fc-0f8d683f9fe8">
  <data key="d2">fact_entity</data>
  <data key="d4">document</data>
</edge>
<edge source="c24c3db2-61fe-4fe8-b84c-a66c833de08e" target="91b53fc7-8c06-4bed-87d1-1935458c7d0b">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="c24c3db2-61fe-4fe8-b84c-a66c833de08e" target="08d06149-42fe-49d8-8079-ba4d97e45f2c">
  <data key="d2">fact_entity</data>
  <data key="d4">exclusion</data>
</edge>
<edge source="c24c3db2-61fe-4fe8-b84c-a66c833de08e" target="af3d3e1f-5c96-48ef-98cb-3e32a2ca6ca5">
  <data key="d2">fact_entity</data>
  <data key="d4">exclusion</data>
</edge>
