  <data key="d4">period</data>
</edge>
<edge source="65938361-ed69-4ef2-88b7-4494b82bd742" target="1bd80f75-412a-4fc5-a57e-189c7740a598">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
