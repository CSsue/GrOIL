</edge>
<edge source="39685e64-b943-45f1-8db8-988a6da844bd" target="f36a1664-7f6f-4d19-a228-86f3f28f271d">
  <data key="d3">Termination of coverage occurs when the policy owner exercises their right to cancel the policy via a formal written notice.</data>
  <data key="d4">result of</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="39685e64-b943-45f1-8db8-988a6da844bd" target="2ff34d5f-b479-4e87-94c4-d2a540372601">
  <data key="d3">When coverage is canceled, it ends immediately, resulting in an end to any future benefit payouts. This termination renders the policy inactive and prevents additional claims or disbursements.</data>
  <data key="d4">precedes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="39685e64-b943-45f1-8db8-988a6da844bd" target="1241bca4-a181-4a4e-9fe3-1834756b497c">
  <data key="d3">When insurance coverage is cancelled, it ends immediately. Any unearned premiums are then eligible for refund according to applicable laws.</data>
  <data key="d4">causes</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
<edge source="e338bc4a-f84d-4f61-ad7e-225750db7762" target="39685e64-b943-45f1-8db8-988a6da844bd">
  <data key="d2">entity_fact</data>
  <data key="d4">coverage terminates when policy is cancelled</data>
</edge>
