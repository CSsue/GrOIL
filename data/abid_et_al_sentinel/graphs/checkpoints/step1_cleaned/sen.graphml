</edge>
<edge source="52a31aaf-1af7-416b-8b31-a19b2a5a1510" target="35b294dc-e18b-451a-85f0-043e5a2acc08">
  <data key="d3">The rule adjusting coverage due to incorrect gender information implies such errors are considered material enough to affect risk evaluation, aligning with the general principle that material misstatements invalidate policies within two years.</data>
  <data key="d4">exemplifies</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
<edge source="52a31aaf-1af7-416b-8b31-a19b2a5a1510" target="f1888ece-7434-4b7e-aebc-5434189a9e7a">
