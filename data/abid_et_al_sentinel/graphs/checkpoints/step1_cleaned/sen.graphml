  <data key="d4">person</data>
</edge>
<edge source="cf255e83-6bf3-43a7-a0f5-ffa85d8f1f6d" target="8a8996a9-aedd-492a-bc42-bd91103215f9">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="cf255e83-6bf3-43a7-a0f5-ffa85d8f1f6d" target="d77236b2-8dd0-492a-87bf-fd19403cd9a2">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="cf255e83-6bf3-43a7-a0f5-ffa85d8f1f6d" target="71d07396-0009-477b-aa54-2c16df41ecad">
  <data key="d2">fact_entity</data>
  <data key="d4">date</data>
</edge>
<edge source="cf255e83-6bf3-43a7-a0f5-ffa85d8f1f6d" target="c90e30e0-4bd3-47b1-b782-428fc210d9b4">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
