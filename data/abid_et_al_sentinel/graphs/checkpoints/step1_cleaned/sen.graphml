  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="2d6cd2a6-4a3a-44fe-aa4e-912059d4a996" target="dfe2050a-652e-40fe-8467-4ce79ee32e7b">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
