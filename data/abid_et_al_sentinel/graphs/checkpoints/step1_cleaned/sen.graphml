  <data key="d5">0.65</data>
</edge>
<edge source="6903f2e1-fcf8-476e-af64-83ccd3093b64" target="1c097ac1-210c-471f-87e7-62f4f7ca9887">
  <data key="d3">The moment a beneficiary change is signed determines its effectiveness, relying on the prior right granted to the policy owner to make such a change.</data>
