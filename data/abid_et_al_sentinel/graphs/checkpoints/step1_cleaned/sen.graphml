  <data key="d3">The presence of an accelerated death benefit rider indicates enhanced benefits under the existing 20-year level term life insurance policy, adding functionality without changing its core structure.</data>
  <data key="d4">enhances</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.85</data>
</edge>
