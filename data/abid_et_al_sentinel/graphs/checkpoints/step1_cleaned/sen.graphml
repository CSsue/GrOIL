  <data key="d4">concept</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="094dcf17-183e-46fc-ba22-7b5fdb7812a4">
  <data key="d2">fact_entity</data>
  <data key="d4">financial concept</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="57d000f6-1232-43ca-812a-36abb1d0ef9c">
  <data key="d2">fact_entity</data>
  <data key="d4">action</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="a793479b-b777-43ef-bcf8-18fe07c8f802">
  <data key="d2">fact_entity</data>
  <data key="d4">document</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="875bf824-69be-48f6-874b-c4f62e5bb88e">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="1c88934d-728e-476d-a38b-3d4d9ba7a56d">
  <data key="d2">fact_entity</data>
  <data key="d4">exclusion</data>
</edge>
<edge source="868545fb-b90c-4d86-aa47-b3fa5811f814" target="4937ba38-2fe9-4223-8b16-7d31e55188e2">
  <data key="d2">fact_entity</data>
  <data key="d4">exclusion</data>
</edge>
