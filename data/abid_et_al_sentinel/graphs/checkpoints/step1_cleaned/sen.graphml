  <data key="d5">0.65</data>
</edge>
<edge source="911c8355-e674-438d-8970-674b61225d1c" target="5e7be213-5b9a-4b27-abe4-07034548f8e7">
  <data key="d3">Understanding settlement option terms requires access to policy details, so the ability to request a policy copy facilitates compliance with and awareness of settlement-related requirements.</data>
  <data key="d4">informs</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
