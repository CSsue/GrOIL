</edge>
<edge source="b9f4573a-344d-4bda-a387-f3c32ffcf8c5" target="9a0ec08d-cc0c-4623-90af-479513e70439">
  <data key="d3">The Death Benefit being subject to policy terms creates the foundation for when and how payments occur, including potential interest accrual post-death. Interest accumulates only if the claim is validated and processed per those terms.</data>
  <data key="d4">conditional on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.75</data>
</edge>
<edge source="b9f4573a-344d-4bda-a387-f3c32ffcf8c5" target="adfc5e3f-7b76-4e27-9e64-1e3c4108cc29">
