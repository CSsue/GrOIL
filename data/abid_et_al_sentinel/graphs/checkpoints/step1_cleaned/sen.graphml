<edge source="52a31aaf-1af7-416b-8b31-a19b2a5a1510" target="8828a9e7-6ada-4747-9993-0ab39713e114">
  <data key="d3">Adjustments for misrepresented gender ensure proper benefit levels based on actual risk factors, complementing the broader principle of policy integrity established by the incontestability clause after two years.</data>
  <data key="d4">modifies</data>
  <data key="d2">fact_fact</data>
