  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
<edge source="d3aeb4da-98f5-49aa-9680-88328bc6317d" target="7f92607e-a713-48f9-865a-d9f4ea885848">
  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
