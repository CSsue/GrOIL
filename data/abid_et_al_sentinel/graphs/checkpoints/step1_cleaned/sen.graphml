  <data key="d3">To qualify for the accelerated benefit capped at 50%, applicants must provide medical evidence accepted by the insurer. This condition enforces compliance with the financial cap defined in fact_sentence_1.</data>
  <data key="d4">conditions</data>
  <data key="d2">fact_fact</data>
