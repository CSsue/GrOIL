  <data key="d4">organization</data>
</edge>
<edge source="e6149469-d151-4d22-aff3-fb7f2901e4bd" target="6b700571-553f-42a4-b7cc-389c879c02d1">
  <data key="d2">fact_entity</data>
  <data key="d4">person</data>
</edge>
