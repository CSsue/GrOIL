  <data key="d3">Fact_sentence_1 identifies the presence of a suicide exclusion in the policy terms, which aligns with fact_sentence_2 detailing its specific financial consequence: only a refund of premiums paid if suicide occurs within two years.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
