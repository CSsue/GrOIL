  <data key="d3">The existence of the Accelerated Death Benefit Rider enables access to benefits upon meeting specific conditions, such as a terminal illness diagnosis, which directly aligns with the qualification described in fact_sentence_2.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
