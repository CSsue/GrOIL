  <data key="d2">fact_entity</data>
  <data key="d4">concept</data>
</edge>
<edge source="73bb717f-ccc3-4d83-a6ca-8ece25be0884" target="0baa6be7-c95f-4316-a1f6-b7cfe2201be7">
