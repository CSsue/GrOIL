  <data key="d3">The rule against altering policy provisions ensures consistency in defining key elements like the effective date, which is formally documented in the Schedule of Benefits.</data>
  <data key="d4">corroborates</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.65</data>
</edge>
