  <data key="d5">0.95</data>
</edge>
<edge source="865d01d3-900e-4d17-895c-7dbb4f659dbc" target="fb72e3f0-f7b4-42f1-8874-ebac56171d8b">
  <data key="d3">The lapse caused by missing a premium payment allows for potential reinstatement within five years, provided terms like overdue payments and insurability are met.</data>
  <data key="d4">depends on</data>
  <data key="d2">fact_fact</data>
  <data key="d5">0.95</data>
</edge>
