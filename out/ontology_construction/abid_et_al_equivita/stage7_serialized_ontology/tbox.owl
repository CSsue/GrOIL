    <owl:someValuesFrom rdf:resource="https://example.org/ontology/insurance#Rate"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#Status">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Status</rdfs:label>
    <rdfs:comment xml:lang="en">A condition or state of a life insurance policy or related entity. Induced from a Placed as subClassOf Event (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A condition or state of a life insurance policy or related entity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Event"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#OptionalBenefitForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Optional Benefit Forms</rdfs:label>
    <rdfs:comment xml:lang="en">A supplementary insurance benefit that can be added to a policy at the policyholder's discretion. Induced from a Placed as subClassOf Rider (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A supplementary insurance benefit that can be added to a policy at the policyholder's discretion.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Rider"/>
  </rdf:Description>
</rdf:RDF>
