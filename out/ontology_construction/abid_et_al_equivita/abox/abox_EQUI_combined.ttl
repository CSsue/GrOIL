abox:ComprehensiveBindingAgreement_EQUI_EntireAgreement a li:ComprehensiveBindingAgreement,
        li:PolicyRightsTransfer ;
    li:dependsOn abox:ComprehensiveBindingAgreement_EQUI_EntireAgreement,
        abox:FormalRelinquishmentOfRightsRequirement_EQUI_Waiver,
        abox:GoverningDocumentReference_EQUI_ThisPolicy,
        abox:PartialEnforceabilityClause_EQUI_Severability ;
    li:labelValue "Entire Agreement"^^xsd:string ;
    li:sourceContractID "EQUI"^^xsd:string .

abox:FormalRelinquishmentOfRightsRequirement_EQUI_Waiver a li:FormalRelinquishmentOfRightsRequirement,
        li:PolicyRightsTransfer ;
    li:dependsOn abox:ComprehensiveBindingAgreement_EQUI_EntireAgreement,
        abox:FormalRelinquishmentOfRightsRequirement_EQUI_Waiver,
        abox:GoverningDocumentReference_EQUI_ThisPolicy,
        abox:PartialEnforceabilityClause_EQUI_Severability ;
    li:labelValue "Waiver"^^xsd:string ;
    li:sourceContractID "EQUI"^^xsd:string .

abox:GoverningDocumentReference_EQUI_ThisPolicy a li:GoverningDocumentReference,
        li:PolicyRightsTransfer ;
    li:dependsOn abox:ComprehensiveBindingAgreement_EQUI_EntireAgreement,
        abox:FormalRelinquishmentOfRightsRequirement_EQUI_Waiver,
        abox:GoverningDocumentReference_EQUI_ThisPolicy,
        abox:PartialEnforceabilityClause_EQUI_Severability ;
    li:labelValue "this Policy"^^xsd:string ;
    li:sourceContractID "EQUI"^^xsd:string .

abox:PartialEnforceabilityClause_EQUI_Severability a li:PartialEnforceabilityClause,
        li:PolicyRightsTransfer ;
    li:dependsOn abox:ComprehensiveBindingAgreement_EQUI_EntireAgreement,
        abox:FormalRelinquishmentOfRightsRequirement_EQUI_Waiver,
        abox:GoverningDocumentReference_EQUI_ThisPolicy,
        abox:PartialEnforceabilityClause_EQUI_Severability ;
    li:labelValue "Severability"^^xsd:string ;
    li:sourceContractID "EQUI"^^xsd:string .

