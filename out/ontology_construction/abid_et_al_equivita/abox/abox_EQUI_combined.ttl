li:Benefit a owl:Class ;
    rdfs:label "Benefit"@en ;
    rdfs:comment "A clause permitting payment to an unspecified recipient. Induced via Stage 6 restriction induction; The clause governs benefit distribution when no specific recipient is designated, directly linking to the process of dis…"@en,
        "A payment or value provided under a life insurance policy upon specified conditions. Induced from a Placed as subClassOf owl:Thing (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:UnspecifiedRecipientClause ;
            owl:someValuesFrom li:BenefitDistribution ],
        owl:Thing ;
    skos:definition "A payment or value provided under a life insurance policy upon specified conditions."@en .

li:DeathBenefit a owl:Class ;
    rdfs:label "Death Benefit"@en ;
    rdfs:comment "Death benefit adjusted for underpayment. Induced via Stage 6 restriction induction; The evidence shows that underpayment triggers a reduction in death benefit, linking the benefit to a condition (Event). The property 'de…"@en,
        "Specifies default payout method when no option is designated. Induced via Stage 6 restriction induction; The property defines how death benefits are distributed when no specific method is chosen, with the range being Pay…"@en,
        "The monetary amount payable to beneficiaries upon the insured's death. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 15 surface variant(s) merged i…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:defaultPayoutMethod ;
            owl:someValuesFrom li:PayoutOption ],
        [ a owl:Restriction ;
            owl:onProperty li:deathBenefitAmountSpecification ;
            owl:someValuesFrom li:Event ],
        li:Benefit ;
    skos:altLabel "death benefit adjustment"@en ;
    skos:definition "The monetary amount payable to beneficiaries upon the insured's death."@en .

li:InsuranceCompany a owl:Class ;
    rdfs:label "Company Liability"@en ;
    rdfs:comment "An entity responsible for underwriting and fulfilling obligations under a life insurance policy. Induced from a Placed as subClassOf ContractualEntity (Stage 5, confidence: high); cluster of 5 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:ContractualEntity ;
    skos:altLabel "Company"@en,
        "insurance company"@en ;
    skos:definition "An entity responsible for underwriting and fulfilling obligations under a life insurance policy."@en .

li:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "A sequence of actions or steps in a life insurance contract. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A sequence of actions or steps in a life insurance contract."@en .

li:ContractualAgreement a owl:Class ;
    rdfs:label "Legal Agreement Encompassing Entire Contract"@en ;
    rdfs:comment "A legal agreement that defines the binding terms of the insurance contract. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DOCUMENT; cluster of 2 surface variant(s) mer…"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:altLabel "legal scope of binding agreement"@en ;
    skos:definition "A legal agreement that defines the binding terms of the insurance contract."@en .

li:Right a owl:Class ;
    rdfs:label "Right"@en ;
    rdfs:comment "A legally recognized entitlement or privilege granted to a party in a life insurance contract. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged…"@en,
        "Waiver of a right does not affect future enforcement rights. Induced via Stage 6 restriction induction; The evidence shows that waivers must be in writing to be valid, and the property applies to enforceable rights, maki…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:NonWaiverOfEnforcementRights ;
            owl:someValuesFrom li:WrittenDocument ],
        li:ContractualProvision ;
    skos:definition "A legally recognized entitlement or privilege granted to a party in a life insurance contract."@en .

li:Role a owl:Class ;
    rdfs:label "Role"@en ;
    rdfs:comment "A function or position held by an individual within a life insurance contract. Induced from a Placed as subClassOf Party (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Party ;
    skos:definition "A function or position held by an individual within a life insurance contract."@en .

