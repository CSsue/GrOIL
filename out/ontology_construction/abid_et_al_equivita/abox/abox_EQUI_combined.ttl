li:Beneficiary a owl:Class ;
    rdfs:label "Beneficiary Change"@en ;
    rdfs:comment "A person or entity designated to receive insurance benefits upon the insured's death. Induced from a Placed as subClassOf owl:Thing (Stage 5, confidence: high); cluster of 18 surface variant(s) merged in Stage 3."@en,
        "Beneficiaries receive equal shares of the payout. Induced via Stage 6 restriction induction; The evidence states that proceeds are paid in equal shares when no percentages are specified, implying each beneficiary receive…"@en,
        "Beneficiary presumed to predecease insured, disclaiming proceeds. Induced via Stage 6 restriction induction; The evidence confirms that if a beneficiary is presumed to have predeceased the insured, their proceeds are dis…"@en,
        "Fallback payout occurs if no primary beneficiary is found. Induced via Stage 6 restriction induction; The property governs payout to a secondary beneficiary when primary designation fails, supported by evidence of contin…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:PresumptionOfPredecease ;
            owl:someValuesFrom li:ProceedsDisposition ],
        [ a owl:Restriction ;
            owl:exactCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty li:EqualShareDistribution ],
        [ a owl:Restriction ;
            owl:onProperty li:BeneficiaryDesignationFallbackPayout ;
            owl:someValuesFrom li:Beneficiary ],
        owl:Thing ;
    skos:altLabel "contingent beneficiary"@en ;
    skos:definition "A person or entity designated to receive insurance benefits upon the insured's death."@en .

