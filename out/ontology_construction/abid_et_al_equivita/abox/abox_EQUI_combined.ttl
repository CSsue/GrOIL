@prefix abox: <https://example.org/ontology/insurance/abox#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix li: <https://example.org/ontology/insurance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    owl:versionInfo "1.0"^^xsd:string .

li:ActiveStatusRestoration a owl:Class ;
    rdfs:label "Active Status Restoration"@en ;
    rdfs:comment "The process of reinstating a life insurance policy to active status after lapse. Induced from a Placed as subClassOf PolicyReinstatement (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyReinstatement ;
    skos:definition "The process of reinstating a life insurance policy to active status after lapse."@en .

li:AdministrativeOffice a owl:Class ;
    rdfs:label "Administrative Office"@en ;
    rdfs:comment "An office responsible for managing administrative functions within an insurance organization. Induced from a Placed as subClassOf Location (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Location ;
    skos:definition "An office responsible for managing administrative functions within an insurance organization."@en .

li:Age a owl:Class ;
    rdfs:label "Age"@en ;
    rdfs:comment "A person's age in years, used to determine insurance eligibility and premiums. Induced from a Placed as subClassOf Period (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Period ;
    skos:definition "A person's age in years, used to determine insurance eligibility and premiums."@en .

li:AgeMisstatement a owl:Class ;
    rdfs:label "Misstatement Of Age"@en ;
    rdfs:comment "A false or inaccurate representation of an individual's age during the application for life insurance. Induced from a Placed as subClassOf MisstatementException (Stage 5, confidence: high); cluster of 2 surface variant(s…"@en ;
    rdfs:subClassOf li:MisstatementException ;
    skos:altLabel "insurable age range"@en ;
    skos:definition "A false or inaccurate representation of an individual's age during the application for life insurance."@en .

li:AlternativePaymentMethod a owl:Class ;
    rdfs:label "Facility of Payment"@en ;
    rdfs:comment "A payment option that allows the policyholder to make premium payments through non-traditional means. Induced from a Placed as subClassOf PremiumPayment (Stage 5, confidence: high); cluster of 4 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:PremiumPayment ;
    skos:altLabel "alternative payment option"@en ;
    skos:definition "A payment option that allows the policyholder to make premium payments through non-traditional means."@en .

li:AutomaticRenewal a owl:Class ;
    rdfs:label "Automatic Renewal"@en ;
    rdfs:comment "A clause allowing a policy to renew automatically at expiration without further action. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A clause allowing a policy to renew automatically at expiration without further action."@en .

li:BindingAction a owl:Class ;
    rdfs:label "Binding Actions"@en ;
    rdfs:comment "A legally enforceable action that establishes or modifies insurance obligations. Induced from a Placed as subClassOf ContractualAgreement (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualAgreement ;
    skos:definition "A legally enforceable action that establishes or modifies insurance obligations."@en .

li:ClaimEligibility a owl:Class ;
    rdfs:label "Benefits Eligibility"@en ;
    rdfs:comment "Claim denied due to material misrepresentation. Induced via Stage 6 restriction induction; The evidence shows that claims may be denied during the contestability period due to misrepresentation, and ClaimValidityAuthorit…"@en,
        "Conditions that must be met for a claim to be approved under a life insurance policy. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:ClaimDenialDueToMisrepresentation ;
            owl:someValuesFrom li:ClaimValidityAuthority ],
        li:ContractualProvision ;
    skos:altLabel "Claim Requirements"@en,
        "claim eligibility"@en ;
    skos:definition "Conditions that must be met for a claim to be approved under a life insurance policy."@en .

li:ClaimInvestigation a owl:Class ;
    rdfs:label "Claim investigation"@en ;
    rdfs:comment "A period during which the insurer examines a claim for validity and accuracy. Induced from a Placed as subClassOf ClaimProcessing (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ClaimProcessing ;
    skos:altLabel "claim investigation window"@en ;
    skos:definition "A period during which the insurer examines a claim for validity and accuracy."@en .

li:CompanyEarnings a owl:Class ;
    rdfs:label "Company Earnings"@en ;
    rdfs:comment "Financial profits generated by the insurance company from its operations. Induced from a Placed as subClassOf FinancialInstrument (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:FinancialInstrument ;
    skos:definition "Financial profits generated by the insurance company from its operations."@en .

li:ConversionRight a owl:Class ;
    rdfs:label "Conversion Option"@en ;
    rdfs:comment "The right to convert a life insurance policy to another type without additional underwriting. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 4 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "conversion period"@en,
        "conversion rights"@en ;
    skos:definition "The right to convert a life insurance policy to another type without additional underwriting."@en .

li:CoverageContinuity a owl:Class ;
    rdfs:label "Policy Continuation"@en ;
    rdfs:comment "The state or condition of maintaining insurance coverage without interruption. Induced from a Placed as subClassOf PolicyEnforcement (Stage 5, confidence: high); cluster of 6 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyEnforcement ;
    skos:altLabel "Termination of Coverage"@en,
        "coverage termination"@en ;
    skos:definition "The state or condition of maintaining insurance coverage without interruption."@en .

li:CoverageGap a owl:Class ;
    rdfs:label "Coverage Gap"@en ;
    rdfs:comment "A period during which an individual lacks sufficient life insurance coverage. Induced from a Placed as subClassOf Period (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Period ;
    skos:definition "A period during which an individual lacks sufficient life insurance coverage."@en .

li:DebtReduction a owl:Class ;
    rdfs:label "Debt Reduction"@en ;
    rdfs:comment "A provision in a life insurance policy that reduces the outstanding debt upon the insured's death. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) mer…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A provision in a life insurance policy that reduces the outstanding debt upon the insured's death."@en .

li:EffectiveCoverageStart a owl:Class ;
    rdfs:label "Effective Coverage Start"@en ;
    rdfs:comment "The date from which coverage under a life insurance policy becomes effective. Induced from a Placed as subClassOf EffectiveDate (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:EffectiveDate ;
    skos:definition "The date from which coverage under a life insurance policy becomes effective."@en .

li:Endorsement a owl:Class ;
    rdfs:label "Endorsement"@en ;
    rdfs:comment "A formal amendment to an insurance policy that modifies its terms. Induced from a Placed as subClassOf FormalModificationMechanism (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:FormalModificationMechanism ;
    skos:altLabel "Endorsements"@en ;
    skos:definition "A formal amendment to an insurance policy that modifies its terms."@en .

li:ExecutiveOfficerAuthorization a owl:Class ;
    rdfs:label "Executive Officer Authorization"@en ;
    rdfs:comment "A formal authorization granted to an executive officer to act on behalf of the policyholder. Induced from a Placed as subClassOf PolicyAuthorization (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in…"@en ;
    rdfs:subClassOf li:PolicyAuthorization ;
    skos:definition "A formal authorization granted to an executive officer to act on behalf of the policyholder."@en .

li:ExpenseReimbursement a owl:Class ;
    rdfs:label "Expense Reimbursement"@en ;
    rdfs:comment "A benefit that reimburses expenses incurred by the insured or beneficiary. Induced from a Placed as subClassOf Benefit (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Benefit ;
    skos:definition "A benefit that reimburses expenses incurred by the insured or beneficiary."@en .

li:FaceAmount a owl:Class ;
    rdfs:label "Face Amount"@en ;
    rdfs:comment "The specified amount of insurance coverage stated in a life insurance policy. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DeathBenefit ;
    skos:definition "The specified amount of insurance coverage stated in a life insurance policy."@en .

li:FraudExemption a owl:Class ;
    rdfs:label "Fraud Exemption"@en ;
    rdfs:comment "A provision that excludes coverage or benefits when fraud is detected. Induced from a Placed as subClassOf Exclusion (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Exclusion ;
    skos:altLabel "fraud exception"@en ;
    skos:definition "A provision that excludes coverage or benefits when fraud is detected."@en .

li:Identification a owl:Class ;
    rdfs:label "Identification"@en ;
    rdfs:comment "A unique identifier assigned to an individual or entity within a life insurance contract. Induced from a Placed as subClassOf InformationAsset (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf li:InformationAsset ;
    skos:definition "A unique identifier assigned to an individual or entity within a life insurance contract."@en .

li:IncontestabilityClause a owl:Class ;
    rdfs:label "Incontestability Clause"@en ;
    rdfs:comment "A provision limiting the insurer's ability to contest the validity of a policy after a specified period. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 4 surface variant(…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "Incontestability Period"@en,
        "incontestability"@en ;
    skos:definition "A provision limiting the insurer's ability to contest the validity of a policy after a specified period."@en .

li:InterestParty a owl:Class ;
    rdfs:label "Interest Parties"@en ;
    rdfs:comment "A party with a financial interest in the life insurance policy. Induced from a Placed as subClassOf Party (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Party ;
    skos:definition "A party with a financial interest in the life insurance policy."@en .

li:JurisdictionRequirement a owl:Class ;
    rdfs:label "State Law Requirement"@en ;
    rdfs:comment "A legal condition or exception imposed by a governing jurisdiction in life insurance contracts. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 4 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "Jurisdiction"@en,
        "state law exception"@en ;
    skos:definition "A legal condition or exception imposed by a governing jurisdiction in life insurance contracts."@en .

li:LapsedPolicy a owl:Class ;
    rdfs:label "Policy Lapse"@en ;
    rdfs:comment "A life insurance policy that has ceased to be active due to non-payment of premiums. Induced from a Placed as subClassOf PolicyTerminationDueToMissedPayments (Stage 5, confidence: high); cluster of 7 surface variant(s) m…"@en ;
    rdfs:subClassOf li:PolicyTerminationDueToMissedPayments ;
    skos:altLabel "lapsed policy recovery"@en ;
    skos:definition "A life insurance policy that has ceased to be active due to non-payment of premiums."@en .

li:LumpSumPayment a owl:Class ;
    rdfs:label "Lump Sum Payment"@en ;
    rdfs:comment "A single, upfront payment made as a benefit in a life insurance contract. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DeathBenefit ;
    skos:definition "A single, upfront payment made as a benefit in a life insurance contract."@en .

li:MaterialMisrepresentation a owl:Class ;
    rdfs:label "Material Misrepresentation"@en ;
    rdfs:comment "A false statement made during the application process that could influence the insurer's decision to issue a policy. Induced from a Placed as subClassOf MisstatementException (Stage 5, confidence: high); cluster of 1 sur…"@en ;
    rdfs:subClassOf li:MisstatementException ;
    skos:definition "A false statement made during the application process that could influence the insurer's decision to issue a policy."@en .

li:MaximumConversionAge a owl:Class ;
    rdfs:label "Maximum Conversion Age"@en ;
    rdfs:comment "The latest age at which a policyholder may convert a term life insurance policy to permanent coverage. Induced from a Placed as subClassOf ConversionRequestTimingConstraint (Stage 5, confidence: high); cluster of 1 surfa…"@en ;
    rdfs:subClassOf li:ConversionRequestTimingConstraint ;
    skos:definition "The latest age at which a policyholder may convert a term life insurance policy to permanent coverage."@en .

li:MisstatementOfSex a owl:Class ;
    rdfs:label "Misstatement Of Sex"@en ;
    rdfs:comment "A false or inaccurate declaration of gender in a life insurance application. Induced from a Placed as subClassOf MisstatementException (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:MisstatementException ;
    skos:altLabel "Sex"@en ;
    skos:definition "A false or inaccurate declaration of gender in a life insurance application."@en .

li:MutualLifeInsurance a owl:Class ;
    rdfs:label "Equivita Mutual Life Insurance"@en ;
    rdfs:comment "A type of life insurance offered by a mutual insurer, where policyholders are also owners. Induced from a Placed as subClassOf LifeInsurance (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LifeInsurance ;
    skos:definition "A type of life insurance offered by a mutual insurer, where policyholders are also owners."@en .

li:NoMedicalExam a owl:Class ;
    rdfs:label "No Medical Exam"@en ;
    rdfs:comment "A life insurance policy feature that does not require a medical examination for underwriting. Induced from a Placed as subClassOf MedicalRequirement (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in…"@en ;
    rdfs:subClassOf li:MedicalRequirement ;
    skos:definition "A life insurance policy feature that does not require a medical examination for underwriting."@en .

li:NoSurplusSharing a owl:Class ;
    rdfs:label "No Surplus Sharing"@en ;
    rdfs:comment "A policy feature indicating no sharing of policy surplus with the policyholder. Induced from a Placed as subClassOf NonParticipatingPolicy (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:NonParticipatingPolicy ;
    skos:definition "A policy feature indicating no sharing of policy surplus with the policyholder."@en .

li:NonWaiverClause a owl:Class ;
    rdfs:label "Waiver Validity"@en ;
    rdfs:comment "A clause that preserves rights despite failure to enforce them within a specified period. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in St…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "non-waiver clause"@en ;
    skos:definition "A clause that preserves rights despite failure to enforce them within a specified period."@en .

li:NonparticipatingPolicy a owl:Class ;
    rdfs:label "Nonparticipating Policy"@en ;
    rdfs:comment "A life insurance policy that does not share in the insurer's surplus profits. Induced from a Placed as subClassOf LifeInsurance (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LifeInsurance ;
    skos:altLabel "nonparticipating"@en ;
    skos:definition "A life insurance policy that does not share in the insurer's surplus profits."@en .

li:OfficialReceipt a owl:Class ;
    rdfs:label "Company Receipt"@en ;
    rdfs:comment "A document issued by the insurance company acknowledging receipt of payment. Induced from a Placed as subClassOf WrittenDocument (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:WrittenDocument ;
    skos:altLabel "official receipt"@en ;
    skos:definition "A document issued by the insurance company acknowledging receipt of payment."@en .

li:PayoutStatus a owl:Class ;
    rdfs:label "Current Payout Status"@en ;
    rdfs:comment "The current status of payments made or due under a life insurance policy. Induced from a Placed as subClassOf Status (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Status ;
    skos:altLabel "premium status"@en ;
    skos:definition "The current status of payments made or due under a life insurance policy."@en .

li:PolicyAnniversary a owl:Class ;
    rdfs:label "Policy Anniversary"@en ;
    rdfs:comment "A recurring annual date in a life insurance policy marking a significant milestone. Induced from a Placed as subClassOf Period (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Period ;
    skos:altLabel "Annual Milestone"@en,
        "Yearly Anniversary"@en ;
    skos:definition "A recurring annual date in a life insurance policy marking a significant milestone."@en .

li:PolicyConversion a owl:Class ;
    rdfs:label "Policy Conversion"@en ;
    rdfs:comment "The process of changing a temporary life insurance policy to a permanent one. Induced from a Placed as subClassOf Process (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Process ;
    skos:altLabel "conversion to permanent policy"@en ;
    skos:definition "The process of changing a temporary life insurance policy to a permanent one."@en .

li:PolicyTransfer a owl:Class ;
    rdfs:label "Policy Transfer"@en ;
    rdfs:comment "A transaction involving the transfer of ownership or rights of a life insurance policy. Induced from a Placed as subClassOf ContractualAgreement (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:ContractualAgreement ;
    skos:definition "A transaction involving the transfer of ownership or rights of a life insurance policy."@en .

li:PriorityOfInterests a owl:Class ;
    rdfs:label "Priority Of Interests"@en ;
    rdfs:comment "The order in which beneficiaries are entitled to receive insurance benefits upon the insured's death. Induced from a Placed as subClassOf BenefitDistribution (Stage 5, confidence: high); cluster of 1 surface variant(s) m…"@en ;
    rdfs:subClassOf li:BenefitDistribution ;
    skos:definition "The order in which beneficiaries are entitled to receive insurance benefits upon the insured's death."@en .

li:ProceedsDisbursementTimeline a owl:Class ;
    rdfs:label "Proceeds Disbursement Timeline"@en ;
    rdfs:comment "The timeframe within which insurance proceeds are distributed after a claim is approved. Induced from a Placed as subClassOf BenefitDistribution (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:BenefitDistribution ;
    skos:definition "The timeframe within which insurance proceeds are distributed after a claim is approved."@en .

li:RegulatoryChange a owl:Class ;
    rdfs:label "Statutory Changes"@en ;
    rdfs:comment "A modification to laws, regulations, or standards affecting insurance coverage or policy terms. Induced from a Placed as subClassOf PolicyModification (Stage 5, confidence: high); cluster of 3 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:PolicyModification ;
    skos:altLabel "coverage updates"@en,
        "regulatory updates"@en ;
    skos:definition "A modification to laws, regulations, or standards affecting insurance coverage or policy terms."@en .

li:RetroactiveEffect a owl:Class ;
    rdfs:label "Retroactive Effect"@en ;
    rdfs:comment "A provision that extends coverage to events occurring before the policy's effective date. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in St…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A provision that extends coverage to events occurring before the policy's effective date."@en .

li:SimultaneousDeath a owl:Class ;
    rdfs:label "Simultaneous Death"@en ;
    rdfs:comment "A condition where the insured and another party die at approximately the same time, affecting benefit distribution. Induced from a Placed as subClassOf UncertainOrderOfDeathEvent (Stage 5, confidence: high); cluster of 2…"@en,
        "Determines beneficiary if death order is uncertain. Induced via Stage 6 restriction induction; The clause resolves uncertainty in death order by assuming a predefined sequence, directly relating to the determination of o…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:SimultaneousDeathAssumption ;
            owl:someValuesFrom li:OrderOfDeath ],
        li:UncertainOrderOfDeathEvent ;
    skos:altLabel "Insured Dead"@en ;
    skos:definition "A condition where the insured and another party die at approximately the same time, affecting benefit distribution."@en .

li:SurvivorshipRule a owl:Class ;
    rdfs:label "Survivorship Rules"@en ;
    rdfs:comment "A condition determining eligibility for benefits based on survival of one or more individuals. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A condition determining eligibility for benefits based on survival of one or more individuals."@en .

li:TwoYearReset a owl:Class ;
    rdfs:label "Two-Year Reset"@en ;
    rdfs:comment "A provision allowing policy terms to reset after two years. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A provision allowing policy terms to reset after two years."@en .

li:Warranty a owl:Class ;
    rdfs:label "Representations Vs Warranties"@en ;
    rdfs:comment "A statement of fact made by the insured that forms part of the insurance contract. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "warranties"@en ;
    skos:definition "A statement of fact made by the insured that forms part of the insurance contract."@en .

li:accruesOn a owl:ObjectProperty ;
    rdfs:label "Accrues On"@en ;
    rdfs:comment "Indicates the event or condition upon which interest begins to accrue in an insurance contract. Assigned domain=PremiumPayment, range=EffectiveDate; Interest accrues on overdue premiums, typically starting from a specifi…"@en ;
    rdfs:domain li:PremiumPayment ;
    rdfs:range li:EffectiveDate ;
    skos:altLabel "contains overdue premium interest terms"@en,
        "includes interest"@en ;
    skos:definition "Indicates the event or condition upon which interest begins to accrue in an insurance contract."@en .

li:addressChangeResponsibility a owl:ObjectProperty ;
    rdfs:label "Address Change Responsibility"@en ;
    rdfs:comment "Indicates the party responsible for initiating or managing changes to the policyholder's address in the insurance contract. Assigned domain=PolicyOwner, range=AddressUpdate; The property links a party responsible for add…"@en ;
    rdfs:domain li:PolicyOwner ;
    rdfs:range li:AddressUpdate ;
    skos:definition "Indicates the party responsible for initiating or managing changes to the policyholder's address in the insurance contract."@en .

li:approvesChangePaymentMode a owl:ObjectProperty ;
    rdfs:label "Approves Change Payment Mode"@en ;
    rdfs:comment "Indicates the entity that approves a change in the payment mode within an insurance contract. Assigned domain=AuthorizedAgent, range=PaymentModeChange; This property denotes the entity responsible for approving a change…"@en ;
    rdfs:domain li:AuthorizedAgent ;
    rdfs:range li:PaymentModeChange ;
    skos:altLabel "affected by change in payment mode"@en,
        "requests change payment mode"@en ;
    skos:definition "Indicates the entity that approves a change in the payment mode within an insurance contract."@en .

li:authenticates a owl:ObjectProperty ;
    rdfs:label "authenticates"@en ;
    rdfs:comment "Indicates the entity that authenticates a particular insurance contract or document. Assigned domain=WrittenDocument, range=CompanySignature; The entity that authenticates a contract or document must be a formal authorit…"@en ;
    rdfs:domain li:WrittenDocument ;
    rdfs:range li:CompanySignature ;
    skos:definition "Indicates the entity that authenticates a particular insurance contract or document."@en .

li:authorizesOrInitiatesDesignation a owl:ObjectProperty ;
    rdfs:label "Authorizes Or Initiates Designation"@en ;
    rdfs:comment "Indicates the party that authorizes or initiates the designation within an insurance contract. Assigned domain=PolicyOwner, range=BeneficiaryDesignationController; The property identifies the party responsible for author…"@en ;
    rdfs:domain li:PolicyOwner ;
    rdfs:range li:BeneficiaryDesignationController ;
    skos:altLabel "receives and files written designation"@en,
        "timeframe for filing written designation"@en ;
    skos:definition "Indicates the party that authorizes or initiates the designation within an insurance contract."@en .

li:canBeModifiedWithAuthorization a owl:ObjectProperty ;
    rdfs:label "Subject To Policy Modification Authorization"@en ;
    rdfs:comment "Indicates that a policy or its terms may only be modified if authorized by an eligible party, reflecting the requirement for formal approval before changes are enacted. Assigned domain=PolicyModification, range=ChangeAut…"@en ;
    rdfs:domain li:PolicyModification ;
    rdfs:range li:ChangeAuthorizationRule ;
    skos:altLabel "can authorize modifications to"@en,
        "cannot modify"@en ;
    skos:definition "Indicates that a policy or its terms may only be modified if authorized by an eligible party, reflecting the requirement for formal approval before changes are enacted."@en .

li:canRestorePolicyToInForceStatusAfterLapse a owl:ObjectProperty ;
    rdfs:label "Can Restore Policy To In Force Status After Lapse"@en ;
    rdfs:comment "Indicates that a policy has the capability to be restored to an active (in force) status following a lapse. Assigned domain=PolicyRestoration, range=InsuranceContract; This property indicates a policy's capability to be…"@en ;
    rdfs:domain li:PolicyRestoration ;
    rdfs:range li:InsuranceContract ;
