    a owl:ObjectProperty ;
    rdfs:label "Is Required To Make Manual Payments When Two Or More Drafts Are Missed"@en ;
    rdfs:comment "Indicates that a party is required to make manual payments when two or more automatic draft attempts have been missed. Assigned domain=PolicyTermEvolution, range=ConditionSatisfaction; The property describes a condition…"@en ;
    skos:definition "Indicates that a party is required to make manual payments when two or more automatic draft attempts have been missed."@en ;
    rdfs:domain ins:PolicyTermEvolution ;
    rdfs:range ins:ConditionSatisfaction ;
    skos:altLabel "responsible for restoring automatic draft"@en ;
    skos:altLabel "is subject to payment responsibility upon automatic draft failure"@en .

