    <rdfs:subClassOf rdf:nodeID="ncb598afe76e6469cba597494ddb7b313b287"/>
    <skos:altLabel xml:lang="en">SU-3</skos:altLabel>
    <owl:disjointWith rdf:resource="https://example.org/ontology/insurance#MonetaryAmount"/>
  </rdf:Description>
