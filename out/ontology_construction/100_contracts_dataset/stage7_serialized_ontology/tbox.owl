    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Rider"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#drawsFirstFromTranche">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Draws First From Tranche 1</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a funding event draws funds first from a specific tranche, specifically tranche 1, in the sequence of funding disbursements. Assigned domain=Rider, range=Tranche; The property specifies that a funding even…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates that a funding event draws funds first from a specific tranche, specifically tranche 1, in the sequence of funding disbursements.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Rider"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#Tranche"/>
    <skos:altLabel xml:lang="en">first funding tranche</skos:altLabel>
  </rdf:Description>
