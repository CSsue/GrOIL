  <rdf:Description rdf:about="https://example.org/ontology/insurance#CourtOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Court Direction</rdfs:label>
    <rdfs:comment xml:lang="en">A legally binding decision or directive issued by a court that affects the terms or execution of a life insurance policy. Induced from a Placed as subClassOf TriggerEvent (Stage 5, confidence: high); cluster of 9 surface…</rdfs:comment>
    <skos:definition xml:lang="en">A legally binding decision or directive issued by a court that affects the terms or execution of a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#TriggerEvent"/>
    <skos:altLabel xml:lang="en">court order reliance</skos:altLabel>
    <skos:altLabel xml:lang="en">court decree</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#SinglePremiumPayment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Planned Premium Payment</rdfs:label>
    <rdfs:comment xml:lang="en">A lump-sum payment made upfront for a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 2 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A lump-sum payment made upfront for a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#PremiumPaymentMethod"/>
    <skos:altLabel xml:lang="en">single premium paid upfront</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#timeConstraintForCertificationSubmission">
