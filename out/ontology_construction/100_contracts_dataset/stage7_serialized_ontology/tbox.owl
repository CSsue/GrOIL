    <skos:altLabel xml:lang="en">terminated upon expulsion</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasJumpLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Verifies Jump Count Against 500 Jump Limit</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the maximum number of jumps allowed under an insurance policy, typically 500, beyond which additional conditions or premiums apply. Assigned domain=Skydiving, range=xsd:integer; The property defines the maximum…</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the maximum number of jumps allowed under an insurance policy, typically 500, beyond which additional conditions or premiums apply.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Skydiving"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:altLabel xml:lang="en">covered up to 300 jumps under endorsement d</skos:altLabel>
    <skos:altLabel xml:lang="en">subject to suspension if exceeds 500 jumps without re underwriting</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#requiresAssignmentRecording">
