@prefix abox: <https://example.org/ontology/insurance/abox#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix li: <https://example.org/ontology/insurance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:created "2026-05-17"^^xsd:date ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    owl:versionInfo "1.0"^^xsd:string .

li:247Assistance a owl:Class ;
    rdfs:label "24/7 Assistance"@en ;
    rdfs:comment "A round-the-clock support service available to policyholders at any time. Induced from a Placed as subClassOf PolicySupportProvider (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicySupportProvider ;
    skos:definition "A round-the-clock support service available to policyholders at any time."@en .

li:31DayElectionWindowAfterSeparation a owl:Class ;
    rdfs:label "31-Day Election Window After Separation"@en ;
    rdfs:comment "A 31-day period following separation during which an election may be made. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 surface variant(s) merge…"@en ;
    rdfs:subClassOf li:Election ;
    skos:definition "A 31-day period following separation during which an election may be made."@en .

li:ABRRiderFormIdentifier a owl:Class ;
    rdfs:label "form identifier for ABR rider"@en ;
    rdfs:comment "A form identifier used for an ABR rider in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DOCUMENT; cluster of 1 surface variant(s) merged in S…"@en ;
    rdfs:subClassOf li:RiderFormIdentifier ;
    skos:definition "A form identifier used for an ABR rider in a life insurance policy."@en .

li:ADBTrigger a owl:Class ;
    rdfs:label "termination trigger for ADB rider"@en ;
    rdfs:comment "A condition that initiates the termination of an Accelerated Death Benefit rider. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DATE; cluster of 1 surface variant(s) m…"@en,
        "ADB rider removal affects loan protection. Induced via Stage 6 restriction induction; The evidence links removal of the ADB rider to changes in loan protection eligibility, indicating a condition satisfaction outcome. Th…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:RiderRemovalImpactOnLoanProtection ;
            owl:someValuesFrom li:ConditionSatisfaction ],
        li:TriggerCondition ;
    skos:definition "A condition that initiates the termination of an Accelerated Death Benefit rider."@en .

li:ADDPayoutTrigger a owl:Class ;
    rdfs:label "trigger for full AD&D payout"@en ;
    rdfs:comment "A condition that activates a specified level of accidental death and dismemberment insurance payout. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of…"@en ;
    rdfs:subClassOf li:TriggerCondition ;
    skos:altLabel "trigger for half AD&D payout"@en,
        "trigger for quarter AD&D payout"@en ;
    skos:definition "A condition that activates a specified level of accidental death and dismemberment insurance payout."@en .

li:AWOLExclusion a owl:Class ;
    rdfs:label "AWOL exclusion"@en ;
    rdfs:comment "A clause excluding coverage for death resulting from absence without leave. Induced from a Placed as subClassOf ExcludedCauseOfDeath (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en,
        "A condition allowing coverage despite UA/AWOL exclusion when duress is proven. Induced via Stage 6 restriction induction; The evidence shows that duress is a valid exception to the UA/AWOL exclusion. The property links t…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:ExceptionToUaAwolExclusion ;
            owl:someValuesFrom li:DuressException ],
        li:ExcludedCauseOfDeath ;
    skos:altLabel "AWOL"@en ;
    skos:definition "A clause excluding coverage for death resulting from absence without leave."@en .

li:AaaRules a owl:Class ;
    rdfs:label "AAA rules"@en ;
    rdfs:comment "Regulatory or underwriting guidelines established by the American Academy of Actuaries. Induced from a Placed as subClassOf RegulatoryFramework (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf li:RegulatoryFramework ;
    skos:definition "Regulatory or underwriting guidelines established by the American Academy of Actuaries."@en .

li:AbsenceOfRiskSpecificExclusionsClarification a owl:Class ;
    rdfs:label "Clarification About Absence Of Risk-Specific Exclusions"@en ;
    rdfs:comment "A statement clarifying that no exclusions based on specific risks apply to the policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf STATEMENT; cluster of 1 surface va…"@en ;
    rdfs:subClassOf li:DisclosureRequirement ;
    skos:definition "A statement clarifying that no exclusions based on specific risks apply to the policy."@en .

li:AcademicYearStart a owl:Class ;
    rdfs:label "Academic Year Start"@en ;
    rdfs:comment "The start date of an academic year, used as a reference point in policy terms. Induced from a Placed as subClassOf LongTermPlanningTimeline (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LongTermPlanningTimeline ;
    skos:definition "The start date of an academic year, used as a reference point in policy terms."@en .

li:AcceleratedBenefitCap a owl:Class ;
    rdfs:label "Accelerated Benefit Cap"@en ;
    rdfs:comment "The maximum amount payable as an accelerated benefit under a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PERCENTAGE; cluster of 1 surface vari…"@en ;
    rdfs:subClassOf li:BenefitCap ;
    skos:definition "The maximum amount payable as an accelerated benefit under a life insurance policy."@en .

li:AcceleratedBenefitLimit a owl:Class ;
    rdfs:label "Maximum Allowable Accelerated Payout"@en ;
    rdfs:comment "The maximum amount permissible for an accelerated benefit payout under a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 8 surf…"@en ;
    rdfs:subClassOf li:MonetaryAmount ;
    skos:altLabel "maximum accelerated payout limit"@en,
        "minimum allowed accelerated payout"@en ;
    skos:definition "The maximum amount permissible for an accelerated benefit payout under a life insurance policy."@en .

li:AcceleratedBenefitPayoutSource a owl:Class ;
    rdfs:label "Primary source of accelerated benefit payout"@en ;
    rdfs:comment "A source from which an accelerated benefit payment is made to a policyholder. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf TRANCHE; cluster of 2 surface variant(s) me…"@en ;
    rdfs:subClassOf li:CoverageTranche ;
    skos:altLabel "Secondary source of accelerated benefit payout"@en ;
    skos:definition "A source from which an accelerated benefit payment is made to a policyholder."@en .

li:AcceleratedBenefitRequestForm a owl:Class ;
    rdfs:label "Request Form For Accelerated Benefit"@en ;
    rdfs:comment "A document submitted to request early payment of a life insurance benefit. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf FORM; cluster of 1 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:ClaimForm ;
    skos:definition "A document submitted to request early payment of a life insurance benefit."@en .

li:AcceleratedPayoutOption a owl:Class ;
    rdfs:label "Accelerated Payout Option For Terminally Ill"@en ;
    rdfs:comment "A provision allowing early payment of death benefit to terminally ill policyholders. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf POLICY_RIDER; cluster of 1 surface v…"@en ;
    rdfs:subClassOf li:InsuranceRider ;
    skos:definition "A provision allowing early payment of death benefit to terminally ill policyholders."@en .

li:AccelerationBenefit a owl:Class ;
    rdfs:label "Maximum Acceleration Amount"@en ;
    rdfs:comment "A provision allowing early payment of a portion of the death benefit under specified conditions. Induced from a Placed as subClassOf LivingBenefit (Stage 5, confidence: high); cluster of 11 surface variant(s) merged in S…"@en ;
    rdfs:subClassOf li:LivingBenefit ;
    skos:altLabel "acceleration"@en,
        "minimum acceleration"@en ;
    skos:definition "A provision allowing early payment of a portion of the death benefit under specified conditions."@en .

li:AccelerationLimit a owl:Class ;
    rdfs:label "Upper Limit For Acceleration"@en ;
    rdfs:comment "The maximum or minimum threshold for accelerated benefit payments in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 8 surfac…"@en ;
    rdfs:subClassOf li:MonetaryAmount ;
    skos:altLabel "acceleration"@en,
        "minimum acceleration threshold"@en ;
    skos:definition "The maximum or minimum threshold for accelerated benefit payments in a life insurance policy."@en .

li:AccelerationRequester a owl:Class ;
    rdfs:label "Owner Authorized To Request Acceleration"@en ;
    rdfs:comment "An owner authorized to request acceleration of benefits in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ROLE; cluster of 1 surface variant(s)…"@en ;
    rdfs:subClassOf li:Beneficiary ;
    skos:definition "An owner authorized to request acceleration of benefits in a life insurance policy."@en .

li:Accident a owl:Class ;
    rdfs:label "Accident Definition"@en ;
    rdfs:comment "A sudden, unintended event causing injury or damage, as defined in a life insurance policy. Induced from a Placed as subClassOf TriggerEvent (Stage 5, confidence: high); cluster of 15 surface variant(s) merged in Stage 3…"@en,
        "Accident benefit payable only if qualifying accident occurs. Induced via Stage 6 restriction induction; The property defines the payout condition for an accident benefit, linking the accident event to a monetary amount.…"@en,
        "Accident must be sole cause for injury coverage. Induced via Stage 6 restriction induction; The evidence states that an accident must be the sole cause of injury, establishing a direct link from Accident to Exclusion via…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:AccidentSoleCauseRequirement ;
            owl:someValuesFrom li:Exclusion ],
        [ a owl:Restriction ;
            owl:onProperty li:AccidentBenefitPayoutCondition ;
            owl:someValuesFrom li:MonetaryAmount ],
        li:TriggerEvent ;
    skos:altLabel "accident report"@en ;
    skos:definition "A sudden, unintended event causing injury or damage, as defined in a life insurance policy."@en .

li:AccidentCoverageScope a owl:Class ;
    rdfs:label "Defines Scope Of Accident Coverage"@en ;
    rdfs:comment "Defines the boundaries and limits of coverage for accidents within a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf RIDER; cluster of 1 surface v…"@en ;
    rdfs:subClassOf li:Rider ;
    skos:definition "Defines the boundaries and limits of coverage for accidents within a life insurance policy."@en .

li:AccidentSpecificPayoutMechanism a owl:Class ;
    rdfs:label "Accident-Specific Payout Mechanism"@en ;
    rdfs:comment "A payout mechanism triggered specifically by an accident event. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf BENEFIT_AMOUNT; cluster of 1 surface variant(s) merged in…"@en ;
    rdfs:subClassOf li:DeathBenefitPayout ;
    skos:definition "A payout mechanism triggered specifically by an accident event."@en .

li:AccidentalDeathAddOnBenefit a owl:Class ;
    rdfs:label "Accidental Death Add-On Amount"@en ;
    rdfs:comment "A supplementary benefit paid upon death resulting from an accident, above the base death benefit. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 5 su…"@en ;
    rdfs:subClassOf li:DeathBenefitPayout ;
    skos:altLabel "additional accidental death benefit"@en,
        "payout multiplier for accidental death"@en ;
    skos:definition "A supplementary benefit paid upon death resulting from an accident, above the base death benefit."@en .

li:AccidentalDeathAndDismembermentSchedule a owl:Class ;
    rdfs:label "Accidental Death & Dismemberment"@en ;
    rdfs:comment "A policy pays out if hearing loss is a covered event under AD&D. Induced via Stage 6 restriction induction; The evidence specifies payout percentages (50% and 100%) for hearing loss, which are numeric values. The domain…"@en,
        "A schedule outlining benefits payable for accidental death or specified dismemberment events. Induced from a Placed as subClassOf BenefitFramework (Stage 5, confidence: high); cluster of 7 surface variant(s) merged in St…"@en,
        "Illnesses are excluded from AD&D coverage. Induced via Stage 6 restriction induction; The evidence clearly states that illness and medical conditions are excluded from AD&D benefits, making 'Exclusion' the appropriate fi…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:ADDDPayoutForHearingLoss ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:onProperty li:ADDExclusionForIllness ;
            owl:someValuesFrom li:Exclusion ],
        li:BenefitFramework ;
    skos:altLabel "Dismemberment Schedule"@en,
        "accidental death and dismemberment"@en ;
    skos:definition "A schedule outlining benefits payable for accidental death or specified dismemberment events."@en .

li:AccidentalDeathBenefit a owl:Class ;
    rdfs:label "Additional Payout Upon Qualifying Accident"@en ;
    rdfs:comment "A supplemental payout provided upon death resulting from a qualifying accident. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 2 surface variant(s)…"@en,
        "Actuarial discounts are prohibited for ADB coverage. Induced via Stage 6 restriction induction; The property prohibits actuarial discounts for ADB, implying ADB is not a form of coverage. The hierarchy confirms no subcla…"@en ;
    rdfs:subClassOf li:DeathBenefitPayout ;
    owl:disjointWith li:Coverage ;
    skos:altLabel "supplemental benefit for accidents"@en ;
    skos:definition "A supplemental payout provided upon death resulting from a qualifying accident."@en .

li:AccidentalDeathBenefitClaim a owl:Class ;
    rdfs:label "Accidental Death Benefit Claim Requiring Verification"@en ;
    rdfs:comment "A claim for benefits due upon death resulting from an accident, requiring verification. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CLAIM_TYPE; cluster of 1 surface…"@en ;
    rdfs:subClassOf li:Claim ;
    skos:definition "A claim for benefits due upon death resulting from an accident, requiring verification."@en .

li:AccidentalDeathBenefitRiderPayout a owl:Class ;
    rdfs:label "annual cost of Accidental Death Benefit Rider"@en ;
    rdfs:comment "An additional payout provided under an Accidental Death Benefit Rider. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf FINANCIAL; cluster of 2 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:DeathBenefitPayout ;
    skos:altLabel "additional payout under Accidental Death Benefit Rider"@en ;
    skos:definition "An additional payout provided under an Accidental Death Benefit Rider."@en .

li:AccidentalDeathBenefitRiderTerminationPoint a owl:Class ;
    rdfs:label "termination point for Accidental Death Benefit Rider"@en ;
    rdfs:comment "The point at which an accidental death benefit rider ends or becomes inactive. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AGE_LIMIT; cluster of 1 surface variant(s)…"@en ;
    rdfs:subClassOf li:RiderTermination ;
    skos:definition "The point at which an accidental death benefit rider ends or becomes inactive."@en .

li:AccidentalDeathCriterion a owl:Class ;
    rdfs:label "Definitional Criterion For Accidental Death"@en ;
    rdfs:comment "A definitional criterion used to determine if a death qualifies as accidental under a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONDITION; c…"@en ;
    rdfs:subClassOf li:EligibilityCriterion ;
    skos:definition "A definitional criterion used to determine if a death qualifies as accidental under a life insurance policy."@en .

li:AccidentalDeathExceptionClause a owl:Class ;
    rdfs:label "Accidental Death Exception Clause"@en ;
    rdfs:comment "A clause in a life insurance policy that provides coverage for death resulting from accidental causes. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf SECTION; cluster o…"@en ;
    rdfs:subClassOf li:ExclusionClause ;
    skos:definition "A clause in a life insurance policy that provides coverage for death resulting from accidental causes."@en .

li:AccidentalDeathOverride a owl:Class ;
    rdfs:label "Accidental Death Override"@en ;
    rdfs:comment "A provision that increases the death benefit if death results from an accident. Induced from a Placed as subClassOf DeathBenefitProvision (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DeathBenefitProvision ;
    skos:altLabel "death benefit override"@en ;
    skos:definition "A provision that increases the death benefit if death results from an accident."@en .

li:AccidentalDeathRiderCharge a owl:Class ;
    rdfs:label "Monthly Premium Cost For Accidental Death Rider"@en ;
    rdfs:comment "A recurring monthly fee paid for coverage under an accidental death rider. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 3 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:RecurringCost ;
    skos:altLabel "additional monthly charge for accident rider"@en,
        "monthly rider charge for accidental death benefit"@en ;
    skos:definition "A recurring monthly fee paid for coverage under an accidental death rider."@en .

li:AccidentalDeathVerification a owl:Class ;
    rdfs:label "Supplementary Evidence For Early Accidental Death Claims"@en ;
    rdfs:comment "Evidence validating the occurrence and cause of death due to an accident. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DOCUMENT; cluster of 4 surface variant(s) merge…"@en ;
    rdfs:subClassOf li:DocumentationRequirement ;
    skos:altLabel "medical verification for accident-related deaths"@en,
        "supportive proof for accidental death claims"@en ;
    skos:definition "Evidence validating the occurrence and cause of death due to an accident."@en .

li:AccidentalOverdose a owl:Class ;
    rdfs:label "Accidental Overdose"@en ;
    rdfs:comment "A fatal overdose resulting from unintentional drug consumption. Induced from a Placed as subClassOf ExcludedCauseOfDeath (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ExcludedCauseOfDeath ;
    skos:definition "A fatal overdose resulting from unintentional drug consumption."@en .

li:AccountAllocation a owl:Class ;
    rdfs:label "Account Allocation"@en ;
    rdfs:comment "A distribution of policy funds across different investment accounts with varying risk and return profiles. Induced from a Placed as subClassOf InvestmentAllocationOption (Stage 5, confidence: high); cluster of 17 surface…"@en ;
    rdfs:subClassOf li:InvestmentAllocationOption ;
    skos:altLabel "variable account"@en ;
    skos:definition "A distribution of policy funds across different investment accounts with varying risk and return profiles."@en .

li:AccountBalance a owl:Class ;
    rdfs:label "Sub-Account Balance"@en ;
    rdfs:comment "The current monetary value credited to a sub-account within a life insurance policy. Induced from a Placed as subClassOf AccountValue (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:AccountValue ;
    skos:altLabel "Account Balance"@en,
        "account balance timing"@en ;
    skos:definition "The current monetary value credited to a sub-account within a life insurance policy."@en .

li:AccountHolder a owl:Class ;
    rdfs:label "Account Owner Aligned With Mission"@en ;
    rdfs:comment "An entity that holds legal and financial rights over a separate account in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ORGANIZATION; cluster…"@en ;
    rdfs:subClassOf li:PolicyOwner ;
    skos:altLabel "account holder"@en,
        "issuing separate account"@en ;
    skos:definition "An entity that holds legal and financial rights over a separate account in a life insurance policy."@en .

li:AccountLapsePrevention a owl:Class ;
    rdfs:label "Account Lapse Prevention"@en ;
    rdfs:comment "A feature that prevents the lapse of an insurance account due to non-payment. Induced from a Placed as subClassOf LapsePreventionMechanism (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LapsePreventionMechanism ;
    skos:definition "A feature that prevents the lapse of an insurance account due to non-payment."@en .

li:AccountLimit a owl:Class ;
    rdfs:label "Account Limitations"@en ;
    rdfs:comment "A restriction on the value or growth of a life insurance account. Induced from a Placed as subClassOf CoverageLimit (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:CoverageLimit ;
    skos:altLabel "Account Value limits"@en,
        "account limits"@en ;
    skos:definition "A restriction on the value or growth of a life insurance account."@en .

li:AccountUsingUncappedFormula a owl:Class ;
    rdfs:label "Account Using Uncapped Formula"@en ;
    rdfs:comment "An account that applies a formula without any upper limit on benefit calculation. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ACCOUNT_TYPE; cluster of 1 surface vari…"@en ;
    rdfs:subClassOf li:Account ;
    skos:definition "An account that applies a formula without any upper limit on benefit calculation."@en .

li:AccountValueAtDeath a owl:Class ;
    rdfs:label "Account Value At Death"@en ;
    rdfs:comment "The account value of a life insurance policy at the time of the insured's death. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DeathBenefit ;
    skos:altLabel "death benefit vs account value"@en ;
    skos:definition "The account value of a life insurance policy at the time of the insured's death."@en .

li:AccountValueDeduction a owl:Class ;
    rdfs:label "Account Value Deduction"@en ;
    rdfs:comment "A reduction in account value, typically for fees or charges in a life insurance policy. Induced from a Placed as subClassOf RecurringCost (Stage 5, confidence: high); cluster of 8 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:RecurringCost ;
    skos:definition "A reduction in account value, typically for fees or charges in a life insurance policy."@en .

li:AccountValueFloor a owl:Class ;
    rdfs:label "Index Account Floor"@en ;
    rdfs:comment "The minimum value an index account can maintain under a life insurance policy. Induced from a Placed as subClassOf AccountValue (Stage 5, confidence: high); cluster of 7 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:AccountValue ;
    skos:altLabel "index floor"@en ;
    skos:definition "The minimum value an index account can maintain under a life insurance policy."@en .

li:AccountValueFloorAfterWithdrawal a owl:Class ;
    rdfs:label "Remaining Account Value Floor After Withdrawal"@en ;
    rdfs:comment "The minimum account value remaining after a withdrawal is made. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 1 surface variant(s) merged in Stage 3…"@en ;
    rdfs:subClassOf li:MonetaryAmount ;
    skos:definition "The minimum account value remaining after a withdrawal is made."@en .

li:AccountValueGrowth a owl:Class ;
    rdfs:label "Account Value Growth"@en ;
    rdfs:comment "The increase in the monetary value of a life insurance account over time. Induced from a Placed as subClassOf PerformanceMetric (Stage 5, confidence: high); cluster of 12 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PerformanceMetric ;
    skos:altLabel "Conservative Growth Account"@en ;
    skos:definition "The increase in the monetary value of a life insurance account over time."@en .

li:AccountValueShortfallPenalty a owl:Class ;
    rdfs:label "Penalty Triggered When Account Value Falls Short"@en ;
    rdfs:comment "A penalty applied when the account value falls below a required threshold. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PROVISION; cluster of 1 surface variant(s) mer…"@en ;
    rdfs:subClassOf li:PolicyContract ;
    skos:definition "A penalty applied when the account value falls below a required threshold."@en .

li:AccountValueThreshold a owl:Class ;
    rdfs:label "Deduction Threshold Subtracted From Account Value"@en ;
    rdfs:comment "A minimum account value required to maintain policy validity or trigger specific contract conditions. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of…"@en ;
    rdfs:subClassOf li:MonetaryAmount ;
    skos:altLabel "account value threshold"@en,
        "minimum account value requirement"@en ;
    skos:definition "A minimum account value required to maintain policy validity or trigger specific contract conditions."@en .

li:AccountValueZero a owl:Class ;
    rdfs:label "Account Value Zero"@en ;
    rdfs:comment "A state in which the account value of a life insurance policy is zero. Induced from a Placed as subClassOf CashValueMilestone (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:CashValueMilestone ;
    skos:definition "A state in which the account value of a life insurance policy is zero."@en .

li:AccountWithYearlyCapping a owl:Class ;
    rdfs:label "Accounts With Yearly Capping"@en ;
    rdfs:comment "A financial account subject to annual limits on benefit or contribution amounts. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ACCOUNT_TYPE; cluster of 1 surface varia…"@en ;
    rdfs:subClassOf li:Account ;
    skos:definition "A financial account subject to annual limits on benefit or contribution amounts."@en .

li:AccrualContinuationDespiteNonPayment a owl:Class ;
    rdfs:label "Accrual Continuation Despite Non-Payment"@en ;
    rdfs:comment "A provision allowing interest or benefits to continue accruing despite non-payment of premiums. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 sur…"@en ;
    rdfs:subClassOf li:PolicyContract ;
    skos:definition "A provision allowing interest or benefits to continue accruing despite non-payment of premiums."@en .

li:AccrualMechanism a owl:Class ;
    rdfs:label "Daily Accrual Mechanism"@en ;
