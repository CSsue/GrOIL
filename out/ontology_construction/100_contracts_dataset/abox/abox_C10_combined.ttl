    skos:definition "A medical condition resulting from an infection originating in a wound."@en .

li:WrittenAuthorizationRequirement a owl:Class ;
    rdfs:label "Requires Written Authorization For Transactions"@en ;
    rdfs:comment "A condition requiring written consent for policy-related transactions. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PERSON; cluster of 1 surface variant(s) merged in…"@en ;
