li:PolicyDebt a owl:Class ;
    rdfs:label "Policy Debt"@en ;
    rdfs:comment "A financial obligation owed by the policyholder against the policy's cash value. Induced from a Placed as subClassOf LoanFeature (Stage 5, confidence: high); cluster of 23 surface variant(s) merged in Stage 3."@en,
        "Interest accrues after first insured death. Induced via Stage 6 restriction induction; The evidence confirms that policy debt accrues interest after the first death, indicating a direct relationship between PolicyDebt an…"@en,
        "The charitable percentage is reduced if the policyholder has outstanding debt. Induced via Stage 6 restriction induction; The evidence indicates that policy debt affects the charitable percentage, implying a relationship…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:PostFirstDeathInterestAccrual ;
            owl:someValuesFrom li:InterestAccrual ],
        [ a owl:Restriction ;
            owl:onProperty li:DebtImpactOnCharitablePercentage ;
            owl:someValuesFrom li:CharitableBeneficiary ],
        li:LoanFeature ;
    skos:altLabel "decreasing financial obligations"@en,
        "policy debt deduction"@en ;
    skos:definition "A financial obligation owed by the policyholder against the policy's cash value."@en .

