li:PolicyContinuityOption a owl:Class ;
    rdfs:label "Option To Maintain Policy Continuity"@en ;
    rdfs:comment "A contractual provision allowing the policyholder to maintain coverage continuity through form changes. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ACTION; cluster o…"@en,
        "Policy continuation depends on meeting conditions. Induced via Stage 6 restriction induction; The evidence shows that policy continuation is contingent on specific conditions like account value coverage or guarantee acti…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:ContinuityCondition ;
            owl:someValuesFrom li:ConditionSatisfaction ],
        li:PolicyContinuationOption ;
