            owl:onProperty li:JointOwnerSharedResponsibility ;
            owl:someValuesFrom li:RightToCancel ],
        [ a owl:Restriction ;
            owl:onProperty li:JointOwnerPaymentResponsibility ;
            owl:someValuesFrom li:PremiumObligation ],
        li:PolicyOwner ;
    skos:altLabel "beneficiary entitled if joint owners die out"@en ;
    skos:definition "A joint owner who retains rights to the policy upon the death of other joint owners."@en .

