    rdfs:comment "A request for information regarding an employment-related insurance offer. Induced from a Placed as subClassOf InsuranceContract (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en,
        "EOI required when coverage exceeds threshold. Induced via Stage 6 restriction induction; The evidence shows that EOI is required for coverage above certain thresholds, and eligibility is tied to age-based underwriting. T…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:EOIRequirementAboveThreshold ;
            owl:someValuesFrom li:AgeRange ],
        li:InsuranceContract ;
    skos:definition "A request for information regarding an employment-related insurance offer."@en .

