            owl:onProperty li:ApplicationIncorporationAsContractComponent ;
            owl:someValuesFrom li:ContractualRelationshipStatus ],
        [ a owl:Restriction ;
            owl:onProperty li:FullEoiRequiresMedicalExam ;
            owl:someValuesFrom li:MedicalExamination ],
        li:InsuranceContract ;
    skos:altLabel "policy application"@en,
        "prospective application"@en ;
    skos:definition "A formal submission of information for consideration of life insurance coverage."@en .

