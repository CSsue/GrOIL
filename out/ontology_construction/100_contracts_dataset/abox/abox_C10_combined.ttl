    skos:definition "A unique identifier assigned to a worker within an insurance context."@en .

li:WorkersCompensationBenefit a owl:Class ;
    rdfs:label "Workers' Compensation"@en ;
    rdfs:comment "A benefit paid to workers for injuries sustained on the job. Induced from a Placed as subClassOf DisabilityBenefit (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DisabilityBenefit ;
    skos:altLabel "workers' compensation claim"@en,
        "workers’ compensation"@en ;
    skos:definition "A benefit paid to workers for injuries sustained on the job."@en .

li:WoundRelatedInfection a owl:Class ;
