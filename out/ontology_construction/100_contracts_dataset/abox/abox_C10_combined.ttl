li:IndexRate a owl:Class ;
    rdfs:label "Rate applied to index gain for two strategies"@en ;
    rdfs:comment "A financial guarantee tied to the DJIA index performance. Induced via Stage 6 restriction induction; The property specifies a guaranteed minimum cap for the DJIA index, which is expressed as a decimal percentage. The evi…"@en,
        "Index-linked guarantee subject to maximum limit. Induced via Stage 6 restriction induction; The evidence states that index-linked amounts are not guaranteed beyond minimum values, indicating a hard cap, which is best mod…"@en,
        "The rate applied to index gain for two strategies in a life insurance contract. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PARTICIPATION_RATE; cluster of 1 surface…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:DJIACapGuarantee ;
            owl:someValuesFrom xsd:decimal ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty li:IndexLinkGuaranteeLimit ],
        li:Rate ;
    skos:definition "The rate applied to index gain for two strategies in a life insurance contract."@en .

