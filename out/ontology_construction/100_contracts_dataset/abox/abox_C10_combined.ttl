    rdfs:comment "Specifies the percentage of benefits that vest under specific service duration conditions in an insurance contract. Assigned domain=ServiceDuty, range=xsd:decimal; The property specifies the percentage of benefits that v…"@en ;
    rdfs:domain li:ServiceDuty ;
    rdfs:range xsd:decimal ;
    skos:altLabel "vests at 20% if less than 2 years of class a service"@en,
        "vests at 40% after 2 4 years of service"@en ;
    skos:definition "Specifies the percentage of benefits that vest under specific service duration conditions in an insurance contract."@en .

li:voidsNlg a owl:ObjectProperty ;
    rdfs:label "Voids Nlg"@en ;
    rdfs:comment "Indicates that one entity causes the cancellation or invalidation of a Non-Linear Guarantee (NLG). Assigned domain=Policyholder, range=PolicyFeature; The property indicates cancellation of a Non-Linear Guarantee, typical…"@en ;
    rdfs:domain li:Policyholder ;
    rdfs:range li:PolicyFeature ;
    skos:altLabel "contributes to cumulative nlg premiums"@en,
        "voidance of nlg triggered"@en ;
    skos:definition "Indicates that one entity causes the cancellation or invalidation of a Non-Linear Guarantee (NLG)."@en .

li:waiver a owl:ObjectProperty ;
    rdfs:label "Triggers Waiver"@en ;
    rdfs:comment "Indicates that a particular obligation or requirement is waived under the terms of the insurance contract. Assigned domain=DisabilityWaiver, range=TotalDisabilityDefinition; The property denotes the cancellation of a fin…"@en ;
    rdfs:domain li:DisabilityWaiver ;
    rdfs:range li:TotalDisabilityDefinition ;
    skos:altLabel "triggers premium waiver"@en ;
    skos:definition "Indicates that a particular obligation or requirement is waived under the terms of the insurance contract."@en .

li:waivesCharge a owl:ObjectProperty ;
    rdfs:label "Waives Charge"@en ;
    rdfs:comment "Indicates that a condition or clause in an insurance contract results in the elimination of a specified charge. Assigned domain=ChargeWaiver, range=ChargeWaiver; The property describes the elimination of a charge, which…"@en ;
    rdfs:domain li:ChargeWaiver ;
    rdfs:range li:ChargeWaiver ;
    skos:altLabel "contains fee schedule governing the waiver of face amount charge after year 10"@en,
        "determines applicability of charge before waiver"@en ;
    skos:definition "Indicates that a condition or clause in an insurance contract results in the elimination of a specified charge."@en .

li:yieldsLowerCreditWhenSubjectedToLateYearIndexChange a owl:DatatypeProperty ;
    rdfs:label "Yields Lower Credit When Subjected To Late Year Index Change"@en ;
    rdfs:comment "Indicates that a particular insurance contract or financial instrument results in reduced credit value when exposed to a late-year index change. Assigned domain=Rate, range=xsd:decimal; The property describes a credit re…"@en ;
    rdfs:domain li:Rate ;
    rdfs:range xsd:decimal ;
    skos:definition "Indicates that a particular insurance contract or financial instrument results in reduced credit value when exposed to a late-year index change."@en .

