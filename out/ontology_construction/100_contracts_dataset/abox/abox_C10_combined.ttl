    rdfs:comment "A condition specifying the minimum or average weekly work hours required for eligibility or coverage. Induced from a Placed as subClassOf EligibilityCriterion (Stage 5, confidence: high); cluster of 10 surface variant(s)…"@en ;
    rdfs:subClassOf li:EligibilityCriterion ;
    skos:altLabel "work hour requirement"@en,
        "work hours"@en ;
    skos:definition "A condition specifying the minimum or average weekly work hours required for eligibility or coverage."@en .

li:WorkUnit a owl:Class ;
    rdfs:label "Work Unit Of Employee"@en ;
    rdfs:comment "A unit of work performed by an employee, often used to determine insurance eligibility or benefits. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DEPARTMENT; cluster o…"@en ;
    rdfs:subClassOf li:EmploymentBasedCoverage ;
    skos:definition "A unit of work performed by an employee, often used to determine insurance eligibility or benefits."@en .

li:WorkerAutonomy a owl:Class ;
    rdfs:label "Worker Autonomy"@en ;
    rdfs:comment "The degree of independence a worker has in performing their job duties. Induced from a Placed as subClassOf RiskClassification (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:RiskClassification ;
    skos:definition "The degree of independence a worker has in performing their job duties."@en .

li:WorkerId a owl:Class ;
    rdfs:label "worker ID"@en ;
