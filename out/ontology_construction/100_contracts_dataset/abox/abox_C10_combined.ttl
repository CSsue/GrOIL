    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:AssignmentRequiresWrittenInstrument ;
            owl:someValuesFrom li:Document ],
        [ a owl:Restriction ;
            owl:onProperty li:FuneralHomeClosureEffect ;
