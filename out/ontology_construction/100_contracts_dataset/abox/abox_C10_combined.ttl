li:PolicyMaturityDate a owl:Class ;
    rdfs:label "Expiration Date"@en ;
    rdfs:comment "Endowment benefit is payable at policy maturity. Induced via Stage 6 restriction induction; The property defines a benefit triggered at maturity. The domain and range are both policy maturity dates, indicating a self-ref…"@en,
        "Maturity payout goes to the policy owner. Induced via Stage 6 restriction induction; The evidence confirms the maturity payout is made to the policy owner, establishing a direct relationship between PolicyMaturityDate an…"@en,
        "The date on which a life insurance policy expires or reaches maturity. Induced from a Placed as subClassOf PolicyMilestone (Stage 5, confidence: high); cluster of 35 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:EndowmentBenefitAtMaturity ;
            owl:someValuesFrom li:PolicyMaturityDate ],
        [ a owl:Restriction ;
            owl:onProperty li:MaturityPayoutToOwner ;
            owl:someValuesFrom li:PolicyOwner ],
        li:PolicyMilestone ;
    skos:altLabel "maturity date"@en,
        "policy maturity"@en ;
    skos:definition "The date on which a life insurance policy expires or reaches maturity."@en .

