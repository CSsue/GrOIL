li:IndexedAccount a owl:Class ;
    rdfs:label "Indexed Account With Capped Growth"@en ;
    rdfs:comment "An indexed enhancement is not guaranteed and depends on approval. Induced via Stage 6 restriction induction; Indexed enhancements are non-guaranteed and depend on approval or allocation rules. The property links indexed…"@en,
        "An investment account whose growth is linked to an index, potentially with a cap on returns. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ACCOUNT; cluster of 3 surfac…"@en,
        "Indexed credits use a specified formula. Induced via Stage 6 restriction induction; The property specifies the formula for calculating indexed credits, with domain 'IndexedAccount' and range 'CalculationFormula'. Evidenc…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:IndexedEnhancementGuaranteeCondition ;
            owl:someValuesFrom xsd:boolean ],
        [ a owl:Restriction ;
            owl:onProperty li:IndexedCreditFormula ;
            owl:someValuesFrom li:CalculationFormula ],
        li:InvestmentVehicle ;
    skos:altLabel "index account with cap"@en,
        "index-linked account without cap"@en ;
    skos:definition "An investment account whose growth is linked to an index, potentially with a cap on returns."@en .

