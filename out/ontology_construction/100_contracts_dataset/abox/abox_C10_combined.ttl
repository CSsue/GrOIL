li:EmployeeLifePremiumCost a owl:Class ;
    rdfs:label "Employee Share Of Basic Life Premium"@en ;
    rdfs:comment "Employee life coverage has a maximum limit. Induced via Stage 6 restriction induction; The sentence specifies a $350,000 cap on total employee life coverage, directly supporting a maximum cardinality constraint. The valu…"@en,
        "Employees must receive at least 40% of benefits. Induced via Stage 6 restriction induction; The evidence specifies a minimum 40% allocation to the employee’s personal benefit, directly supporting a cardinality constraint…"@en,
        "The portion of life insurance premium paid by the employee, including basic and optional coverage costs. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PAYMENT; cluster…"@en,
        "Vesting increases with years of service. Induced via Stage 6 restriction induction; The evidence shows vesting percentages increasing with service duration, culminating in full vesting after 8 years, directly linking the…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "40"^^xsd:nonNegativeInteger ;
            owl:onProperty li:hasMinimumEmployeeBenefitShare ],
        [ a owl:Restriction ;
            owl:maxCardinality "350000"^^xsd:nonNegativeInteger ;
            owl:onProperty li:MaxEmployeeLifeCoverageLimit ],
        [ a owl:Restriction ;
            owl:onProperty li:VestingScheduleByServiceDuration ;
            owl:someValuesFrom li:VestingSchedule ],
        li:Premium ;
    skos:altLabel "full employee cost of optional life premium"@en ;
    skos:definition "The portion of life insurance premium paid by the employee, including basic and optional coverage costs."@en .

li:EnrollmentWindow a owl:Class ;
