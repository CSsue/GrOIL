  <rdf:Description rdf:about="https://example.org/ontology/insurance#NonPaymentException">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nonpayment Exception</rdfs:label>
    <rdfs:comment xml:lang="en">A condition allowing coverage to continue without further premium payments. Induced from a Placed as subClassOf BenefitEligibilityCondition (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A condition allowing coverage to continue without further premium payments.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#BenefitEligibilityCondition"/>
    <skos:altLabel xml:lang="en">No Further Payments</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#WrittenNoticeRequirement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Written Notice Requirement</rdfs:label>
    <rdfs:comment xml:lang="en">A contractual obligation requiring written communication for specified actions or disclosures. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 3 surface variant(s) merged…</rdfs:comment>
    <skos:definition xml:lang="en">A contractual obligation requiring written communication for specified actions or disclosures.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
    <skos:altLabel xml:lang="en">state-specific notices</skos:altLabel>
    <skos:altLabel xml:lang="en">written notice</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#DocumentArtifact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Document Artifact</rdfs:label>
    <rdfs:comment xml:lang="en">A formal written or digital record that serves as evidence, authorization, or amendment within the insurance lifecycle. Induced from a Abstract class inferred by the LLM from corpus structure (Stage 5, Phase 1); not dire…</rdfs:comment>
