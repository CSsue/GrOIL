    <rdfs:label xml:lang="en">Policy Owner Rights</rdfs:label>
    <rdfs:comment xml:lang="en">The rights granted to the individual who holds ownership of a life insurance policy. Induced from a Placed as subClassOf Right (Stage 5, confidence: high); cluster of 23 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">The rights granted to the individual who holds ownership of a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Right"/>
    <skos:altLabel xml:lang="en">Policy Ownership</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#managesLoanDeductions">
