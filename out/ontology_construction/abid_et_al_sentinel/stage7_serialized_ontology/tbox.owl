    <rdfs:label xml:lang="en">Evidence Of Insurability</rdfs:label>
    <rdfs:comment xml:lang="en">A document or proof demonstrating an individual's eligibility for life insurance coverage. Induced from a Placed as subClassOf DocumentArtifact (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage…</rdfs:comment>
    <skos:definition xml:lang="en">A document or proof demonstrating an individual's eligibility for life insurance coverage.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#DocumentArtifact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasAuthorizedRepresentativeStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Authorized Representative Status</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the status of an individual who is authorized to act on behalf of the insured in matters related to the insurance contract. Assigned domain=Person, range=AuthorizedRepresentative; The property describes the sta…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the status of an individual who is authorized to act on behalf of the insured in matters related to the insurance contract.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Person"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#AuthorizedRepresentative"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#enablesReinstatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Enables Reinstatement</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a condition or feature allows the policyholder to reinstate a lapsed insurance policy. Assigned domain=Policy, range=Period; This property indicates conditions that allow policy reinstatement after lapse.…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates that a condition or feature allows the policyholder to reinstate a lapsed insurance policy.</skos:definition>
