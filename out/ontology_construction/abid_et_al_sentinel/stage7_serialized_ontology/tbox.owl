  <rdf:Description rdf:about="https://example.org/ontology/insurance#ContractualAgreement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Contractual Agreement Governing Coverage</rdfs:label>
    <rdfs:comment xml:lang="en">A formal agreement defining the terms of insurance coverage between parties. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf POLICY; cluster of 1 surface variant(s) merg…</rdfs:comment>
