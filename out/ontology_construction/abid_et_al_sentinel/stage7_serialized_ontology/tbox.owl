    <rdfs:label xml:lang="en">Manages Loan Deductions</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the entity or process that manages the deduction of loan payments from an insurance policy. Assigned domain=Policy, range=AdministrativeCharge; The property refers to the entity responsible for managing loan de…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the entity or process that manages the deduction of loan payments from an insurance policy.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Policy"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#AdministrativeCharge"/>
    <skos:altLabel xml:lang="en">triggers the condition under which loan deductions occur</skos:altLabel>
    <skos:altLabel xml:lang="en">determines the effective timeline for applying loan deductions</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#Premium">
