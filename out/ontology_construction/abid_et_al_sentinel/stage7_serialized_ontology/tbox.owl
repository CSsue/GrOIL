  <rdf:Description rdf:about="https://example.org/ontology/insurance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Life Insurance Policy TBox</rdfs:label>
    <dcterms:title xml:lang="en">Life Insurance Policy TBox</dcterms:title>
    <dcterms:description xml:lang="en">OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline.</dcterms:description>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-16</dcterms:created>
    <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</owl:versionInfo>
    <dcterms:creator rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Graph-Grounded Ontology Induction Pipeline (Stages 1-7)</dcterms:creator>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#PolicyContinuity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy Continuity</rdfs:label>
    <rdfs:comment xml:lang="en">The condition of a life insurance policy remaining active and in force without lapse. Induced from a Placed as subClassOf PolicyValidity (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">The condition of a life insurance policy remaining active and in force without lapse.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#PolicyValidity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#EvidenceOfInsurability">
