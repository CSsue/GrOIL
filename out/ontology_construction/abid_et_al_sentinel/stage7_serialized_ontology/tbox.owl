    <skos:altLabel xml:lang="en">enables recovery</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasAccessRightToPolicyCopy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Has Access Right To Policy Copy</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that an entity has the right to access a copy of a policy. Assigned domain=PolicyOwnerRights, range=DocumentAccess; This property grants access rights to a policy copy. The domain is PolicyOwnerRights, as it re…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates that an entity has the right to access a copy of a policy.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#PolicyOwnerRights"/>
