  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#StandardNonSmoker">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Standard Non-Smoker</rdfs:label>
    <rdfs:comment xml:lang="en">A life insurance policyholder classification for individuals who do not smoke and meet standard health criteria. Induced from a Placed as subClassOf RiskClassification (Stage 5, confidence: high); cluster of 1 surface va…</rdfs:comment>
    <skos:definition xml:lang="en">A life insurance policyholder classification for individuals who do not smoke and meet standard health criteria.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#RiskClassification"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#isPayoutConditionallyDuringActiveTerm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Is Payout Conditionally During Active Term</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a payout is granted only if the policy remains active during its term. Assigned domain=Policy, range=BenefitClaim; The property describes a condition on payout dependent on policy activity during its term.…</rdfs:comment>
