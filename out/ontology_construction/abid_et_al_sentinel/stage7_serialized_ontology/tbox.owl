    <rdfs:comment xml:lang="en">A periodic payment required to maintain ongoing life insurance coverage. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 3 surface variant(s) merged…</rdfs:comment>
    <skos:definition xml:lang="en">A periodic payment required to maintain ongoing life insurance coverage.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#FinancialObligation"/>
    <skos:altLabel xml:lang="en">periodic payment to maintain coverage</skos:altLabel>
    <skos:altLabel xml:lang="en">amount required for continued coverage</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#InsuredPerson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy Holder</rdfs:label>
    <rdfs:comment xml:lang="en">The individual whose life is covered by the life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PERSON; cluster of 12 surface variant(s) merged in Sta…</rdfs:comment>
    <rdfs:comment xml:lang="en">Policyholder must meet medical criteria for terminal illness benefits. Induced via Stage 6 restriction induction; The insured must be diagnosed with a terminal illness and have a life expectancy of 12 months or less, whi…</rdfs:comment>
    <skos:definition xml:lang="en">The individual whose life is covered by the life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Person"/>
    <rdfs:subClassOf rdf:nodeID="ndcae406620c04f0ca4369450c9cee757b27"/>
    <skos:altLabel xml:lang="en">insurance company</skos:altLabel>
    <skos:altLabel xml:lang="en">Insurer</skos:altLabel>
  </rdf:Description>
