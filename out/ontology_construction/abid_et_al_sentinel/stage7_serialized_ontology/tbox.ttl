### =========================================================
###  Ontology header
### =========================================================

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:created "2026-05-16"^^xsd:date ;
    owl:versionInfo "1.0"^^xsd:string ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string .


### =========================================================
###  Classes
### =========================================================

### Class: ins:Action
ins:Action
    a owl:Class ;
    rdfs:label "Action"@en ;
    rdfs:comment "A procedural or operational event within a life insurance contract. Induced from a Placed as subClassOf ProceduralEvent (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    skos:definition "A procedural or operational event within a life insurance contract."@en ;
    rdfs:subClassOf ins:ProceduralEvent .

### Class: ins:ActiveStatusRestoration
ins:ActiveStatusRestoration
    a owl:Class ;
    rdfs:label "Active Status Restoration"@en ;
    rdfs:comment "The process of reinstating a life insurance policy to active status after lapse. Induced from a Placed as subClassOf PolicyRestoration (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    skos:definition "The process of reinstating a life insurance policy to active status after lapse."@en ;
    rdfs:subClassOf ins:PolicyRestoration .

### Class: ins:AdministrativeCharge
ins:AdministrativeCharge
