@prefix abox: <https://example.org/ontology/insurance/abox#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix li: <https://example.org/ontology/insurance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    owl:versionInfo "1.0"^^xsd:string .

li:ActiveStatusRestoration a owl:Class ;
    rdfs:label "Active Status Restoration"@en ;
    rdfs:comment "The process of reinstating a life insurance policy to active status after lapse. Induced from a Placed as subClassOf PolicyRestoration (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyRestoration ;
    skos:definition "The process of reinstating a life insurance policy to active status after lapse."@en .

li:AgeOrGenderMisstatement a owl:Class ;
    rdfs:label "Issue Age"@en ;
    rdfs:comment "A misrepresentation of the insured's age or gender at the time of policy issuance. Induced from a Placed as subClassOf MaterialMisrepresentation (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:MaterialMisrepresentation ;
    skos:altLabel "Misstatement of Age or Gender"@en,
        "age misstatement"@en ;
    skos:definition "A misrepresentation of the insured's age or gender at the time of policy issuance."@en .

li:AssignmentRights a owl:Class ;
    rdfs:label "Assignment Rights"@en ;
    rdfs:comment "The legal right to assign ownership or benefits of a life insurance policy. Induced from a Placed as subClassOf PolicyOwnerRights (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyOwnerRights ;
    skos:altLabel "Assignment Validity"@en ;
    skos:definition "The legal right to assign ownership or benefits of a life insurance policy."@en .

li:AuthorizedSignature a owl:Class ;
    rdfs:label "Officer Signature Requirement"@en ;
    rdfs:comment "A signature authorized to legally bind a corporate entity in a life insurance contract. Induced from a Placed as subClassOf AuthorizedRepresentative (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in…"@en ;
    rdfs:subClassOf li:AuthorizedRepresentative ;
    skos:altLabel "Corporate Signatures"@en,
        "authorized signature"@en ;
    skos:definition "A signature authorized to legally bind a corporate entity in a life insurance contract."@en .

li:BeneficiaryRelationship a owl:Class ;
    rdfs:label "Beneficiary Relationship"@en ;
    rdfs:comment "A familial or designated connection between a policyholder and a beneficiary. Induced from a Placed as subClassOf Designation (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Designation ;
    skos:altLabel "family relationship"@en ;
    skos:definition "A familial or designated connection between a policyholder and a beneficiary."@en .

li:BenefitConditions a owl:Class ;
    rdfs:label "Schedule of Benefits"@en ;
    rdfs:comment "Conditions governing eligibility and terms for receiving insurance benefits. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "benefit conditions"@en,
        "benefit eligibility"@en ;
    skos:definition "Conditions governing eligibility and terms for receiving insurance benefits."@en .

li:CompanyAuthority a owl:Class ;
    rdfs:label "Company Officer Authority"@en ;
    rdfs:comment "A designation granting an individual authority to act on behalf of the insurance company. Induced from a Placed as subClassOf AuthorizedRepresentative (Stage 5, confidence: high); cluster of 5 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:AuthorizedRepresentative ;
    skos:altLabel "company authority"@en,
        "executive authority"@en ;
    skos:definition "A designation granting an individual authority to act on behalf of the insurance company."@en .

li:CompanyDiscretion a owl:Class ;
    rdfs:label "Company Discretion"@en ;
    rdfs:comment "A contractual provision allowing the insurance company to approve or deny a request at its discretion. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 5 surface variant(s)…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "Company Approval"@en,
        "company approval"@en ;
    skos:definition "A contractual provision allowing the insurance company to approve or deny a request at its discretion."@en .

li:ConversionRight a owl:Class ;
    rdfs:label "Conversion Rights"@en ;
    rdfs:comment "A policyholder's ability to convert a term life insurance policy to a permanent one under specified conditions. Induced from a Placed as subClassOf Right (Stage 5, confidence: high); cluster of 3 surface variant(s) merge…"@en ;
    rdfs:subClassOf li:Right ;
    skos:altLabel "conversion option"@en,
        "conversion rules"@en ;
    skos:definition "A policyholder's ability to convert a term life insurance policy to a permanent one under specified conditions."@en .

li:CoverageActivation a owl:Class ;
    rdfs:label "Policy Activation"@en ;
    rdfs:comment "The event or process that initiates the coverage provided by a life insurance policy. Induced from a Placed as subClassOf ProceduralEvent (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ProceduralEvent ;
    skos:altLabel "Coverage Activation"@en ;
    skos:definition "The event or process that initiates the coverage provided by a life insurance policy."@en .

li:CoverageTerm a owl:Class ;
    rdfs:label "Coverage Term"@en ;
    rdfs:comment "The period during which insurance coverage is active and benefits are payable. Induced from a Placed as subClassOf CoveragePeriod (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:CoveragePeriod ;
    skos:altLabel "coverage commencement"@en,
        "coverage limitations"@en ;
    skos:definition "The period during which insurance coverage is active and benefits are payable."@en .

li:DocumentVerification a owl:Class ;
    rdfs:label "Document Verification"@en ;
    rdfs:comment "The process of confirming the authenticity and validity of a document. Induced from a Placed as subClassOf ProceduralEvent (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ProceduralEvent ;
    skos:altLabel "Document Identification"@en ;
    skos:definition "The process of confirming the authenticity and validity of a document."@en .

li:EvidenceOfInsurability a owl:Class ;
    rdfs:label "Evidence Of Insurability"@en ;
    rdfs:comment "A document or proof demonstrating an individual's eligibility for life insurance coverage. Induced from a Placed as subClassOf DocumentArtifact (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf li:DocumentArtifact ;
    skos:definition "A document or proof demonstrating an individual's eligibility for life insurance coverage."@en .

li:ExecutionTimeline a owl:Class ;
    rdfs:label "Execution Timeline"@en ;
    rdfs:comment "Conditions and timing governing the execution of a life insurance contract. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "execution conditions"@en ;
    skos:definition "Conditions and timing governing the execution of a life insurance contract."@en .

li:FelonyInvolvement a owl:Class ;
    rdfs:label "Felony Involvement"@en ;
    rdfs:comment "A legal status indicating involvement in a felony offense. Induced from a Placed as subClassOf LegalStatus (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LegalStatus ;
    skos:definition "A legal status indicating involvement in a felony offense."@en .

li:Gender a owl:Class ;
    rdfs:label "Gender"@en ;
    rdfs:comment "A biological or social attribute indicating male, female, or other gender identity. Induced from a Placed as subClassOf Person (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Person ;
    skos:definition "A biological or social attribute indicating male, female, or other gender identity."@en .

li:GuaranteedTermPeriod a owl:Class ;
    rdfs:label "Guaranteed Term Period"@en ;
    rdfs:comment "The fixed period during which policy terms are guaranteed and cannot be altered. Induced from a Placed as subClassOf ContractualTerm (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualTerm ;
    skos:altLabel "Policy Duration"@en,
        "term expiration"@en ;
    skos:definition "The fixed period during which policy terms are guaranteed and cannot be altered."@en .

li:IncontestabilityPeriod a owl:Class ;
    rdfs:label "Incontestability Period"@en ;
    rdfs:comment "A time period during which the insurer cannot contest the validity of a life insurance policy. Induced from a Placed as subClassOf ContestabilityPeriod (Stage 5, confidence: high); cluster of 3 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ContestabilityPeriod ;
    skos:altLabel "Incontestability"@en,
        "incontestability"@en ;
    skos:definition "A time period during which the insurer cannot contest the validity of a life insurance policy."@en .

li:LoanAvailability a owl:Class ;
    rdfs:label "Automatic Premium Loan"@en ;
    rdfs:comment "The availability of a loan option within a life insurance policy, including automatic premium loan features. Induced from a Placed as subClassOf FinancialObligation (Stage 5, confidence: high); cluster of 3 surface varia…"@en ;
    rdfs:subClassOf li:FinancialObligation ;
    skos:altLabel "Loan Value Availability"@en,
        "Policy Loan"@en ;
    skos:definition "The availability of a loan option within a life insurance policy, including automatic premium loan features."@en .

li:LumpSumPayout a owl:Class ;
    rdfs:label "Lump Sum Payout"@en ;
    rdfs:comment "A single, immediate payment made upon the occurrence of a specified event. Induced from a Placed as subClassOf BenefitClaim (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitClaim ;
    skos:definition "A single, immediate payment made upon the occurrence of a specified event."@en .

li:MaterialFact a owl:Class ;
    rdfs:label "Material Facts"@en ;
    rdfs:comment "A fact that is significant enough to influence an insurance decision. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A fact that is significant enough to influence an insurance decision."@en .

li:MonthlyBankDraft a owl:Class ;
    rdfs:label "Monthly Bank Draft"@en ;
    rdfs:comment "A recurring payment method where premiums are deducted monthly from a bank account. Induced from a Placed as subClassOf PremiumPaymentMode (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PremiumPaymentMode ;
    skos:definition "A recurring payment method where premiums are deducted monthly from a bank account."@en .

li:NonPaymentException a owl:Class ;
    rdfs:label "Nonpayment Exception"@en ;
    rdfs:comment "A condition allowing coverage to continue without further premium payments. Induced from a Placed as subClassOf BenefitEligibilityCondition (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitEligibilityCondition ;
    skos:altLabel "No Further Payments"@en ;
    skos:definition "A condition allowing coverage to continue without further premium payments."@en .

li:PaymentCap a owl:Class ;
    rdfs:label "Payment Cap"@en ;
    rdfs:comment "A maximum limit on the amount payable under a life insurance policy. Induced from a Placed as subClassOf BenefitLimit (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitLimit ;
    skos:definition "A maximum limit on the amount payable under a life insurance policy."@en .

li:PayoutDesignation a owl:Class ;
    rdfs:label "Payout Designation"@en ;
    rdfs:comment "A designation specifying how a life insurance payout is to be distributed. Induced from a Placed as subClassOf Designation (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Designation ;
    skos:definition "A designation specifying how a life insurance payout is to be distributed."@en .

li:PolicyIssuingOffice a owl:Class ;
    rdfs:label "Hartford, Connecticut"@en ;
    rdfs:comment "An entity responsible for issuing a life insurance policy, located in Hartford, Connecticut. Induced from a Placed as subClassOf CorporateEntity (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:CorporateEntity ;
    skos:definition "An entity responsible for issuing a life insurance policy, located in Hartford, Connecticut."@en .

li:PolicyWaiver a owl:Class ;
    rdfs:label "Policy Waivers"@en ;
    rdfs:comment "A provision that exempts the policyholder from paying premiums under specified conditions. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in S…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A provision that exempts the policyholder from paying premiums under specified conditions."@en .

li:PremiumEquivalence a owl:Class ;
    rdfs:label "Premium Equivalence"@en ;
    rdfs:comment "A condition where the premium amount remains unchanged despite policy changes. Induced from a Placed as subClassOf PremiumStability (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PremiumStability ;
    skos:definition "A condition where the premium amount remains unchanged despite policy changes."@en .

li:PrincipalOfficeAddress a owl:Class ;
    rdfs:label "Principal Office Address"@en ;
    rdfs:comment "The primary physical address of an organization's main office. Induced from a Placed as subClassOf Location (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Location ;
    skos:definition "The primary physical address of an organization's main office."@en .

li:ReasonableTimeframe a owl:Class ;
    rdfs:label "Reasonable Timeframe"@en ;
    rdfs:comment "A period of time considered fair and appropriate for completing a specified action. Induced from a Placed as subClassOf TemporalConcept (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:TemporalConcept ;
    skos:definition "A period of time considered fair and appropriate for completing a specified action."@en .

li:RegulatoryVariation a owl:Class ;
    rdfs:label "Regulatory Variations"@en ;
    rdfs:comment "A variation in insurance requirements imposed by regulatory authorities. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A variation in insurance requirements imposed by regulatory authorities."@en .

li:RenewalOption a owl:Class ;
    rdfs:label "Policy Renewal Options"@en ;
    rdfs:comment "A provision specifying the conditions under which a life insurance policy may be renewed. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in St…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "renewal option"@en,
        "renewal requirement"@en ;
    skos:definition "A provision specifying the conditions under which a life insurance policy may be renewed."@en .

li:RequestProcessing a owl:Class ;
    rdfs:label "Request Processing"@en ;
    rdfs:comment "The process of handling and managing requests within a life insurance contract. Induced from a Placed as subClassOf ProceduralEvent (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ProceduralEvent ;
    skos:definition "The process of handling and managing requests within a life insurance contract."@en .

li:RevocationOption a owl:Class ;
    rdfs:label "Revocation Option"@en ;
    rdfs:comment "A provision allowing the policyholder to cancel or withdraw a life insurance policy. Induced from a Placed as subClassOf CancellationAbility (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:CancellationAbility ;
    skos:altLabel "revocation process"@en ;
    skos:definition "A provision allowing the policyholder to cancel or withdraw a life insurance policy."@en .

li:RightToExaminePolicy a owl:Class ;
    rdfs:label "Right to Examine Policy"@en ;
    rdfs:comment "The right of a policyholder to review a life insurance policy and request information within a specified period. Induced from a Placed as subClassOf Right (Stage 5, confidence: high); cluster of 3 surface variant(s) merg…"@en ;
    rdfs:subClassOf li:Right ;
    skos:altLabel "Right to Examine"@en,
        "Right to Request Information"@en ;
    skos:definition "The right of a policyholder to review a life insurance policy and request information within a specified period."@en .

li:RiskCondition a owl:Class ;
    rdfs:label "Risk Condition"@en ;
    rdfs:comment "A factor, circumstance, or state that influences the assessment, acceptance, or management of risk in an insurance context. Induced from a Abstract class inferred by the LLM from corpus structure (Stage 5, Phase 1); not…"@en ;
    rdfs:subClassOf owl:Thing ;
    skos:definition "A factor, circumstance, or state that influences the assessment, acceptance, or management of risk in an insurance context."@en .

li:SemiAnnualBilling a owl:Class ;
    rdfs:label "Semi-Annual Billing"@en ;
    rdfs:comment "A billing frequency occurring twice per year, every six months. Induced from a Placed as subClassOf PremiumPaymentMode (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PremiumPaymentMode ;
    skos:definition "A billing frequency occurring twice per year, every six months."@en .

li:SpousalDesignation a owl:Class ;
    rdfs:label "Spousal Designation"@en ;
    rdfs:comment "A designation of a spouse as a beneficiary or recipient in a life insurance policy. Induced from a Placed as subClassOf Beneficiary (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Beneficiary ;
    skos:definition "A designation of a spouse as a beneficiary or recipient in a life insurance policy."@en .

li:StandardNonSmoker a owl:Class ;
    rdfs:label "Standard Non-Smoker"@en ;
    rdfs:comment "A life insurance policyholder classification for individuals who do not smoke and meet standard health criteria. Induced from a Placed as subClassOf RiskClassification (Stage 5, confidence: high); cluster of 1 surface va…"@en ;
    rdfs:subClassOf li:RiskClassification ;
    skos:definition "A life insurance policyholder classification for individuals who do not smoke and meet standard health criteria."@en .

li:TerminalIllnessBenefit a owl:Class ;
    rdfs:label "Terminal Illness"@en ;
    rdfs:comment "A benefit payable upon diagnosis of a terminal illness as defined in the policy. Induced from a Placed as subClassOf BenefitClaim (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitClaim ;
    skos:altLabel "Terminal Illness Coverage"@en,
        "Terminal Illness Payout"@en ;
    skos:definition "A benefit payable upon diagnosis of a terminal illness as defined in the policy."@en .

li:TwoYearClause a owl:Class ;
    rdfs:label "20-Year Coverage"@en ;
    rdfs:comment "A time-based limitation in a life insurance policy that restricts claims during the first two years. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 7 surface variant(s) m…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "Two-Year Rule"@en,
        "two-year period"@en ;
    skos:definition "A time-based limitation in a life insurance policy that restricts claims during the first two years."@en .

li:VoidFromInception a owl:Class ;
    rdfs:label "Void From Inception"@en ;
    rdfs:comment "A policy status indicating the contract is invalid from its beginning. Induced from a Placed as subClassOf PolicyValidity (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyValidity ;
    skos:definition "A policy status indicating the contract is invalid from its beginning."@en .

li:WarRelatedActivity a owl:Class ;
    rdfs:label "War-Related Activities"@en ;
    rdfs:comment "An activity involving participation in armed conflict or military operations. Induced from a Placed as subClassOf Action (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Action ;
    skos:definition "An activity involving participation in armed conflict or military operations."@en .

li:WrittenAmendment a owl:Class ;
    rdfs:label "Written Amendments"@en ;
    rdfs:comment "A formal, documented change to a life insurance contract. Induced from a Placed as subClassOf PolicyAdjustment (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyAdjustment ;
    skos:definition "A formal, documented change to a life insurance contract."@en .

li:WrittenConsent a owl:Class ;
    rdfs:label "Written Consent"@en ;
    rdfs:comment "A written authorization granting permission for a specific action or disclosure. Induced from a Placed as subClassOf ContractualAgreement (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualAgreement ;
    skos:altLabel "written authorization"@en ;
    skos:definition "A written authorization granting permission for a specific action or disclosure."@en .

li:WrittenNoticeRequirement a owl:Class ;
    rdfs:label "Written Notice Requirement"@en ;
    rdfs:comment "A contractual obligation requiring written communication for specified actions or disclosures. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 3 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "state-specific notices"@en,
        "written notice"@en ;
    skos:definition "A contractual obligation requiring written communication for specified actions or disclosures."@en .

li:additionalDocumentationRequirement a owl:ObjectProperty ;
    rdfs:label "Additional Documentation Requirement"@en ;
    rdfs:comment "Indicates a requirement for additional documentation as specified in the insurance contract. Assigned domain=Action, range=DocumentAccess; This property specifies a requirement for additional documentation, typically tri…"@en ;
    rdfs:domain li:Action ;
    rdfs:range li:DocumentAccess ;
    skos:altLabel "Additional Documentation Authority"@en,
        "Timely Provision of Policy Info"@en ;
    skos:definition "Indicates a requirement for additional documentation as specified in the insurance contract."@en .

li:administersCoverage a owl:ObjectProperty ;
    rdfs:label "Administers Coverage"@en ;
    rdfs:comment "Indicates that an entity administers the coverage provided in an insurance contract. Assigned domain=Insurer, range=LifeInsuranceCoverage; The property indicates an entity responsible for managing coverage. Graph signals…"@en ;
    rdfs:domain li:Insurer ;
    rdfs:range li:LifeInsuranceCoverage ;
    skos:altLabel "administers"@en,
        "supervises"@en ;
    skos:definition "Indicates that an entity administers the coverage provided in an insurance contract."@en .

li:affectedByChangeEffectiveOnSignatureDate a owl:ObjectProperty ;
    rdfs:label "Affected By Change Effective On Signature Date"@en ;
    rdfs:comment "Indicates that an entity is affected by a change whose effective date is the signature date of the insurance contract. Assigned domain=Person, range=EffectiveDate; This property links a person to a change whose effective…"@en ;
    rdfs:domain li:Person ;
    rdfs:range li:EffectiveDate ;
    skos:altLabel "Change Effective on Signature Date"@en ;
    skos:definition "Indicates that an entity is affected by a change whose effective date is the signature date of the insurance contract."@en .

li:authorizes a owl:ObjectProperty ;
    rdfs:label "Requires Authorization"@en ;
    rdfs:comment "Indicates that one party is granted the authority to perform a specific action or obligation by another party in the context of an insurance contract. Assigned domain=Insurer, range=AuthorizedRepresentative; The property…"@en ;
    rdfs:domain li:Insurer ;
    rdfs:range li:AuthorizedRepresentative ;
    skos:altLabel "requires written authorization"@en ;
    skos:definition "Indicates that one party is granted the authority to perform a specific action or obligation by another party in the context of an insurance contract."@en .

li:canBeCoveredByPolicyLoan a owl:ObjectProperty ;
    rdfs:label "Conditional On Loan Value"@en ;
    rdfs:comment "Indicates that a financial obligation, such as unpaid premiums, can be satisfied using an available policy loan. Assigned domain=UnpaidPremium, range=Policy; The property indicates that a financial obligation (e.g., unpa…"@en ;
    rdfs:domain li:UnpaidPremium ;
    rdfs:range li:Policy ;
    skos:altLabel "can satisfy advance payment requirement using policy loans"@en,
        "controls loan value"@en ;
    skos:definition "Indicates that a financial obligation, such as unpaid premiums, can be satisfied using an available policy loan."@en .

li:changeInPremiumFrequency a owl:ObjectProperty ;
    rdfs:label "Change in Premium Frequency"@en ;
    rdfs:comment "Indicates a change in the frequency with which premiums are paid, such as from monthly to annually. Assigned domain=Policy, range=PremiumPaymentMode; The property describes a change in premium payment frequency, which is…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:PremiumPaymentMode ;
    skos:altLabel "Change in Premium Mode Approval"@en,
        "Change in Premium Mode Process"@en ;
    skos:definition "Indicates a change in the frequency with which premiums are paid, such as from monthly to annually."@en .

li:dependsOnLifeExpectancyCertification a owl:ObjectProperty ;
    rdfs:label "Depends On Life Expectancy Certification"@en ;
    rdfs:comment "Indicates that a policy or benefit conditionally depends on the certification of life expectancy. Assigned domain=Policy, range=MedicalVerification; The property indicates a conditionality based on life expectancy certif…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:MedicalVerification ;
    skos:definition "Indicates that a policy or benefit conditionally depends on the certification of life expectancy."@en .

li:detectsOrEvaluates a owl:ObjectProperty ;
    rdfs:label "Detects Or Evaluates"@en ;
    rdfs:comment "Indicates the relationship where an entity detects or evaluates another entity within the context of an insurance contract. Assigned domain=Insurer, range=ClaimProcessing; This property describes a monitoring or assessme…"@en ;
    rdfs:domain li:Insurer ;
    rdfs:range li:ClaimProcessing ;
    skos:definition "Indicates the relationship where an entity detects or evaluates another entity within the context of an insurance contract."@en .

li:determinesBenefitDistributionPath a owl:ObjectProperty ;
