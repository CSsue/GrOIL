li:hasPolicyDefinition a owl:DatatypeProperty ;
    rdfs:label "Definition of Policy"@en ;
    rdfs:comment "Specifies the textual definition or description of the insurance policy. Assigned domain=Policy, range=xsd:string; This property provides a textual description of the policy. Graph signals show PERSON as the source, but…"@en ;
