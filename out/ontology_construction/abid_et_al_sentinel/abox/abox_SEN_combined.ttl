    rdfs:comment "A unique identifier assigned to a life insurance policy. Induced from a Placed as subClassOf PolicyAttribute (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyAttribute ;
    skos:altLabel "Policy Form Number"@en ;
    skos:definition "A unique identifier assigned to a life insurance policy."@en .

li:PremiumWaiverMechanism a owl:Class ;
    rdfs:label "Mechanism Covering Missed Premiums Via Policy Loans"@en ;
