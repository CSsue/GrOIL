    rdfs:comment "Relates an insurance contract or clause to its associated temporal constraints or scheduling information. Assigned domain=Clause, range=EffectiveDate; The property relates an entity to temporal constraints such as dates…"@en ;
    rdfs:domain li:Clause ;
    rdfs:range li:EffectiveDate ;
    skos:altLabel "date"@en,
        "period"@en ;
    skos:definition "Relates an insurance contract or clause to its associated temporal constraints or scheduling information."@en .

li:hasTwoYearContestabilityClause a owl:ObjectProperty ;
    rdfs:label "Two-Year Contestability Clause"@en ;
    rdfs:comment "Indicates that an insurance policy includes a two-year contestability clause, which allows the insurer to investigate and potentially deny claims during the first two years of the policy. Assigned domain=Policy, range=Cl…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:Clause ;
    skos:definition "Indicates that an insurance policy includes a two-year contestability clause, which allows the insurer to investigate and potentially deny claims during the first two years of the policy."@en .

li:initiatesOrSupports a owl:ObjectProperty ;
    rdfs:label "Initiates Or Supports"@en ;
    rdfs:comment "Indicates that one entity initiates or supports another entity within the context of an insurance contract. Assigned domain=Person, range=Person; The property indicates one entity initiating or supporting another in a co…"@en ;
    rdfs:domain li:Person ;
    rdfs:range li:Person ;
    skos:altLabel "is required to initiate"@en ;
    skos:definition "Indicates that one entity initiates or supports another entity within the context of an insurance contract."@en .

li:isBeneficiaryOf a owl:ObjectProperty ;
    rdfs:label "Is Beneficiary Of"@en ;
    rdfs:comment "Indicates that one entity is designated as a beneficiary of a specific insurance benefit or policy. Assigned domain=Person, range=Policy; The property indicates that a person is designated as a beneficiary of a policy. T…"@en ;
    rdfs:domain li:Person ;
    rdfs:range li:Policy ;
    skos:altLabel "beneficiary of death benefit"@en,
        "primary beneficiary"@en ;
    skos:definition "Indicates that one entity is designated as a beneficiary of a specific insurance benefit or policy."@en .

li:isDeterminedByMostRecentWrittenDesignationFromCompanyRecord a owl:ObjectProperty ;
    rdfs:label "Is Determined By Most Recent Written Designation From Company Record"@en ;
    rdfs:comment "This property indicates that a particular entity or value is determined by the most recent written designation recorded by the insurance company. Assigned domain=Policy, range=Designation; The property links a financial…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:Designation ;
    skos:definition "This property indicates that a particular entity or value is determined by the most recent written designation recorded by the insurance company."@en .

li:isEligibleForRefund a owl:ObjectProperty ;
    rdfs:label "Is Eligible For Refund"@en ;
    rdfs:comment "Indicates that a party or policyholder is eligible to receive a refund under specified conditions. Assigned domain=Policy, range=Right; Eligibility for refund is a right held by the policyholder under specific conditions…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:Right ;
    skos:altLabel "conditions refund"@en,
        "has right to return"@en ;
    skos:definition "Indicates that a party or policyholder is eligible to receive a refund under specified conditions."@en .

li:isExcludedFromAcceleratedBenefitDueToWarRelatedCause a owl:ObjectProperty ;
    rdfs:label "May Be Ineligible For Accelerated Benefit If Illness Stems From War Related Activities"@en ;
    rdfs:comment "Indicates that a policyholder may be ineligible for an accelerated benefit if the illness is determined to stem from war-related activities. Assigned domain=Exclusion, range=Exclusion; The property indicates exclusion fr…"@en ;
    rdfs:domain li:Exclusion ;
    rdfs:range li:Exclusion ;
    skos:altLabel "is excluded from payment when terminal illness is caused by war related activities"@en ;
    skos:definition "Indicates that a policyholder may be ineligible for an accelerated benefit if the illness is determined to stem from war-related activities."@en .

li:isPayoutConditionallyDuringActiveTerm a owl:ObjectProperty ;
    rdfs:label "Is Payout Conditionally During Active Term"@en ;
    rdfs:comment "Indicates that a payout is granted only if the policy remains active during its term. Assigned domain=Policy, range=BenefitClaim; The property describes a condition on payout dependent on policy activity during its term.…"@en ;
    rdfs:domain li:Policy ;
    rdfs:range li:BenefitClaim ;
    skos:altLabel "may receive if policy remains in force"@en,
        "remains payable only if policy is active post term"@en ;
    skos:definition "Indicates that a payout is granted only if the policy remains active during its term."@en .

li:isSubjectToRevocation a owl:ObjectProperty ;
    rdfs:label "Is Subject To Revocation"@en ;
    rdfs:comment "Indicates that an insurance contract is subject to revocation under specified conditions. Assigned domain=Person, range=Right; The property links a subject (typically a person or entity) to a right related to revocation.…"@en ;
