    rdfs:comment "Indicates that a party may authorize actions related to a claim, without affecting the deduction rules applied to the claim. Assigned domain=Role, range=Action; This property describes a role's authority to authorize cla…"@en ;
    rdfs:domain li:Role ;
    rdfs:range li:Action ;
    skos:definition "Indicates that a party may authorize actions related to a claim, without affecting the deduction rules applied to the claim."@en .

li:mayInitiateAssignmentWithoutCompanyValidation a owl:ObjectProperty ;
