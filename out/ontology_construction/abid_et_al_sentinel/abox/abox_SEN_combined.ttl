li:adjustsInsuranceAmountBasedOnCorrectedAge a owl:ObjectProperty ;
    rdfs:label "Adjusts Insurance Amount Based On Corrected Age"@en ;
    rdfs:comment "Indicates that the insurance amount is adjusted in response to a correction in the insured's age. Assigned domain=Insurer, range=Amount; This property describes a change in insurance amount due to corrected age, which di…"@en ;
