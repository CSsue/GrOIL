li:AdministrativeCharge a owl:Class ;
    rdfs:label "Administrative Charges"@en ;
    rdfs:comment "A fee imposed for administrative services related to a life insurance policy. Induced from a Placed as subClassOf FinancialObligation (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en,
        "Administrative charges reduce the death benefit. Induced via Stage 6 restriction induction; The property 'administersDeathBenefitTerms' is selected as it best captures the effect of administrative charges on death benefi…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:administersDeathBenefitTerms ;
            owl:someValuesFrom li:DeathBenefit ],
        li:FinancialObligation ;
    skos:definition "A fee imposed for administrative services related to a life insurance policy."@en .

