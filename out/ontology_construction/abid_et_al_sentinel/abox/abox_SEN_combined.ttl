li:LifeInsuranceCoverage a owl:Class ;
    rdfs:label "Level Term Life Insurance"@en ;
    rdfs:comment "A type of insurance providing financial benefits upon the insured's death within a specified term. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 9 surface variant(s) merged in S…"@en,
        "Accelerated benefit payment is constrained by a specified limit. Induced via Stage 6 restriction induction; The evidence indicates a maximum limit on accelerated benefit payments, implying a cardinality constraint on the…"@en,
        "Death by suicide within two years excludes claim eligibility. Induced via Stage 6 restriction induction; The property defines a claim exclusion for suicide within two years, consistent with the range Exclusion. The evide…"@en,
        "Policyholder excluded from coverage for war-related claims. Induced via Stage 6 restriction induction; The evidence specifies that claims from war-related activities are excluded, and this exclusion is formalized as a cl…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:triggersExclusion ;
            owl:someValuesFrom li:Exclusion ],
        [ a owl:Restriction ;
            owl:onProperty li:SuicideExclusion ;
            owl:someValuesFrom li:Exclusion ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty li:hasAcceleratedDeathBenefitRider ],
        li:DeathBenefit ;
    skos:altLabel "Insured Survival Status"@en,
        "Life Insurance Coverage"@en ;
    skos:definition "A type of insurance providing financial benefits upon the insured's death within a specified term."@en .

