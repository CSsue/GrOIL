### =========================================================
###  Ontology header
### =========================================================

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:created "2026-05-17"^^xsd:date ;
    owl:versionInfo "1.0"^^xsd:string ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string .


### =========================================================
###  Classes
### =========================================================

### Class: ins:LifeInsurancePolicy  [ONTOLOGY ROOT]
ins:LifeInsurancePolicy
    a owl:Class ;
    rdfs:label "Life Insurance Policy"@en ;
    rdfs:comment "The root concept of this ontology. Represents a life insurance policy as a whole; all domain classes are subsumed under this concept."@en ;
    skos:definition "The root concept of this ontology. Represents a life insurance policy as a whole; all domain classes are subsumed under this concept."@en ;
    rdfs:subClassOf owl:Thing .

### Class: ins:AccelerationLimit
ins:AccelerationLimit
    a owl:Class ;
    rdfs:label "Minimum Acceleration Amount Allowed"@en ;
    rdfs:comment "The maximum or minimum amount that may be accelerated in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf FINANCIAL_VALUE; cluster of 2 surface v…"@en ;
    skos:definition "The maximum or minimum amount that may be accelerated in a life insurance policy."@en ;
    rdfs:subClassOf ins:MonetaryValue ;
    skos:altLabel "maximum acceleration limit"@en .

### Class: ins:AccidentalDeathBenefit
ins:AccidentalDeathBenefit
    a owl:Class ;
    rdfs:label "Pays Extra Death Benefit For Accident-Caused Fatalities"@en ;
    rdfs:comment "A supplemental death benefit paid when death is caused by an accident. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf RIDERS; cluster of 1 surface variant(s) merged in…"@en ;
    skos:definition "A supplemental death benefit paid when death is caused by an accident."@en ;
    rdfs:subClassOf ins:Rider .

### Class: ins:AccountAccess
ins:AccountAccess
    a owl:Class ;
    rdfs:label "Account Value Access"@en ;
