    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ins:PolicyContinuationOnSurvival ;
        owl:someValuesFrom ins:TerminationCondition
    ] ;
    rdfs:comment "Policy continues if insured survives specified period. Induced via Stage 6 restriction induction; The evidence shows that policy continuation depends on the insured's survival, which is governed by termination conditions…"@en .

