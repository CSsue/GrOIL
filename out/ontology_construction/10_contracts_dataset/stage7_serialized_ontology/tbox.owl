    <rdfs:label xml:lang="en">Indicates Full Funding Level</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the funding level of an insurance contract, specifying whether it is fully funded. Assigned domain=InsuranceContract, range=xsd:string; The property links an insurance contract to a literal indicating its fundi…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the funding level of an insurance contract, specifying whether it is fully funded.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
