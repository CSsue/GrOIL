  <rdf:Description rdf:about="https://example.org/ontology/insurance#accruesInterest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Affected By Interest Accrual On Policy Loan</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates that a policy loan or financial obligation is subject to the accumulation of interest over time. Assigned domain=PolicyLoan, range=InterestCrediting; The property 'accruesInterest' describes a financial obligat…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates that a policy loan or financial obligation is subject to the accumulation of interest over time.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#PolicyLoan"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#InterestCrediting"/>
    <skos:altLabel xml:lang="en">accrues interest</skos:altLabel>
    <skos:altLabel xml:lang="en">has interest payment</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#CostOfInsuranceChargeFormula">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Formula For Monthly Cost-Of-Insurance Charge</rdfs:label>
    <rdfs:comment xml:lang="en">A formula used to calculate the monthly cost-of-insurance charge in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CALCULATION; cluster of 1 su…</rdfs:comment>
    <skos:definition xml:lang="en">A formula used to calculate the monthly cost-of-insurance charge in a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#EmployeeInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Employee Information</rdfs:label>
    <rdfs:comment xml:lang="en">Information related to an employee's identity, employment status, and contribution details in a life insurance context. Induced from a Placed as subClassOf InsuranceContract (Stage 5, confidence: high); cluster of 11 sur…</rdfs:comment>
    <skos:definition xml:lang="en">Information related to an employee's identity, employment status, and contribution details in a life insurance context.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <skos:altLabel xml:lang="en">Employee ID</skos:altLabel>
    <skos:altLabel xml:lang="en">Employee Department</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#enablesWaiver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Enables Waiver</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the condition or benefit that enables the automatic premium waiver to be activated. Assigned domain=InsuranceContract, range=DisabilityCoverage; This property indicates the condition that triggers an automatic…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the condition or benefit that enables the automatic premium waiver to be activated.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#DisabilityCoverage"/>
    <skos:altLabel xml:lang="en">waived by</skos:altLabel>
    <skos:altLabel xml:lang="en">is required documentation for initiating automatic premium waiver</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#canBeElectedInIncrementsOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Can Be Elected In Increments Of</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the incremental amounts in which a benefit or option can be elected within an insurance contract. Assigned domain=Benefit, range=xsd:decimal; This property defines the smallest unit by which a benefit or option…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the incremental amounts in which a benefit or option can be elected within an insurance contract.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Benefit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">elected</skos:altLabel>
    <skos:altLabel xml:lang="en">elected by</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasMinimumAccelerationThreshold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Has Minimum Acceleration Threshold</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the minimum acceleration threshold value that triggers a condition or event in the insurance policy. Assigned domain=AccelerationLimit, range=xsd:decimal; This property specifies a minimum monetary threshold th…</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the minimum acceleration threshold value that triggers a condition or event in the insurance policy.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#AccelerationLimit"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">minimum acceleration amount</skos:altLabel>
    <skos:altLabel xml:lang="en">has maximum acceleration limit</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasCashAccessMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Cash Access Method</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the method by which a policyholder can access the cash value of an insurance policy. Assigned domain=CashValue, range=CashAccessMethod; This property describes how cash value is accessed. The domain is CashValu…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the method by which a policyholder can access the cash value of an insurance policy.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#CashValue"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#CashAccessMethod"/>
    <skos:altLabel xml:lang="en">increases cash value</skos:altLabel>
    <skos:altLabel xml:lang="en">accumulates over time</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#voluntaryCoverageAmount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Voluntary Coverage Amount</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the monetary amount of coverage selected by the employee for voluntary insurance benefits. Assigned domain=InsuranceContract, range=xsd:decimal; This property specifies the amount of voluntary coverage selected…</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the monetary amount of coverage selected by the employee for voluntary insurance benefits.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <skos:altLabel xml:lang="en">Employee Elects Voluntary Coverage</skos:altLabel>
    <skos:altLabel xml:lang="en">Employee Voluntary Premium</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#triggerDateForAnnualLoanRateAdjustment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Trigger Date For Annual Loan Rate Adjustment</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the date on which the annual loan rate adjustment is triggered in the insurance contract. Assigned domain=ContractualProvision, range=xsd:date; This property specifies the date when an annual loan rate adjustme…</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the date on which the annual loan rate adjustment is triggered in the insurance contract.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#WithdrawalCharge">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Charge for partial withdrawal</rdfs:label>
    <rdfs:comment xml:lang="en">A fee imposed for withdrawing funds from a policy, particularly beyond a specified number of withdrawals. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf FEES; cluster o…</rdfs:comment>
    <skos:definition xml:lang="en">A fee imposed for withdrawing funds from a policy, particularly beyond a specified number of withdrawals.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Charge"/>
    <skos:altLabel xml:lang="en">charge per withdrawal beyond first ten</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#InsurerChallengePeriodLimit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Limits Insurer Challenge Period</rdfs:label>
    <rdfs:comment xml:lang="en">A restriction on the duration during which an insurer may challenge a claim or policy validity. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PROVISION; cluster of 1 s…</rdfs:comment>
    <skos:definition xml:lang="en">A restriction on the duration during which an insurer may challenge a claim or policy validity.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#EarlyTerminationPenalty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Penalties For Early Termination</rdfs:label>
    <rdfs:comment xml:lang="en">A fee charged for terminating a life insurance policy before its scheduled end date. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CHARGE; cluster of 1 surface variant…</rdfs:comment>
    <skos:definition xml:lang="en">A fee charged for terminating a life insurance policy before its scheduled end date.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Charge"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#Dividend">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy Dividends</rdfs:label>
    <rdfs:comment xml:lang="en">A distribution of profits from a life insurance policy to its policyholder. Induced from a Placed as subClassOf CashValueGrowthMechanism (Stage 5, confidence: high); cluster of 11 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A distribution of profits from a life insurance policy to its policyholder.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#CashValueGrowthMechanism"/>
    <skos:altLabel xml:lang="en">Dividend Options</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#CoverageExtension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Legal Protection Clause</rdfs:label>
    <rdfs:comment xml:lang="en">A contractual provision that extends the scope of insurance coverage under specific conditions. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf SECTION; cluster of 3 sur…</rdfs:comment>
    <skos:definition xml:lang="en">A contractual provision that extends the scope of insurance coverage under specific conditions.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
    <skos:altLabel xml:lang="en">coverage extension provision</skos:altLabel>
    <skos:altLabel xml:lang="en">flexibility rule framework</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasChargesOption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Lower Charges for Option 1</rdfs:label>
    <rdfs:comment xml:lang="en">Relates an insurance contract to the selected option that defines its charge structure, such as 'Option I' with lower charges or 'Option II' with higher charges. Assigned domain=InsuranceContract, range=ChargeStructure;…</rdfs:comment>
    <skos:definition xml:lang="en">Relates an insurance contract to the selected option that defines its charge structure, such as 'Option I' with lower charges or 'Option II' with higher charges.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#ChargeStructure"/>
    <skos:altLabel xml:lang="en">Higher Charges in Option 2</skos:altLabel>
    <skos:altLabel xml:lang="en">Lower Charges: Option I</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasFinancialPenalty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Financial Penalty Context</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates a financial penalty that may be imposed under specific conditions, such as termination of the contract or early withdrawal, particularly when guarantees lapse due to insufficient premiums. Assigned domain=Polic…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates a financial penalty that may be imposed under specific conditions, such as termination of the contract or early withdrawal, particularly when guarantees lapse due to insufficient premiums.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#PolicyTermination"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#SurrenderCharge"/>
    <skos:altLabel xml:lang="en">penalty</skos:altLabel>
    <skos:altLabel xml:lang="en">financial penalty applicable upon termination, potentially triggered if guarantees lapse due to insufficient premiums</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#PolicySigningOfficer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Executive Officer Signing Policy</rdfs:label>
    <rdfs:comment xml:lang="en">An executive officer authorized to sign a life insurance policy on behalf of an organization. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf TITLE; cluster of 1 surface…</rdfs:comment>
    <skos:definition xml:lang="en">An executive officer authorized to sign a life insurance policy on behalf of an organization.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#AuthorizedSignatory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#Rider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rider</rdfs:label>
    <rdfs:comment xml:lang="en">A supplementary benefit or feature added to a life insurance policy. Induced from a Placed as subClassOf PolicyFeature (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3.</rdfs:comment>
    <skos:definition xml:lang="en">A supplementary benefit or feature added to a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#PolicyFeature"/>
    <skos:altLabel xml:lang="en">RIDERS</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#effectiveCoverageStart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Effective Coverage Start</rdfs:label>
    <rdfs:comment xml:lang="en">Specifies the date and time when the insurance coverage becomes effective. Assigned domain=Coverage, range=xsd:dateTime; This property specifies when coverage becomes effective, which is a temporal attribute of coverage.…</rdfs:comment>
    <skos:definition xml:lang="en">Specifies the date and time when the insurance coverage becomes effective.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#Coverage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <skos:altLabel xml:lang="en">Automatic Basic Coverage Activation</skos:altLabel>
    <skos:altLabel xml:lang="en">Basic Coverage Without Evidence</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#AdministrativeExpense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Admin Expenses</rdfs:label>
    <rdfs:comment xml:lang="en">A cost incurred by the insurer for managing and administering a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CHARGE; cluster of 1 surface varia…</rdfs:comment>
    <skos:definition xml:lang="en">A cost incurred by the insurer for managing and administering a life insurance policy.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#Charge"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#UnpaidInstallmentsDueUponReinstatement">
