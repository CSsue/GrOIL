    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#ContractualProvision"/>
    <skos:altLabel xml:lang="en">unpaid fees owed upon reinstatement</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasCoverageLimit">
