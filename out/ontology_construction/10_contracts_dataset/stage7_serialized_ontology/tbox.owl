    <rdfs:label xml:lang="en">Chief Executive Officer Role</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the role of an individual as the Chief Executive Officer within an insurance contract. Assigned domain=ExecutiveOfficer, range=Role; The property identifies an individual's role as Chief Executive Officer withi…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the role of an individual as the Chief Executive Officer within an insurance contract.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#ExecutiveOfficer"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#Role"/>
