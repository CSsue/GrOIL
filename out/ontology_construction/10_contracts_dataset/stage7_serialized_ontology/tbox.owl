  <rdf:Description rdf:about="https://example.org/ontology/insurance#hasPaymentMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Payment Mode</rdfs:label>
    <rdfs:comment xml:lang="en">Indicates the mode (e.g., electronic, check) through which a payment is made in the insurance contract. Assigned domain=InsuranceContract, range=PremiumPaymentMethod; The property specifies the method of payment (e.g., b…</rdfs:comment>
    <skos:definition xml:lang="en">Indicates the mode (e.g., electronic, check) through which a payment is made in the insurance contract.</skos:definition>
    <rdfs:domain rdf:resource="https://example.org/ontology/insurance#InsuranceContract"/>
    <rdfs:range rdf:resource="https://example.org/ontology/insurance#PremiumPaymentMethod"/>
