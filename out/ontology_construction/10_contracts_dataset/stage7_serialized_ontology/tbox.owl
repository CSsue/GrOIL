  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#EquityIndexedUniversalLife">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Equity-Indexed Universal Life</rdfs:label>
    <rdfs:comment xml:lang="en">A type of permanent life insurance with returns linked to a stock market index. Induced from a Placed as subClassOf UniversalLifeInsurancePolicyContract (Stage 5, confidence: high); cluster of 1 surface variant(s) merged…</rdfs:comment>
    <skos:definition xml:lang="en">A type of permanent life insurance with returns linked to a stock market index.</skos:definition>
    <rdfs:subClassOf rdf:resource="https://example.org/ontology/insurance#UniversalLifeInsurancePolicyContract"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/ontology/insurance#PolicyCancellation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Policy Cancellation</rdfs:label>
