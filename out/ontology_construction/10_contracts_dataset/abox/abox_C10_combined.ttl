@prefix abox: <https://example.org/ontology/insurance/abox#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix li: <https://example.org/ontology/insurance#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/ontology/insurance> a owl:Ontology ;
    rdfs:label "Life Insurance Policy TBox"@en ;
    dcterms:created "2026-05-16"^^xsd:date ;
    dcterms:creator "Graph-Grounded Ontology Induction Pipeline (Stages 1-7)"^^xsd:string ;
    dcterms:description "OWL TBox ontology induced from a corpus of life insurance policy documents via the Graph-Grounded Ontology Induction pipeline."@en ;
    dcterms:title "Life Insurance Policy TBox"@en ;
    owl:versionInfo "1.0"^^xsd:string .

li:AccountAccess a owl:Class ;
    rdfs:label "Account Value Access"@en ;
    rdfs:comment "A set of rules governing access to and management of an insurance account's value. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "account management"@en,
        "account types"@en ;
    skos:definition "A set of rules governing access to and management of an insurance account's value."@en .

li:AccountValueThreshold a owl:Class ;
    rdfs:label "Cash Value Threshold"@en ;
    rdfs:comment "A specified account value level that triggers a contractual event or condition. Induced from a Placed as subClassOf ThresholdTriggeringPolicyTermination (Stage 5, confidence: high); cluster of 3 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ThresholdTriggeringPolicyTermination ;
    skos:altLabel "Account Value Threshold"@en,
        "account value thresholds"@en ;
    skos:definition "A specified account value level that triggers a contractual event or condition."@en .

li:AccumulatedMonetaryBenefit a owl:Class ;
    rdfs:label "Accumulated Monetary Benefit Of Policy"@en ;
    rdfs:comment "The total monetary value accumulated within a life insurance policy over time. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 surface variant(s) m…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "The total monetary value accumulated within a life insurance policy over time."@en .

li:AdditionalCoverageAccessRight a owl:Class ;
    rdfs:label "Additional Coverage Access Right"@en ;
    rdfs:comment "A right granting access to additional life insurance coverage. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf RIDERS; cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Rider ;
    skos:definition "A right granting access to additional life insurance coverage."@en .

li:AdditionalWaiverCost a owl:Class ;
    rdfs:label "Additional Cost For Waiver"@en ;
    rdfs:comment "An extra cost associated with a waiver provision in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf PREMIUM; cluster of 1 surface variant(s) mer…"@en ;
    rdfs:subClassOf li:Charge ;
    skos:definition "An extra cost associated with a waiver provision in a life insurance policy."@en .

li:AdjustedDeathBenefitError a owl:Class ;
    rdfs:label "Error Leading To Adjusted Death Benefit"@en ;
    rdfs:comment "An error that results in a modified death benefit amount. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf EXCLUSION; cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Exclusion ;
    skos:definition "An error that results in a modified death benefit amount."@en .

li:AdjustmentAfterReinstatement a owl:Class ;
    rdfs:label "Adjustment After Reinstatement"@en ;
    rdfs:comment "A financial adjustment applied to a policy following its reinstatement. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CALCULATION; cluster of 1 surface variant(s) merg…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A financial adjustment applied to a policy following its reinstatement."@en .

li:AdministrativeTransition a owl:Class ;
    rdfs:label "Administrative Transition"@en ;
    rdfs:comment "A change in the administrative handling of a life insurance policy. Induced from a Placed as subClassOf PolicyModification (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PolicyModification ;
    skos:definition "A change in the administrative handling of a life insurance policy."@en .

li:AdvanceLimit a owl:Class ;
    rdfs:label "Monthly Advance"@en ;
    rdfs:comment "A maximum amount that may be advanced monthly under a life insurance policy. Induced from a Placed as subClassOf CoverageLimit (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:CoverageLimit ;
    skos:altLabel "Advance Limit"@en ;
    skos:definition "A maximum amount that may be advanced monthly under a life insurance policy."@en .

li:AgeAtIssue a owl:Class ;
    rdfs:label "Age Limits"@en ;
    rdfs:comment "The age of the insured at the time the policy is issued. Induced from a Placed as subClassOf TemporalConcept (Stage 5, confidence: high); cluster of 36 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:TemporalConcept ;
    skos:altLabel "attained age"@en,
        "policy age restrictions"@en ;
    skos:definition "The age of the insured at the time the policy is issued."@en .

li:AgeBandedRate a owl:Class ;
    rdfs:label "Age-Banded Rates"@en ;
    rdfs:comment "A pricing structure that applies different premium rates based on age brackets. Induced from a Placed as subClassOf PremiumPayment (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:PremiumPayment ;
    skos:definition "A pricing structure that applies different premium rates based on age brackets."@en .

li:AgeBasedDeathBenefitAdjustment a owl:Class ;
    rdfs:label "Adjusts Death Benefit Based On Actual Age"@en ;
    rdfs:comment "Adjusts the death benefit according to the insured's actual age at claim. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CLAUSE; cluster of 1 surface variant(s) merged…"@en,
        "Policy terms adjust based on misstated age. Induced via Stage 6 restriction induction; The evidence shows adjustments are based on the correct age at application. Age is the foundational variable for recalibrating benefi…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:AgeMisstatementAdjustmentRule ;
            owl:someValuesFrom li:Age ],
        li:ContractualProvision ;
    skos:definition "Adjusts the death benefit according to the insured's actual age at claim."@en .

li:AllianceGroupBenefits a owl:Class ;
    rdfs:label "Alliance Group Benefits"@en ;
    rdfs:comment "A group benefits plan offered by the Alliance Group, providing life insurance coverage to members. Induced from a Placed as subClassOf GroupCoverage (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in…"@en ;
    rdfs:subClassOf li:GroupCoverage ;
    skos:definition "A group benefits plan offered by the Alliance Group, providing life insurance coverage to members."@en .

li:AlternativeRopPaymentMethod a owl:Class ;
    rdfs:label "not triggered by ROP payout"@en ;
    rdfs:comment "A payment method for ROP that is not triggered by a ROP payout. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 2 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "alternative method for ROP payment"@en ;
    skos:definition "A payment method for ROP that is not triggered by a ROP payout."@en .

li:AnnualAdjustment a owl:Class ;
    rdfs:label "Annual Changes"@en ;
    rdfs:comment "A periodic change to policy terms or benefits occurring once per year. Induced from a Placed as subClassOf BenefitAdjustment (Stage 5, confidence: high); cluster of 7 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitAdjustment ;
    skos:altLabel "annual recalibration"@en,
        "annual variation"@en ;
    skos:definition "A periodic change to policy terms or benefits occurring once per year."@en .

li:AnnualAdjustmentDateForLoanInterest a owl:Class ;
    rdfs:label "Annual Adjustment Date For Loan Interest"@en ;
    rdfs:comment "The date each year when loan interest rates are adjusted. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DATE; cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:TimePeriod ;
    skos:definition "The date each year when loan interest rates are adjusted."@en .

li:AnnualBenefitRecalculationTrigger a owl:Class ;
    rdfs:label "Trigger For Annual Recalculation Of Benefits"@en ;
    rdfs:comment "A condition or event that initiates the annual review and adjustment of insurance benefits. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 2 surface…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "basis for annual benefit adjustment"@en ;
    skos:definition "A condition or event that initiates the annual review and adjustment of insurance benefits."@en .

li:AnnualFeeStructure a owl:Class ;
    rdfs:label "Yearly Fee Schedule"@en ;
    rdfs:comment "A schedule of fees charged on an annual basis within a life insurance policy. Induced from a Placed as subClassOf ChargeStructure (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ChargeStructure ;
    skos:altLabel "Fee Structure"@en,
        "annual fee rate"@en ;
    skos:definition "A schedule of fees charged on an annual basis within a life insurance policy."@en .

li:AnnualPaymentRule a owl:Class ;
    rdfs:label "Rule Specifying Annual Payment Amount"@en ;
    rdfs:comment "A rule that defines the fixed amount payable each year under a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf SUBSECTION; cluster of 1 surface va…"@en ;
    rdfs:subClassOf li:Section ;
    skos:definition "A rule that defines the fixed amount payable each year under a life insurance policy."@en .

li:AnnualPremiumContributionCap a owl:Class ;
    rdfs:label "Annual Cap On Premium Contributions"@en ;
    rdfs:comment "A limit on the maximum premium contribution allowed per year. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A limit on the maximum premium contribution allowed per year."@en .

li:AnnualProof a owl:Class ;
    rdfs:label "Annual Proof"@en ;
    rdfs:comment "A document submitted annually to verify the insured's continued eligibility for coverage. Induced from a Placed as subClassOf ProofOfCoverageRequirement (Stage 5, confidence: high); cluster of 2 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ProofOfCoverageRequirement ;
    skos:altLabel "annual proof submission"@en ;
    skos:definition "A document submitted annually to verify the insured's continued eligibility for coverage."@en .

li:AnnualRenewalReferencePoint a owl:Class ;
    rdfs:label "Annual renewal reference point"@en ;
    rdfs:comment "A reference point used to determine annual renewal terms in a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf POLICY_TERM; cluster of 1 surface va…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A reference point used to determine annual renewal terms in a life insurance policy."@en .

li:ApplicationError a owl:Class ;
    rdfs:label "Application Error"@en ;
    rdfs:comment "An error occurring during the submission or processing of a life insurance application. Induced from a Placed as subClassOf ClaimProcess (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ClaimProcess ;
    skos:definition "An error occurring during the submission or processing of a life insurance application."@en .

li:AutomaticCoverageUponHire a owl:Class ;
    rdfs:label "Automatically Effective Coverage Upon Hire"@en ;
    rdfs:comment "A type of life insurance coverage that becomes effective immediately upon employment. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 surface varia…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A type of life insurance coverage that becomes effective immediately upon employment."@en .

li:AvailableUseOfAccumulatedFunds a owl:Class ;
    rdfs:label "Available Use Of Accumulated Funds"@en ;
    rdfs:comment "The permitted utilization of funds accumulated within a life insurance policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf ACTION; cluster of 1 surface variant(s) me…"@en ;
    rdfs:subClassOf li:Action ;
    skos:definition "The permitted utilization of funds accumulated within a life insurance policy."@en .

li:BasePremium a owl:Class ;
    rdfs:label "Base Policy"@en ;
    rdfs:comment "The fundamental premium amount for a life insurance policy, excluding additional riders or endorsements. Induced from a Placed as subClassOf PremiumPayment (Stage 5, confidence: high); cluster of 3 surface variant(s) mer…"@en ;
    rdfs:subClassOf li:PremiumPayment ;
    skos:altLabel "base annual premium"@en,
        "base premium"@en ;
    skos:definition "The fundamental premium amount for a life insurance policy, excluding additional riders or endorsements."@en .

li:BasicLifeBenefitAmount a owl:Class ;
    rdfs:label "Basic Life Benefit Amount"@en ;
    rdfs:comment "The base amount of life insurance coverage provided under a policy. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf AMOUNT; cluster of 1 surface variant(s) merged in Sta…"@en ;
    rdfs:subClassOf li:MonetaryValue ;
    skos:definition "The base amount of life insurance coverage provided under a policy."@en .

li:BeneficiaryDesignation a owl:Class ;
    rdfs:label "Primary Vs Secondary"@en ;
    rdfs:comment "A designation of the primary or secondary beneficiary in a life insurance policy. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DeathBenefit ;
    skos:definition "A designation of the primary or secondary beneficiary in a life insurance policy."@en .

li:BenefitReduction a owl:Class ;
    rdfs:label "Reduced Benefit"@en ;
    rdfs:comment "A reduction in the insurance benefit amount under a life insurance policy. Induced from a Placed as subClassOf BenefitAdjustment (Stage 5, confidence: high); cluster of 5 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BenefitAdjustment ;
    skos:altLabel "Premium Reduction"@en,
        "no benefit reduction"@en ;
    skos:definition "A reduction in the insurance benefit amount under a life insurance policy."@en .

li:BenefitSwitching a owl:Class ;
    rdfs:label "Benefit Switching"@en ;
    rdfs:comment "A contractual provision allowing the policyholder to switch between different benefit options. Induced from a Placed as subClassOf ContractualProvision (Stage 5, confidence: high); cluster of 3 surface variant(s) merged…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "Option Switching"@en,
        "Option Switching Conditions"@en ;
    skos:definition "A contractual provision allowing the policyholder to switch between different benefit options."@en .

li:BirthOrAdoptionEvent a owl:Class ;
    rdfs:label "Legally Adopted Children"@en ;
    rdfs:comment "An event marking the beginning of a parent-child relationship through birth or legal adoption. Induced from a Placed as subClassOf Event (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:Event ;
    skos:altLabel "Birth or Adoption Event"@en,
        "birth or adoption"@en ;
    skos:definition "An event marking the beginning of a parent-child relationship through birth or legal adoption."@en .

li:BoardOfDirectorsDeclaration a owl:Class ;
    rdfs:label "Board of Directors Declaration"@en ;
    rdfs:comment "A formal statement issued by the board of directors regarding policy-related matters. Induced from a Placed as subClassOf InsuranceDocumentation (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stag…"@en ;
    rdfs:subClassOf li:InsuranceDocumentation ;
    skos:definition "A formal statement issued by the board of directors regarding policy-related matters."@en .

li:BorrowingRestriction a owl:Class ;
    rdfs:label "Restriction On Borrowing Against Policy"@en ;
    rdfs:comment "A limitation imposed on the policyholder's ability to borrow against the policy's cash value. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf LIMITATION; cluster of 1 su…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A limitation imposed on the policyholder's ability to borrow against the policy's cash value."@en .

li:BurialExpenseCoverage a owl:Class ;
    rdfs:label "Provides Burial Expense Coverage"@en ;
    rdfs:comment "A type of life insurance that covers funeral and burial expenses. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf POLICY; cluster of 1 surface variant(s) merged in Stage…"@en ;
    rdfs:subClassOf li:Coverage ;
    skos:definition "A type of life insurance that covers funeral and burial expenses."@en .

li:CaliforniaJurisdiction a owl:Class ;
    rdfs:label "California regulations"@en ;
    rdfs:comment "A legal jurisdiction governed by California regulations in life insurance contracts. Induced from a Placed as subClassOf LegalJurisdiction (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LegalJurisdiction ;
    skos:altLabel "California jurisdiction"@en ;
    skos:definition "A legal jurisdiction governed by California regulations in life insurance contracts."@en .

li:CancellationGroundsAfterTwoYears a owl:Class ;
    rdfs:label "Only Grounds For Cancellation After 2 Years"@en ;
    rdfs:comment "Conditions under which a policy may be canceled after the initial two-year period. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf EXCEPTION; cluster of 1 surface varian…"@en ;
    rdfs:subClassOf li:PolicyCancellation ;
    skos:definition "Conditions under which a policy may be canceled after the initial two-year period."@en .

li:CancellationWindow a owl:Class ;
    rdfs:label "Cancellation Window For Refund"@en ;
    rdfs:comment "A period during which a policyholder may cancel a life insurance policy and receive a refund. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 4 surfa…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:altLabel "cancellation"@en,
        "immediate cancellation requirement"@en ;
    skos:definition "A period during which a policyholder may cancel a life insurance policy and receive a refund."@en .

li:CapitalPreservation a owl:Class ;
    rdfs:label "Capital Preservation"@en ;
    rdfs:comment "A feature of a life insurance policy that ensures the return of the policy's accumulated value at death. Induced from a Placed as subClassOf DeathBenefit (Stage 5, confidence: high); cluster of 1 surface variant(s) merge…"@en ;
    rdfs:subClassOf li:DeathBenefit ;
    skos:definition "A feature of a life insurance policy that ensures the return of the policy's accumulated value at death."@en .

li:CashValueBorrowing a owl:Class ;
    rdfs:label "Cash Value Borrowing"@en ;
    rdfs:comment "A loan taken against the cash value of a life insurance policy. Induced from a Placed as subClassOf BorrowingFeature (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:BorrowingFeature ;
    skos:altLabel "Net Borrowing Cost"@en,
        "borrowing"@en ;
    skos:definition "A loan taken against the cash value of a life insurance policy."@en .

li:ChangeForm a owl:Class ;
    rdfs:label "Change Form"@en ;
    rdfs:comment "A document or request used to modify terms or details of a life insurance policy. Induced from a Placed as subClassOf DocumentArtifact (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:DocumentArtifact ;
    skos:definition "A document or request used to modify terms or details of a life insurance policy."@en .

li:ChargeShortfallConsequence a owl:Class ;
    rdfs:label "Consequence of charge shortfall"@en ;
    rdfs:comment "A financial outcome resulting from insufficient funds to cover insurance charges. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 surface variant(s…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "A financial outcome resulting from insufficient funds to cover insurance charges."@en .

li:ChronicCareAdvance a owl:Class ;
    rdfs:label "Permits Monthly Advances For Chronic Care Needs"@en ;
    rdfs:comment "A provision allowing periodic advances to cover ongoing chronic care expenses. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf RIDERS; cluster of 1 surface variant(s) me…"@en ;
    rdfs:subClassOf li:Rider ;
    skos:definition "A provision allowing periodic advances to cover ongoing chronic care expenses."@en .

li:ChronicIllness a owl:Class ;
    rdfs:label "Chronic Illness"@en ;
    rdfs:comment "A long-term health condition that significantly impairs daily functioning and qualifies for benefits under a life insurance policy. Induced from a Placed as subClassOf LifeInsuranceBenefit (Stage 5, confidence: high); cl…"@en,
        "Eligibility requires functional limitations. Induced via Stage 6 restriction induction; The evidence specifies that eligibility depends on inability to perform two or more Activities of Daily Living. This makes Activitie…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:ChronicIllnessEligibilityRequirement ;
            owl:someValuesFrom li:ActivitiesOfDailyLiving ],
        li:LifeInsuranceBenefit ;
    skos:altLabel "Chronic Illness Qualification"@en ;
    skos:definition "A long-term health condition that significantly impairs daily functioning and qualifies for benefits under a life insurance policy."@en .

li:ClaimHandler a owl:Class ;
    rdfs:label "Handling Claims"@en ;
    rdfs:comment "An entity responsible for receiving and processing insurance claims. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DEPARTMENT; cluster of 2 surface variant(s) merged i…"@en ;
    rdfs:subClassOf li:ClaimsProcessingAuthority ;
    skos:altLabel "receiving"@en ;
    skos:definition "An entity responsible for receiving and processing insurance claims."@en .

li:ClaimProcessingWindow a owl:Class ;
    rdfs:label "Processing Timeframe For Valid Claims"@en ;
    rdfs:comment "A time period during which a claim must be submitted and processed for eligibility and payout. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf DATE; cluster of 3 surface…"@en ;
    rdfs:subClassOf li:TimePeriod ;
    skos:altLabel "processing timeline for claims"@en,
        "window for late payment without lapse"@en ;
    skos:definition "A time period during which a claim must be submitted and processed for eligibility and payout."@en .

li:ClaimSubmissionChannel a owl:Class ;
