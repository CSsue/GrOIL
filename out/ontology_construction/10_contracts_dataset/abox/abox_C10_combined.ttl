li:EnrollmentPeriod a owl:Class ;
    rdfs:label "Policy Enrollment"@en ;
    rdfs:comment "A time period during which a policyholder can enroll in or initiate life insurance coverage. Induced from a Placed as subClassOf TimePeriod (Stage 5, confidence: high); cluster of 3 surface variant(s) merged in Stage 3."@en,
        "Enrollment must occur before the deadline. Induced via Stage 6 restriction induction; The evidence specifies a time-based rule (31 days) for enrollment validity, which is a procedural condition. The property links Enroll…"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty li:VoluntaryEnrollmentDeadline ;
            owl:someValuesFrom li:PolicyFeature ],
        li:TimePeriod ;
    skos:altLabel "coverage enrollment"@en,
        "enrollment period"@en ;
    skos:definition "A time period during which a policyholder can enroll in or initiate life insurance coverage."@en .

