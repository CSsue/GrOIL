    rdfs:subClassOf li:InsuranceContract ;
    skos:definition "A structural organization of insurance company entities and their relationships."@en .

li:ConflictResolution a owl:Class ;
    rdfs:label "Conflict Resolution"@en ;
    rdfs:comment "A process for resolving disputes or disagreements within a life insurance contract. Induced from a Placed as subClassOf ClaimProcess (Stage 5, confidence: high); cluster of 1 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ClaimProcess ;
    skos:definition "A process for resolving disputes or disagreements within a life insurance contract."@en .

li:ContactNumber a owl:Class ;
    rdfs:label "Phone Number"@en ;
    rdfs:comment "A telephone number used for contacting an individual or organization. Induced from a Placed as subClassOf ContactInformation (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:ContactInformation ;
    skos:altLabel "toll-free number"@en ;
    skos:definition "A telephone number used for contacting an individual or organization."@en .

li:ContestabilityPeriodDuration a owl:Class ;
    rdfs:label "Contestability Period Duration"@en ;
