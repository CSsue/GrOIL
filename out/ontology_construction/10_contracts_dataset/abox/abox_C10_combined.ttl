    rdfs:subClassOf li:CustomerServiceHotline ;
    skos:definition "A telephone service for reporting and inquiring about insurance claims."@en .

li:CombinedInsuredValue a owl:Class ;
    rdfs:label "Combined Insured Value"@en ;
    rdfs:comment "The total value of insurance coverage combined across multiple insured individuals or policies. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONCEPT; cluster of 1 sur…"@en ;
    rdfs:subClassOf li:ContractualProvision ;
    skos:definition "The total value of insurance coverage combined across multiple insured individuals or policies."@en .

li:ComfortCareService a owl:Class ;
    rdfs:label "ComfortCare Claims"@en ;
    rdfs:comment "A claims and support service offered under ComfortCare Senior Insurance policies. Induced from a Placed as subClassOf owl:Thing (Stage 5, confidence: high); cluster of 4 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:LifeInsurancePolicy ;
    skos:altLabel "COMFORT"@en,
