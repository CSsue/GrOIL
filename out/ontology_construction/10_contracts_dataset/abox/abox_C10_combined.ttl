    rdfs:comment "A method or pathway used to submit a life insurance claim to the insurer. Induced from a Hierarchy placement via graph-native parent (entity role co-occurrence): subClassOf CONTACT_INFORMATION; cluster of 1 surface varia…"@en ;
    rdfs:subClassOf li:ContactInformation ;
    skos:definition "A method or pathway used to submit a life insurance claim to the insurer."@en .

li:ClaimsDepartment a owl:Class ;
    rdfs:label "SecureLife Claims Department"@en ;
    rdfs:comment "An organizational unit responsible for processing and managing insurance claims. Induced from a Placed as subClassOf InsuranceCompany (Stage 5, confidence: high); cluster of 2 surface variant(s) merged in Stage 3."@en ;
    rdfs:subClassOf li:InsuranceCompany ;
    skos:altLabel "SecureLife Insurance Company"@en ;
    skos:definition "An organizational unit responsible for processing and managing insurance claims."@en .

li:ClaimsHotline a owl:Class ;
